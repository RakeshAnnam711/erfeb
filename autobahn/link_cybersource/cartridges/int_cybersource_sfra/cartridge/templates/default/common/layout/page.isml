<iscomment>
  The file has will be overwritten by rvw_autobahn_core/cartridge/templates/default/common/layout/page.isml
</iscomment>

<iscontent type="text/html" charset="UTF-8" compact="true"/>

<isinclude template="/components/modules" sf-toolkit="off" />

<!DOCTYPE html>
<html lang="${require('dw/util/Locale').getLocale(request.getLocale()).getLanguage()}">
    <head>
        <!--[if gt IE 9]><!-->
            <isinclude sf-toolkit="off" template="/common/scripts" />
        <!--<![endif]-->
        <isinclude template="/common/htmlHead" />
        <isif condition="${pdict.canonicalUrl}" >
            <link rel="canonical" href="${pdict.canonicalUrl}"/>
        </isif>
        <isactivedatahead/>
        <isinclude template="/components/schema" />
    </head>
    <body>
        ${dw.system.HookMgr.callHook('app.template.beforeHeader', 'beforeHeader', pdict) || ''}

        <div class="page" data-action="${pdict.action}" data-querystring="${pdict.queryString}" >
            <isinclude template="/components/header/pageHeader" />
            <div role="main" id="maincontent">
                <isreplace/>
            </div>
            <isinclude template="/components/footer/pageFooter" />
        </div>
        <div class="error-messaging"></div>
        <div class="modal-background"></div>
        <iscontentasset aid="cookie_hint" />


        <iscomment>
          The following section of code has been moved to integrations/common/layout/pagePostFooterInjection.isml
        </iscomment>
        <isset name="isGooglePayEnabled" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGooglePay')}" scope="page" />
        <isif condition="${isGooglePayEnabled}">
            <input type="hidden" name="isGooglePayEnabled" id="isGooglePayEnabled" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGooglePay')}"/>
        </isif>

         <!--[if lt IE 10]>
            <isinclude sf-toolkit="off" template="/common/scripts" />
        <![endif]-->

        <isscript>
            var CybersourceConstants = require('~/cartridge/scripts/utils/CybersourceConstants');
        </isscript>
        <isif condition="${dw.system.Site.current.getCustomPreferenceValue('CsEnableExpressPaypal')==true && dw.order.PaymentMgr.getPaymentMethod(CybersourceConstants.METHOD_PAYPAL).isActive()}">
            <script defer src="https://www.paypalobjects.com/api/checkout.js"></script>
        </isif>
        <script defer src="${URLUtils.staticURL('/custom/js/cybersource-custom.js')}"></script>
        <isif condition="${isGooglePayEnabled}">
            <input type="hidden" name="googlePayMerchantID" id="googlePayMerchantID"  value="${dw.system.Site.getCurrent().getCustomPreferenceValue('googlePayMerchantID')}"/>
            <input type="hidden" name="googlePaygatewayMerchantId" id="googlePaygatewayMerchantId" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('CsMerchantId')}" />

            <isif condition="${pdict.currentStage == null}" >
                <script defer src="https://pay.google.com/gp/p/js/pay.js"></script>
                <script defer src="${URLUtils.staticURL('/custom/js/googlepay.js')}"></script>

                <script>
                    var googlepayvariables = {
                        currencyCode: "${session.getCurrency().getCurrencyCode()}",
                        totalPriceStatus: 'FINAL',
                        sessionCallBack : "${dw.web.URLUtils.url('CheckoutServices-GetGooglePayToken')}",
                        returnURL : "${dw.web.URLUtils.https('Checkout-Begin', 'stage', 'placeOrder')}",
                        cartURL : "${dw.web.URLUtils.https('Cart-Show')}"
                    }
                    window.googlepayval = googlepayvariables;
                </script>
            </isif>
        </isif>

        <iscomment>Visa Chekout</iscomment>
        <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('cybVisaButtonOnCart') && dw.order.PaymentMgr.getPaymentMethod(CybersourceConstants.METHOD_VISA_CHECKOUT).isActive()}">
          <isinclude url="${URLUtils.url('CYBVisaCheckout-InitializeVisaToken')}"/>
        </isif>
        <iscomment>
          The section of code above has been moved to integrations/common/layout/pagePostFooterInjection.isml
        </iscomment>

        <iscomment>
            hook for Marketing Cloud connector & other integration which need to inject
            logic at the page end
            IMPORTANT: Note that this hook will be called to cached as well as uncached pages
                        which means you need to put privacy information into another remote include
        </iscomment>
        ${dw.system.HookMgr.callHook('app.template.afterFooter', 'afterFooter', pdict) || ''}
        <isinclude url="${URLUtils.url('ConsentTracking-Check')}"/>
    </body>
</html>
