{
    "name": "Title",
    "description": "Show Title, sub title and CTA",
    "group": "wgaca_assets",
    "attribute_definition_groups": [
    	{
	    	"id": "titleContainer",
	      	"attribute_definitions": [
				{
					"id": "titleContainerClass",
					"name": "Title Container Class",
					"type": "string",
					"description": "Add a class to the inner container of the component. Useful for overriding padding. e.g. 'p-0' See the Style Guide for more class options.",
					"required": false
				},
	     		{
	          		"id": "title",
	          		"name": "Title",
	          		"type": "string",
	          		"required": true
	        	},
	        	{
	          		"id": "titleColor",
	          		"name": "Title Color",
	          		"type": "string",
	          		"required": false
	        	},
	        	{
	          		"id": "titleFontSize",
	          		"name": "Title Font Size",
	          		"description": "Title font size, default is 16px",
	          		"type": "enum",
                    "values": ["16px", "20px", "24px", "28px", "34px", "38px"],
                    "default_value": "16px",
	          		"required": false
	        	},
	        	{
	          		"id": "titleAlignment",
	          		"name": "Title Alignment",
	          		"description": "Title alignment, default is center",
	          		"type": "enum",
                    "values": ["left", "center", "right"],
                    "default_value": "center",
	          		"required": false
	        	},
	        	{
	          		"id": "letterSpacing",
	          		"name": "Letter Spacing",
	          		"description": "Spacing between the letters, default spacing is 1px",
	          		"type": "enum",
                    "values": ["1px", "2px", "3px", "4px"],
                    "default_value": "1px",
	          		"required": false
	        	}
	      	]
	    }
    ],
    "region_definitions": []
}
