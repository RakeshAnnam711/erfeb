{
    "name": "WGACA Frenzy Slider",
    "group": "wgaca_assets",
    "attribute_definition_groups": [
        {
	    	"id": "frenzyTitleContainer",
	      	"attribute_definitions": [
	     		{
	          		"id": "frenzytitle",
	          		"name": "Title",
	          		"type": "string",
	          		"required": false
	        	},
	        	{
	          		"id": "frenzytitleColor",
	          		"name": "Title Color",
	          		"type": "string",
	          		"required": false
	        	},
	        	{
	          		"id": "frenzytitleFontSize",
	          		"name": "Title Font Size",
	          		"description": "Title font size, default is 20px",
	          		"type": "enum",
                    "values": ["16px", "20px", "24px", "28px"],
                    "default_value": "20px",
	          		"required": false
	        	}
	      	]
	    },
	    {
	    	"id": "frenzysubTitleContainer",
	      	"attribute_definitions": [
	     		{
	          		"id": "frenzysubTitle",
	          		"name": "Sub Title",
	          		"type": "string",
	          		"required": false
	        	},
	        	{
	          		"id": "frenzysubTitleColor",
	          		"name": "Sub Title Color",
	          		"type": "string",
	          		"required": false
	        	},
	        	{
	          		"id": "frenzySubTitleFontSize",
	          		"name": "Sub Title Font Size",
	          		"description": "Sub Title font size, default is 14px",
	          		"type": "enum",
                    "values": ["12px","14px","16px", "20px", "24px", "28px"],
                    "default_value": "14px",
	          		"required": false
	        	}
	      	]
	    },
        {
            "id": "FrenzyAPI",
            "attribute_definitions": [
                {
                    "id": "api_url",
                    "name": "API Url",
                    "description":"Frenzy Service endpoint url",
                    "type": "string",
                    "required": false,
                    "default_value": "most-clicked-skus"
                },
                {
                    "id": "auth_key_value",
                    "name": "Key Value",
                    "description":"Frenzy header key value",
                    "type": "string",
                    "required": false,
                    "default_value": "b423c0ba-a5f5-4c32-b369-ad7bdc94a1b5"
                },
                {
                    "id": "number_days_ago",
                    "name": "number days ago",
                    "description": "number days ago data needed",
                    "type": "integer",
                    "default_value": 3,
                    "required": false
                },
                {
                    "id": "productName",
                    "name": "Product name",
                    "description": "Show/Hide Product Name",
                    "type": "boolean",
                    "default_value": false,
                    "required": false
                },
                {
                    "id": "productPrice",
                    "name": "Product price",
                    "description": "Show/Hide Price",
                    "type": "boolean",
                    "default_value": false,
                    "required": false
                }
            ]
        },
        {
            "id": "sliderConfiguration",
            "attribute_definitions": [
                {
                    "id": "showShadow",
                    "name": "Add shadow to product tile",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "tileBackground",
                    "name": "Add background to product tile",
                    "type": "string",
                    "required": false
                }
            ]
        }
    ],
    "region_definitions": []
}
