<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/experience/components/commerce_assets/wgacaFrenzySlider.js');
</isscript>
<iscomment>CSS is now loaded via consolidated-components.scss in global.scss</iscomment>
<div class="text-block text-center frenzy-headings">
    <div class="title" style="color: ${pdict.titleColor}; font-size: ${pdict.titleFontSize}">${pdict.title}</div>
	<div class="sub-title" style="color:${pdict.subTitleColor}; font-size: ${pdict.SubTitleFontSize}">${pdict.subTitle}</div>
</div>
<isscript>
    var clonedFrenzyData = JSON.parse(JSON.stringify(pdict.frenzyData)); // clone frenzyData
    clonedFrenzyData.title = pdict.title; // inject title
</isscript>
<div class="slider-frenzy-product ${pdict.showShadow}">
    <isinclude url="${URLUtils.http('Frenzy-SliderProducts', 'frenzyData', JSON.stringify(clonedFrenzyData))}" />
</div>
<script>
    function getCookieValue(name) {
        let cookieName = name + "=";
        let decodedCookie = decodeURIComponent(document.cookie);
        let cookieArray = decodedCookie.split(';');
        for(let i = 0; i < cookieArray.length; i++) {
            let cookie = cookieArray[i];
            while (cookie.charAt(0) == ' ') {
                cookie = cookie.substring(1);
            }
            if (cookie.indexOf(cookieName) == 0) {
                return cookie.substring(cookieName.length, cookie.length);
            }
        }
        return "";
    }
    let stripeMidValue = getCookieValue('__stripe_mid');
    let frenzyUserID = window.Customer.isLoggedIn ? window.Customer.customerNo : getCookieValue('__frenzy_user_id');
    document.querySelectorAll('.slider-frenzy-product .product .product-click-track').forEach(function(element) {
        element.setAttribute('data-userid', frenzyUserID);
    });
</script>