<isinclude template="/components/modules" sf-toolkit="off" />

<isscript>
    var assets = require('*/cartridge/scripts/assets');
    assets.addJs('/js/productDetail.js');
</isscript>

<isset name="product" value="${pdict.product}" scope="page" />
<isset name="csrf" value="${pdict.csrf}" scope="page" />
<isset value="${dw.catalog.ProductMgr.getProduct(product.id)}" name="Product" scope="page" />
<isset name="customerNo" value="${pdict.currentCustomer.profile.customerNo}" scope="page" />

<isset name="isIdIncluded" value="" scope="page" />
<input type="hidden" name="add-to-cart-url" value="${URLUtils.url('Cart-AddProduct')}"/>
<input type="hidden" name="get-cart-url" value="${URLUtils.url('Cart-Get')}"/>
<input type="hidden" name="product-details-json" value="${JSON.stringify(product)}"/>
<script>

    document.addEventListener('DOMContentLoaded', function() {
        const stickyBarElementBtn = document.querySelector('#addtocart-sticky-bar-isml button');
        if(!stickyBarElementBtn.disabled){
            // showAddToCartStatus();
        }
    });

	function dataLayerPushAddtoCart() {
        window.dataLayer = window.dataLayer || [];
        var data = {
            'user_id': '${session.custom.currentCustomer || (pdict.currentCustomer ? pdict.currentCustomer.raw.ID : '')}',
            'sku': '${product.id}'
        };
        var obj = {
            'event': 'productaddtocartClick',
            'ecommerce': {
				'click': {
					'products': data
				}
			}
        };
	    dataLayer.push(obj);
    }

    (async () => {
            var data_json = JSON.stringify({
                    pid: '${product.id}'
                });
                const response = await fetch("${URLUtils.abs('RecentlyViewed-AddProduct')}", {
                method: 'POST',
                body: data_json,
                headers: {
                    'Content-Type': 'application/json'
                }
                });
                const data = await response.json(); //fetching resonse data
            })();
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        //Add event listener to the image to copy URL when clicked
        document.getElementById('copyIcon').addEventListener('click', function() {
            navigator.clipboard.writeText(currentPageUrl).then(function() {
                console.log("Link Copied - " + currentPageUrl);
            })
        });

        // Capture current page URL and assign it to the input field
        var currentPageUrl = window.location.href;
        var pageUrlInput = document.getElementById('pageUrlInput');
        pageUrlInput.value = currentPageUrl;

        var desc = $("#product-card-details").find('#ACC-item')
            .clone()
            .children('.product-attributes')
            .remove()
            .end()
            .html();

        $('#description .card-body').html(desc);

        var measurement = $("#product-card-details").find('#ACC-item .details-container').html();
        $('#measurement .card-body').html(measurement);

        //Moving made in and year to details setion
        var items = $('#measurement .card-body ul.ACC-det2 li');
        var madeInLi = null;
        var yearLi = null;
        items.each(function( index ) {
            // Find out made in li element
            if($(this).text().toLowerCase().search('made in') != -1){
                madeInLi = $(this).clone();
                $(this).addClass('d-none');
            }
            // Find out year li element
            var regex = /\b(19|20)\d{2}(-\d{4})?\b/g;
            if(regex.test($(this).text())){
                yearLi = $(this).clone();
                $(this).addClass('d-none');
            }
        });
        $('#measurement .card-body .detail-title').addClass('d-none');

        var details = $("#product-card-details").find('#ACC-item .features-container').html();
        $('#details .card-body').html(details);

        //If made in li element found, change text and move into details section
        if(madeInLi != null){
            $('#measurement .card-body ul.ACC-det2 li.d-none').remove();
            var madeInText = madeInLi.text().toLowerCase().replace('made in', 'made in:');
            madeInLi.text(madeInText);
            madeInLi.addClass('text-capitalize');
            $('#details .card-body ul.ACC-det').append(madeInLi[0].outerHTML);
        }

        //If year li element found, move into details section
        if(yearLi != null){
            $('#measurement .card-body ul.ACC-det2 li.d-none').remove();
            $('#details .card-body ul.ACC-det').append(yearLi[0].outerHTML);
        }

        // Shows Additional bullet points for Non Authorized Brands under Details Accordion
        var brand = $(".product-brand").text().trim() || $(".product-brand-link").text().trim();
        var nonAuthBrands = $('#nonAuthBrands').val();

        if(nonAuthBrands.length > 0){
            var unauthorizedBrands = nonAuthBrands.toLowerCase().split(',').map(function (b) {
                return b.trim();
            });
            if (unauthorizedBrands.includes(brand.toLowerCase())) {
                if($("#prodSerial").val().toLowerCase() != 'null' && $("#prodSerial").val().toLowerCase() != 'none' ){
                    $('#details .card-body ul.ACC-det').append('<li>Serial Number: <span class="no-underline">'+ $("#prodSerial").val() +'</span></li>');
                }
                // $('#details .card-body ul.ACC-det').append('<li> What Goes Around Comes Around is not affiliated with ' + brand + ' and has not been authorized by ' + brand + ' to sell this item. </li>');
                $('#legalDisclaimer').append('<span> What Goes Around Comes Around is not affiliated with ' + brand + ' and has not been authorized by ' + brand + ' to sell this item. </span>');
            }
        }

        const locationValue = document.getElementById('store-location-value').innerHTML;
            const storeDetailsNameHTML = `<div class='store-location'><span class='lbl'>${Resource.msg('pdp.storeavailable.text', 'pdpcontent', null)}</span> <span id="store-name"></span>`;
            const storeDetailsButtonHTML = `
                <button
                        aria-label="Store Location Modal"
                        type="button"
                        data-toggle="modal"
                        data-target="#storeLocationModal">
                        <i class="info-icon"></i>
                </button></div>`;

            const storeDetailsHTML = `<li>`+storeDetailsNameHTML+storeDetailsButtonHTML+`</li>`;

        // Handling different store location conditions
        if (locationValue === "Online Only") {
            $('#details .card-body ul').append(`<li>`+storeDetailsNameHTML+`</li>`);
        }else if(locationValue === "Beverly Hills" || locationValue === "Soho" || locationValue === "Wooster"){
            $('#details .card-body ul').append(storeDetailsHTML);
        }
        $('#details .card-body ul #store-name').append(locationValue);
        $('#details .card-body .detail-title').addClass('d-none');
        $('#shipping .card-body .detail-title').addClass('d-none');


    });
</script>


<iscomment> function to generate array of recently viewed product details </iscomment>
<script>
    async function getProductDetailsArray() {
        try {
            const response1 = await fetch("${URLUtils.abs('RecentlyViewed-GetAllProducts')}", {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            const RVProductsData = await response1.json();
            const RVProducts = RVProductsData.products;

            //removing current PDP product from recently viewed array if exists
            const productDetailsArray = RVProducts.filter(RVproduct => RVproduct.id !== `${product.id}`);
            return productDetailsArray;
        } catch (error) {
            console.error("Error fetching product details: ", error);
        }
    }
</script>

<isset name="isQuickView" value="${false}" scope="page" />
<isset name="isProductSet" value="${pdict.product.productType === 'set'}" scope="page" />
<isset name="productDataColumnClass" value="col-12 col-md-5 offset-xl-0" scope="page" />
<iscomment>Override column settings for Page Designer component if applicable</iscomment>
<isif condition="${'pdpImageColumnWidth' in pdict}">
    <isset name="productDataColumnClass" value="col-12 col-md-5 offset-xl-0" scope="page" />
</isif>

<input id="pdpLogInUrl" type="hidden" value="${URLUtils.url("Login-Show")}" />
<input id="pdpCurrencySymbol" type="hidden" value="${pdict.currencySymbol}" />
<input id="pdpSubmitCustomerOffer" type="hidden" value="${URLUtils.url("Product-SubmitCustomerOffer")}" />
<input id="pdpUpdateUserFromMakeAnOffer" type="hidden" value="${URLUtils.url("Account-UpdateUserFromMakeAnOffer")}" />
<input id="pdpGetUserForProductOffer" type="hidden" value="${URLUtils.url("Account-GetUserForProductOffer")}" />
<input id="pdpProductUSDPrice" type="hidden" value="${pdict.productUSDPrice}" />
<input id="pdpCurrencyRate" type="hidden" value="${pdict.currencyRate}" />

<isobject object="${product.raw}" view="detail" />

<div class="container product-detail product-wrapper pdp"
    data-swatchable-attributes="${pdict.product.attrsToUseForSwatch}" data-pid="${product.id}">
    <isif condition="${!pdict.breadcrumbs.isEmpty()}">
        <header class="container page-header">
            <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        </header>
    </isif>
    <iscomment>
        <div class="row d-md-none">
            <div class="col-12">
                <isif condition="${!empty(product.brand) && product.brandLink}">
                    <a class="product-brand-link" href="${product.brandLink}">${product.brand}</a>
                <iselseif condition="${!empty(product.brand)}" />
                    <div class="mb-2 product-brand text-uppercase">${product.brand}</div>
                </isif>
                <h2 class="product-name">${product.productName}</h2>
            </div>
        </div>
    </iscomment>

    <div class="row mt-3 mb-5">
        <!-- Product Images Carousel -->
        <isinclude template="product/components/imagePDPCarousel" />

        <div class="product-data product-details ${productDataColumnClass}">
            <!-- Product Name -->
            <div class="row">
                <div class="col">
                    <isif condition="${!empty(product.brand) && product.brandLink}">
                        <a class="product-brand-link" href="${product.brandLink}"
                            aria-label="${product.brand}">${product.brand}</a>
                    <iselseif condition="${!empty(product.brand)}" />
                        <div class="mb-2 product-brand text-uppercase">${product.brand}</div>
                    </isif>
                    <h1 class="product-name prod-name">
                        ${product.productName}
                        <!-- Social Sharing Dropdown -->
                        <div class="share-options">
                            <button class="nav-link dropdown-toggle" id="socialSharingDropdown" data-toggle="dropdown"
                                aria-haspopup="true" aria-expanded="false" aria-label="Social Share Dropdown">
                                <i class="icon-share_button"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right dropdown-country-selector" role="menu"
                                aria-labelledby="socialSharingDropdown">
                                <!-- Social Sharing Icons -->
                                <div class="row ">
                                    <iscontentasset aid="shareThis" />
                                </div>
                                <div class="copy-page-link">
                                    <div class="lbl"> ${Resource.msg('pdp.copylink.text', 'pdpcontent', null)} </div>
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="pageUrlInput" name="pageUrl"
                                            aria-label="Read-only page URL" readonly />
                                        <button id="copyIcon" type="button" class="icon-content_copy"
                                            data-toast="success" data-content="Link Copied!" data-dismiss="modal"
                                            aria-label="Copy link">
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </h1>


                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="prices top-prices clearfix">
                        <isset name="price" value="${product.price}" scope="page" />
                        <isinclude template="product/components/pricing/main" />
                        <iscomment>
                            <isinclude url="${URLUtils.url('Flow-GetDeliveryWindow')}" />
                        </iscomment>

                        <isset name="globaleSession" value="${require('*/cartridge/models/globale/session')}"
                            scope="page" />
                        <isif condition="${globaleSession.get('geOperatedCountry')}">
                            <iscomment> ${lineItem.priceTotal.price} </iscomment>
                        <iselse/>
                                <!-- Applicable Promotions -->
                                <div class="promotions">
                                    <isinclude template="product/components/promotions" />
                                </div>
                        </isif>

                    </div>
                </div>
            </div>

            <!-- Product Condition Modal -->
            <div class="modal fade" id="conditionScaleModal" tabindex="-1" role="dialog"
                aria-labelledby="conditionScaleModal">
                <div class="modal-dialog modal-dialog-centered modal-md" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div class="modal-title"> ${Resource.msg('pdp.conditionscale.text', 'pdpcontent', null)}
                            </div>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                                    aria-hidden="true">${Resource.msg('pdp.conditionscale.exit', 'pdpcontent', null)}</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="product-condition-details">
                                <div class="details">
                                    ${Resource.msg('pdp.condition.pristine.details', 'pdpcontent', null)}
                                </div>
                                <div class="desc">
                                    ${Resource.msg('pdp.condition.pristine.desc', 'pdpcontent', null)}
                                </div>
                            </div>
                            <div class="product-condition-details">
                                <div class="details">
                                    ${Resource.msg('pdp.condition.excellent.details', 'pdpcontent', null)}
                                </div>
                                <div class="desc">
                                    ${Resource.msg('pdp.condition.excellent.desc', 'pdpcontent', null)}
                                </div>
                            </div>
                            <div class="product-condition-details">
                                <div class="details">
                                    ${Resource.msg('pdp.condition.verygood.details', 'pdpcontent', null)}
                                </div>
                                <div class="desc">
                                    ${Resource.msg('pdp.condition.verygood.desc', 'pdpcontent', null)}
                                </div>
                            </div>
                            <div class="product-condition-details">
                                <div class="details">
                                    ${Resource.msg('pdp.condition.good.details', 'pdpcontent', null)}
                                </div>
                                <div class="desc">
                                    ${Resource.msg('pdp.condition.good.desc', 'pdpcontent', null)}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Product Condition Modal Ends-->

            <!-- Store Location Modal -->
            <iscomment> this is just to fetch the location value inside script tag, hence display none </iscomment>
            <p id="store-location-value" class="pdp-store-location-value">${Product.custom.location[0]}</p>
            <isif condition="${Product.custom.location[0] != "Online Only"}">
                <div class="modal fade" id="storeLocationModal" tabindex="-1" role="dialog"
                    aria-labelledby="storeLocationModal">
                    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
                        <div class="modal-content store-modal-font">
                            <div class="modal-header">
                                <div class="modal-title"> ${Resource.msg('pdp.store.modal.title', 'pdpcontent', null)}
                                </div>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                                        aria-hidden="true">${Resource.msg('pdp.store.modal.exit', 'pdpcontent', null)}</span></button>
                            </div>
                            <div class="modal-body">
                                <div class="store-location-details">
                                    <div class="store-location-details-head">
                                        <i class="icon-address"></i>
                                        <p>${Resource.msg('pdp.store.modal.address.text', 'pdpcontent', null)}</p>
                                    </div>
                                    <div class="store-location-details-body">
                                        <isif condition="${Product.custom.location[0] == "Wooster"}">
                                            <p>${Resource.msg('pdp.store.address.wooster.address1', 'pdpcontent', null)}
                                                <br> ${Resource.msg('pdp.store.address.wooster.address2', 'pdpcontent', null)}</p>
                                            <a class="link" aria-label="Wooster"
                                                href="${Resource.msg('pdp.store.address.wooster.gmap', 'pdpcontent', null)}"
                                                target="_blank" rel="noopener">${Resource.msg('pdp.store.address.direction.text', 'pdpcontent', null)}</a>
                                        <iselseif condition="${Product.custom.location[0] == "Beverly Hills"}">
                                                <p>${Resource.msg('pdp.store.address.beverly.address1', 'pdpcontent', null)} <br> ${Resource.msg('pdp.store.address.beverly.address2', 'pdpcontent', null)}</p>
                                                <a class="link" aria-label="Beverly Hills"
                                                    href="${Resource.msg('pdp.store.address.beverly.gmap', 'pdpcontent', null)}"
                                                    target="_blank" rel="noopener">${Resource.msg('pdp.store.address.direction.text', 'pdpcontent', null)}</a>
                                            <iselseif condition="${Product.custom.location[0] == "Soho"}">
                                                    <p>${Resource.msg('pdp.store.address.soho.address1', 'pdpcontent', null)} <br> ${Resource.msg('pdp.store.address.soho.address2', 'pdpcontent', null)}</p>
                                                    <a class="link" aria-label="Soho"
                                                        href="${Resource.msg('pdp.store.address.soho.gmap', 'pdpcontent', null)}"
                                                        target="_blank" rel="noopener">${Resource.msg('pdp.store.address.direction.text', 'pdpcontent', null)}</a>
                                                <iselse/>
                                                    <a class="link" aria-label="Soho"
                                                        href="${Resource.msg('pdp.store.address.soho.gmap', 'pdpcontent', null)}"
                                                        target="_blank" rel="noopener">${Resource.msg('pdp.store.address.direction.text', 'pdpcontent', null)}</a>
                                                    <p>${Resource.msg('pdp.store.address.exception', 'pdpcontent', null)}</p>
                                        </isif>
                                    </div>
                                </div>
                                <div class="store-location-details">
                                    <div class="store-location-details-head">
                                        <i class="icon-call"></i>
                                        <p>${Resource.msg('pdp.store.modal.phone.text', 'pdpcontent', null)}</p>
                                    </div>
                                    <div class="store-location-details-body">
                                        <isif condition="${Product.custom.location[0] == "Wooster"}">
                                            <a class="ph-no" aria-label="Phone Number"
                                                href="tel:${Resource.msg('pdp.store.address.wooster.phone', 'pdpcontent', null)}">${Resource.msg('pdp.store.address.wooster.phone', 'pdpcontent', null)}</a>
                                        <iselseif condition="${Product.custom.location[0] == "Beverly Hills"}">
                                                <a class="ph-no" aria-label="Phone Number"
                                                    href="tel:${Resource.msg('pdp.store.address.beverly.phone', 'pdpcontent', null)}">${Resource.msg('pdp.store.address.beverly.phone', 'pdpcontent', null)}</a>
                                            <iselseif condition="${Product.custom.location[0] == "Soho"}">
                                                    <a class="ph-no" aria-label="Phone Number"
                                                        href="tel:${Resource.msg('pdp.store.address.soho.phone', 'pdpcontent', null)}">${Resource.msg('pdp.store.address.soho.phone', 'pdpcontent', null)}</a>
                                                <iselse/>
                                                    <p>${Resource.msg('pdp.store.phone.exception', 'pdpcontent', null)}
                                                    </p>
                                        </isif>
                                    </div>
                                </div>
                                <div class="store-location-details store-hours">
                                    <div class="store-location-details-head">
                                        <i class="icon-clock"></i>
                                        <p>${Resource.msg('pdp.store.modal.hours.text', 'pdpcontent', null)}</p>
                                    </div>
                                    <div class="store-location-details-body">
                                        <ul>
                                            <isif condition="${Product.custom.location[0] == "Wooster"}">
                                                <li><span>Monday</span> <span>11am - 7pm</span></li>
                                                <li><span>Tuesday</span> <span>11am - 7pm</span></li>
                                                <li><span>Wednesday</span> <span>11am - 7pm</span></li>
                                                <li><span>Thursday</span> <span>11am - 7pm</span></li>
                                                <li><span>Friday</span> <span>11am - 7pm</span></li>
                                                <li><span>Saturday</span> <span>11am - 7pm</span></li>
                                                <li><span>Sunday</span> <span>12pm - 6pm</span></li>
                                            <iselseif condition="${Product.custom.location[0] == "Beverly Hills"}">
                                                    <li><span>Monday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Tuesday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Wednesday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Thursday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Friday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Saturday</span> <span>10am - 6pm</span></li>
                                                    <li><span>Sunday</span> <span>12pm - 6pm</span></li>
                                                <iselseif condition="${Product.custom.location[0] == "Soho"}">
                                                        <li><span>Monday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Tuesday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Wednesday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Thursday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Friday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Saturday</span> <span>11am - 7pm</span></li>
                                                        <li><span>Sunday</span> <span>12pm - 6pm</span></li>
                                                    <iselse/>
                                                        <p>Null</p>
                                            </isif>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </isif>
            <!-- Store Location Modal Ends-->

            <!-- Sign in/Register Modal -->
            <div class="modal fade" id="signInRegisterModal" tabindex="-1" role="dialog"
                aria-labelledby="signInRegisterModal">
                <div class="modal-dialog modal-dialog-centered modal-md" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div class="modal-title"> ${Resource.msg('pdp.myaccount.text', 'pdpcontent', null)}
                            </div>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                                    aria-hidden="true">${Resource.msg('pdp.conditionscale.exit', 'pdpcontent', null)}</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="details">
                                <div id="loginContent">
                                    <iframe id="loginIframe" width="100%" frameborder="0"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sign in/Register Modal Ends-->

            <isif condition="${!empty(product.headline)}">
                <div class="row mt-3">
                    <div class="col">
                        ${product.headline}
                    </div>
                </div>
                <hr>
            </isif>

            <div class="attributes product-detail-attributes">
                <isset name="isBundle" value="${false}" scope="page" />
                <isset name="loopState" value="{count: 1}" scope="page" />
                <isset name="sizeChartHasBeenShown" value="${false}" scope="page" />
                <isloop items="${product.variationAttributes}" var="attr" status="attributeStatus">
                    <div class="row" data-attr="${attr.id}">
                        <div class="col-12">
                            <iscomment>used for sticky add to cart </iscomment>
                            <isset name="noSwatchOverride" value="${false}" scope="page" />
                            <isinclude template="product/components/variationAttribute" />
                        </div>
                    </div>
                </isloop>

                <div class="product-options">
                    <isif condition="${product.options && product.options.length > 0}">
                        <isinclude template="product/components/options" />
                    </isif>
                </div>

                <iscomment>Sticky Add to Cart</iscomment>
                <div id="addtocart-sticky-bar-isml">
                    <isif condition="${product.enableStickyAddToCart}">
                        <isinclude template="product/components/addToCartStickyBar" />
                    </isif>
                </div>

                <div class="customPDPmessage">
                    <isslot id="pdpoffermessage" description="Products offer message placement" context="global" />
                </div>
                <!-- Product Availability -->
                <iscomment>
                    <isinclude template="product/components/productAvailability" />
                </iscomment>



                <isinclude template="integrations/product/components/beforeAddToCart" />

                <!-- Add To Cart and Quantity -->
                <div class="row qty-cart-container no-gutters" id="qty-cart-container">
                    <isif condition="${(!isBundle && product.options.length === 0) || !product.variationAttributes}">
                        <!-- Quantity Drop Down Menu -->
                        <div class="quantity col-12 col-sm-6 col-md-5 col-lg-3 <isif condition=" ${product.hideQty}">
                            d-none
                    </isif>">
                    <isinclude template="product/components/quantity" />
                </div>
                </isif>

                <div class="prices-add-to-cart-actions col-12 col-sm-6 col-md-12">
                    <!-- Add To Cart -->
                    <div id="add-to-cart-template">
                        <isinclude template="product/components/addToCartProduct" />
                    </div>
                    <div class="wishlist-icon-area">
                        <isif condition="${pdict.isWishlistModal !== true}">
                            <iswishlisticon wishlistpid="${product.wishlistpid}" productname="${product.productName}"
                                gtmdata="${JSON.stringify(product.gtmData)}"
                                addmessage="${'wishlist.addto.wishlist.icon'}"
                                removemessage="${'wishlist.removefrom.wishlist.icon'}" includeicon="true" />
                        </isif>
                    </div>
                    <isif
                        condition="${!dw.system.Site.getCurrent().getCustomPreferenceValue('disableMakeAnOfferDisplay') && !!product.makeAnOfferEnabled}">
                        <!-- Submit an offer modal -->
                        <div class="submit-offer">
                            <div class="">
                                 <button id="btnMakeOffer" class="btn-submit-offer btn btn-secondary" data-toggle="modal"
                                    <isif
                                    condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('GTMEnable')}">
                                    data-gtmdata="${JSON.stringify(product.gtmData)}"
                                    </isif>
                                    data-pid="${product.id}">
                                    ${Resource.msg('submit.offer.button', 'product', null)}
                                </button>

                        <iscomment> <button class="btn-submit-offer btn btn-secondary" data-toggle="modal"
                            data-target="#submitOfferModal"
                            aria-label="${Resource.msg('submit.offer.button', 'product', null)}" <isif
                            condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('GTMEnable')}">
                            data-gtmdata="${JSON.stringify(product.gtmData)}"
                            </isif>
                            data-pid="${product.id}">
                            ${Resource.msg('submit.offer.button', 'product', null)}
                        </button> </iscomment>
                </div>
            </div>
            <div id="submitOfferModal" class="modal fade" tabindex="-1" role="dialog"
                aria-labelledby="submitOfferModal">
                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">${Resource.msg('submit.offer.modal.title', 'product', null)}</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">${Resource.msg('submit.offer.modal.exit', 'product', null)}</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <iscontentasset aid="pdpMakeAnOffer" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                data-dismiss="modal">${Resource.msg('label.modal.close', 'common', null)}</button>
                        </div>
                    </div>
                </div>
            </div>
            </isif>

            <isset name="price" value="${product.price}" scope="page" />
            <isset name="globaleSession" value="${require('*/cartridge/models/globale/session')}"
                scope="page" />
            <isif condition="${globaleSession.get('geOperatedCountry')}">
                <iscomment> ${lineItem.priceTotal.price} </iscomment>
            <iselse/>

                <!-- Affirm OSM -->
                <isinclude template="util/affirmModule" />
                <div class="affirm-pdp-price">
                    <isaffirmpromo context="pdp"
                        fpname="${require('*/cartridge/scripts/utils/affirmUtils').getFPNameForPDP(product)}" />
                </div>

                <!-- Klarna OSM -->
                <isset name="KlarnaOSMEnable" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('KlarnaOSMEnable')}" scope="page" />
                <isif condition="${KlarnaOSMEnable}">
                    <isset name="KlarnaOSMType" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('KlarnaOSMType')}" scope="page" />

                    <klarna-placement
                        data-key="${KlarnaOSMType}"
                        data-locale="en-US"
                        data-purchase-amount="${(product.price.sales.value * 100).toFixed()}"
                    ></klarna-placement>
                </isif>
            </isif>
        </div>
    </div>



    <isif condition="${Product.custom.final_sale}">
        <iscontentasset aid="finalsalecalloutmsg" />
    </isif>




    <!-- tangiblee-cta -->
    <div id="tangiblee-cta-main" class="tangiblee-cta-main">

    </div>

    <!-- Product Condition -->
    <div id='prod-condition'>

    </div>
    <!-- Collabsable -->
    <div class="row accordion-container">
        <div class="col">
            <div id="product-card-details" class="prod-card-body d-none">
                <isprint value="${product.headlineDescription}" encoding="off" />
            </div>
            <!-- Description Section -->
            <div id="description" class="details card aside collapsible-xl" data-expand="true">
                <div class="card-header">
                    <button class="card-title title" aria-expanded="false" aria-controls="collapsible-details-1"
                        aria-label="${Resource.msg('pdp.accordion.description.head', 'pdpcontent', null)}">
                        <iscomment> ${product.collapsibleTitleTwo} </iscomment>
                        ${Resource.msg('pdp.accordion.description.head', 'pdpcontent', null)}
                    </button>
                </div>
                <div class="card-body">
                </div>
            </div>
            <!-- Measurement Section -->
            <div id="measurement" class="details card aside collapsible-xl" data-expand="true">
                <div class="card-header">
                    <button class="card-title title" aria-expanded="false" aria-controls="collapsible-details-1"
                        aria-label=" ${Resource.msg('pdp.accordion.measurement.head', 'pdpcontent', null)}">
                        <iscomment> ${product.collapsibleTitleTwo} </iscomment>
                        ${Resource.msg('pdp.accordion.measurement.head', 'pdpcontent', null)}
                    </button>
                </div>
                <div class="card-body">

                </div>
            </div>
            <!-- Details Section -->
            <div id="details" class="details card aside collapsible-xl" data-expand="true">
                <input id="nonAuthBrands" type="hidden"
                    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('NonAuthorizedBrands')}" />
                <input id="prodSerial" type="hidden" value="${product.serial}" />
                <div class="card-header">
                    <button class="card-title title" aria-expanded="false" aria-controls="collapsible-details-1"
                        aria-label=" ${Resource.msg('pdp.accordion.details.head', 'pdpcontent', null)}">
                        <iscomment> ${product.collapsibleTitleTwo} </iscomment>
                        ${Resource.msg('pdp.accordion.details.head', 'pdpcontent', null)}
                    </button>
                </div>
                <div class="card-body">

                </div>
            </div>
            <!-- Shipping Section -->
            <div id="shipping" class="details card aside collapsible-xl" data-expand="true">
                <div class="card-header">
                    <button class="card-title title" aria-expanded="false" aria-controls="collapsible-details-1"
                        aria-label="${Resource.msg('pdp.accordion.shipping.head', 'pdpcontent', null)}">
                        <iscomment> ${product.collapsibleTitleTwo} </iscomment>
                        ${Resource.msg('pdp.accordion.shipping.head', 'pdpcontent', null)}
                    </button>
                </div>
                <div class="card-body">

                    <isset name="globaleSession" value="${require('*/cartridge/models/globale/session')}"
                        scope="page" />
                    <isif condition="${globaleSession.get('geOperatedCountry')}">
                        <isslot id="product-shipping-info-geCustomer"
                            description="Products shipping information on PDP page" context="global" />
                    <iselse/>

                        <isslot id="product-shipping-info" description="Products shipping information on PDP page"
                            context="global" />
                    </isif>


                </div>
            </div>
        </div>
    </div>
    <!-- Collabsable Section Ends -->

    <!-- Product SKU -->
    <div class="product-sku-number">
        <span class="lbl"> Product SKU: </span>
        <isinclude template="product/components/pidRating" />
    </div>

    <div id="legalDisclaimer">

    </div>

    </div>
</div>



    <div>
        <iscontentasset aid="complete-the-set-recommendations" />
    </div>
    <iscomment> einsten recomenedations pdp start </iscomment>
    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableEinsteinRecommendationOnPDP')}">
    <div class="einstein_section overflow-hidden px-5 w-100">
        <div class="einstein-scroll">
            <isslot id="einstein-pdp-recommendations" description="Einstein PDP Recommendations" context="global" />
        </div>
    </div>
    </isif>
    <iscomment> einsten recomenedations pdp end </iscomment>

     <iscomment> einsten recomenedations RecentlyViewed </iscomment>
    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableEinsteinRecommendationOnRecentlyViewed')}">
    <div class="einstein_section overflow-hidden px-5 w-100">
        <div class="einstein-scroll">
            <isslot id="einstein-RecentlyViewed-Recommendations" description="Einstein PDP Recommendations" context="global" />
        </div>
    </div>
    </isif>
    <iscomment> einsten recomenedations RecentlyViewed </iscomment>


    <!-- Main Content Including Attributes and Collapsible Content -->
    <isset name="loopState" value="{count: 1}" scope="page" />
    <isinclude template="product/components/mainContent" />

    <!-- Tabs -->
    <isinclude template="product/components/tabs" />

</div>

<isif condition="${!empty(product.pdpAssetIds)}">
    <div class="pdp-assets container">
        <div class="row justify-content-center">
            <isloop items="${product.pdpAssetIds}" var="assetId">
                <div class="col-12 col-md pdp-asset">
                    <iscontentasset aid="${assetId}" personalized="true" />
                </div>
            </isloop>
        </div>
    </div>
</isif>

</isobject>
