<form action="${pdict.actionUrl}" class="login" method="POST" name="login-form">
    <input type="hidden" name="isLoginFromPDP" value="${request.httpParameterMap.isLoginFromPDP.stringValue}" />
    <div class="form-group required">
        <label class="form-control-label" for="login-form-email">
            ${Resource.msg('label.input.login.email', 'login', null)}
        </label>
        <input type="email" id="login-form-email" required aria-required="true" class="form-control required" name="loginEmail" value="${pdict.userName}"  aria-describedby="">
        <div class="invalid-feedback" id="form-email-error"></div>
        <div class="sr-only" id="sr-login-form-email-error">
            Please enter a valid email address. This field is required.
        </div>
    </div>

    <div class="form-group required">
        <label class="form-control-label" for="login-form-password">
                ${Resource.msg('label.input.login.password', 'login', null)}
        </label>
        <input type="password" id="login-form-password" required aria-required="true" class="form-control required" name="loginPassword"  aria-describedby="">
        <div class="invalid-feedback" id="form-password-error"></div>
        <div class="sr-only" id="sr-login-form-password-error">
          Please enter your password. This field is required.
        </div>
    </div>

    <div class="clearfix">
        <div class="form-group custom-control custom-checkbox pull-left remember-me">
            <input type="checkbox" class="custom-control-input" id="rememberMe" name="loginRememberMe" value="true"
                <isif condition="${pdict.rememberMe}">checked</isif>
            >
            <label class="custom-control-label" for="rememberMe">
                ${Resource.msg('label.checkbox.login.rememberme', 'login', null)}
            </label>
        </div>

        <div class="pull-right forgot-password text-right">
            <a
                id="password-reset"
                class=""
                title="${Resource.msg('link.login.forgotpassword', 'login', null)}"
                data-toggle="modal"
                href="${URLUtils.url('Account-PasswordResetDialogForm')}"
                data-target="#requestPasswordResetModal"
                cypress-target="forgotPasswordButton">
                ${Resource.msg('link.login.forgotpassword', 'login', null)}
            </a>
        </div>
    </div>

    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}"/>

    <button type="submit" class="btn btn-block btn-primary">${Resource.msg('button.text.loginform', 'login', null)}</button>
</form>
