<iscomment>
    CYPRESS_TEST_TEMPLATE: This template was duplicated from SFRA to add attributes for QA automation testing.
</iscomment>
<div class="modal fade" id="requestPasswordResetModal" tabindex="-1" role="dialog"
   aria-label="Forgot Your Password" aria-describedby="forgotPasswordDesc" cypress-target="requestPasswordResetModal">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title request-password-title">${Resource.msg('label.forgotpassword.heading','login',null)}</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <isinclude template="account/password/passwordResetForm"/>
            </div>
        </div>
    </div>
</div>
