<style>

/* Desktop*/
.embedded-messaging > .embeddedMessagingFrame.isMinimized,
.embedded-messaging > .embeddedMessagingFrame.isMaximized {
    right: 80px !important;
    left: auto !important;
    bottom: 10px !important;
}

.embeddedMessagingConversationButtonWrapper
.embeddedMessagingConversationButton {
    right: 80px !important;
    left: auto !important;
    bottom: 10px !important;
}
/* Mobile & Tablet */
@media only screen and (max-width: 768px) {
  .embedded-messaging > .embeddedMessagingFrame.isMaximized {
      /* left: 16px !important;
      right: 16px !important; */
      height:80%;
      width: auto !important;
      max-width: calc(100vw - 50px) !important;
      border-radius: 12px !important;
  }
}
</style>


<iscomment> This Script is associated with sandox/Development enivironment.</iscomment>
<script type='text/javascript'>
 function initEmbeddedMessaging() {
  try {
    console.log("Initializing Embedded Messaging bot enabled by Salesforcecore...");
   embeddedservice_bootstrap.settings.language = 'en_US'; // For example, enter 'en' or 'en-US'

   embeddedservice_bootstrap.init(
    '00Df4000001SZOK',
    'WGACA_Enhanced_Chat',
    'https://wgaca.my.site.com/ESWWGACAEnhancedChat1771950888388',
    {
     scrt2URL: 'https://wgaca.my.salesforce-scrt.com'
    }
   );
  } catch (err) {
   console.error('Error loading Embedded Messaging: ', err);
  }
 };
</script>
<script type='text/javascript'
    src='https://wgaca.my.site.com/ESWWGACAEnhancedChat1771950888388/assets/js/bootstrap.min.js'
    onload='initEmbeddedMessaging()'></script>

