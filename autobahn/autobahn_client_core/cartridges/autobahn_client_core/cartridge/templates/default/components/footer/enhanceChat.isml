<isset name="enhancedChatEnabled" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatEnabled')}" scope="page" />
<isset name="enhancedChatOrgId" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatOrgId')}" scope="page" />
<isset name="enhancedChatDeploymentName" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatDeploymentName')}" scope="page" />
<isset name="enhancedChatSiteUrl" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatSiteUrl')}" scope="page" />
<isset name="enhancedChatScrt2Url" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatScrt2Url')}" scope="page" />
<isset name="enhancedChatLanguage" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('enhancedChatLanguage') || 'en_US'}" scope="page" />

<isif condition="${enhancedChatEnabled && !empty(enhancedChatOrgId) && !empty(enhancedChatDeploymentName) && !empty(enhancedChatSiteUrl) && !empty(enhancedChatScrt2Url)}">
    <script type="text/javascript">
        (function () {
            var enhancedChatConfig = {
                orgId: '<isprint value="${enhancedChatOrgId}" encoding="jshtml" />',
                deploymentName: '<isprint value="${enhancedChatDeploymentName}" encoding="jshtml" />',
                siteUrl: '<isprint value="${enhancedChatSiteUrl}" encoding="jshtml" />',
                scrt2Url: '<isprint value="${enhancedChatScrt2Url}" encoding="jshtml" />',
                language: '<isprint value="${enhancedChatLanguage}" encoding="jshtml" />'
            };

            function initEmbeddedMessaging() {
                try {
                    embeddedservice_bootstrap.settings.language = enhancedChatConfig.language;
                    embeddedservice_bootstrap.init(
                        enhancedChatConfig.orgId,
                        enhancedChatConfig.deploymentName,
                        enhancedChatConfig.siteUrl,
                        {
                            scrt2URL: enhancedChatConfig.scrt2Url
                        }
                    );
                } catch (error) {
                    window.console.error('Error loading embedded messaging:', error);
                }
            }

            function loadEmbeddedMessaging() {
                var script = document.createElement('script');
                script.src = enhancedChatConfig.siteUrl + '/assets/js/bootstrap.min.js';
                script.onload = initEmbeddedMessaging;
                document.body.appendChild(script);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadEmbeddedMessaging);
            } else {
                loadEmbeddedMessaging();
            }
        }());
    </script>
</isif>

