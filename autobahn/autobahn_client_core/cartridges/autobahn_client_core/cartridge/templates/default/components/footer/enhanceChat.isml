/* Mobile: move chat left so it doesn't overlap reCAPTCHA badge */
@media (max-width: 768px) {

  /* Shift the minimized launcher button left */
  embeddedmessaging-minimized-state.notificationArea {
    right: 100px !important;   /* adjust: 90–140px depending on your captcha badge */
    left: auto !important;
    bottom: 140px !important;
    inset-inline-end: 110px !important;
    inset-inline-start: auto !important;
    z-index: 2147483647 !important;
  }

  /* Also shift any messaging iframe used for the launcher */
  iframe.embeddedMessagingSiteContextFrame,
  iframe[class*="embeddedMessaging"],
  iframe[id*="embeddedMessaging"] {
    right: 5px !important;
    left: auto !important;
    bottom: 120px !important;
    z-index: 2147483647 !important;
  }
}
</style>


