<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/search/frenzy/jquery.stickit.min.js');
        assets.addJs('/js/search/frenzy/swiper.js');
        assets.addJs('/js/search/frenzy-search.js');
        assets.addCss('/css/frenzy.css');
    </isscript>
    <input type="hidden" value="${URLUtils.staticURL('/images/placeholder_ProductTile.png')}" id="prodImgFallbackFrenzySearch">
    <input type="hidden" value="${session.custom.currentCustomer || pdict.currentCustomer.raw.ID}" id="frenzyUserID">
    <input type="hidden" id="addToCartUrl" name="add-to-cart-url" value="${URLUtils.url('Cart-AddProduct')}"/>
    <input type="hidden" id="getCartUrl" name="get-cart-url" value="${URLUtils.url('Cart-Get')}"/>
    <input type="hidden" id="customerNo" name="customerNo" value="${pdict.currentCustomer.profile.customerNo}"/>
	<div>
        <div class="frenzy_search_page" data-currency="$ {{amount}}"></div>
        <div class="you_may_also_like" style="display:none;" data-currency="$ {{amount}}"></div>
    </div>
</isdecorate>

<script>
    window.FRENZY_URL = '${URLUtils.url('Frenzy-Search').toString()}';
    window.Wishlist_ToggleProduct = '${URLUtils.url('Wishlist-ToggleProduct')}';
    window.wishlistPref = ${pdict.wishlistPref};
    window.FRENZY_URL = '${URLUtils.url('Frenzy-Search').toString()}';
</script>
