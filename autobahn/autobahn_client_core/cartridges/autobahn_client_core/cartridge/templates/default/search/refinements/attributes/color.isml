<li class="swatches-vertical col-sm-4 col-md-12 ">
    <button class="d-lg-flex flex-lg-wrap align-items-lg-center" data-href="${refinementValue.url}" data-seo-href="${refinementValue.seoRefineUrl || refinementValue.url}" ${!refinementValue.selectable ? 'aria-disabled="true" disabled' : ''} aria-label="${refinementValue.displayValue}">
        <isif condition="${refinementValue.selected && refinementValue.selectable}">
            <i class="fa fa-check-square"></i>
        <iselse/>
            <i class="fa fa-square-o"></i>
        </isif>
        <span class="${refinementValue.swatchId} swatch-circle color-value swatch-mark ${refinementValue.selected && refinementValue.selectable ? 'selected' : ''} ${!refinementValue.selectable ? 'unselectable' : ''}">
        </span>
        <span title="${refinementValue.title}" class="${refinementValue.selected && refinementValue.selectable ? 'selected' : ''} text-truncate swatch-color-text" aria-hidden="true">
            ${refinementValue.displayValue}
        </span>
        <span class="sr-only selected-assistive-text">
            ${refinementValue.selected && refinementValue.selectable ? Resource.msg('msg.assistive.selected.text', 'common', null) : ''}
            ${refinementValue.title}
        </span>
    </button>
</li>
