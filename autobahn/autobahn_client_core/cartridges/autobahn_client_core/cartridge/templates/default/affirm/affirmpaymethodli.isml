<li class="nav-item" data-method-id="${paymentOption.ID}">
    <a class="nav-link affirm-payment-tab" data-toggle="tab" href="#affirm-payment-content" role="tab">
        <!--- Radio button --->
        <i class="fa fa-check-circle"></i>
        <i class="fa fa-circle-o"></i>

        <img class="affirm-payment-option"
                src="https://cdn-assets.affirm.com/images/blue_logo-transparent_bg.png"
                height="32"
                alt="${paymentOption.name}"
                title="${paymentOption.name}"
        >
        <span class="payment-option-title">Affirm</span>
    </a>
</li>