<isdecorate template="common/layout/page">

    <isinclude template="/components/modules" sf-toolkit="off" />
    <div class="container error-page">
    <iscomment> einstein empty cart recommendation </iscomment>
    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableEinsteinRecommendationOnNoResults')}">
            <div class="einstein_section overflow-hidden px-5 w-100">
                <div class="einstein-scroll">
                    <isslot id="einstein-emptycart-recommendations" description="Einstein Empty Cart Recommendations"
                        context="global" />
                </div>
            </div>
    </isif>
        <iscontentasset aid="error-page-content" />
    </div>
</isdecorate>
