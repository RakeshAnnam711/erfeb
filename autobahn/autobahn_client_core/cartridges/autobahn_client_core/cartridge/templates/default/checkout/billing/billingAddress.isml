<isset name="billingFields" value="${pdict.forms.billingForm.addressFields}" scope="page"/>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group
            ${billingFields.firstName.mandatory === true ? 'required' : ''}
            ${billingFields.firstName.htmlName}">
            <label class="form-control-label"
                for="billingFirstName">${Resource.msg('field.billing.address.first.name', 'address', null)}</label>
            <input autofocus type="text" class="form-control billingFirstName" id="billingFirstName" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.firstName ? pdict.order.billing
                                                                                                            .billingAddress.address.firstName : (pdict.customer && pdict.customer.profile ? pdict.customer.profile.firstName ||
                                                                                                                '' : '')}"
                <isprint value=${billingFields.firstName.attributes} encoding="off" />
            autocomplete="billing given-name" >
            <div class="invalid-feedback"></div>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="form-group
            ${billingFields.lastName.mandatory === true ? 'required' : ''}
            ${billingFields.lastName.htmlName}">
            <label class="form-control-label"
                for="billingLastName">${Resource.msg('field.billing.address.last.name', 'address', null)}</label>
            <input type="text" class="form-control billingLastName" id="billingLastName" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.lastName ? pdict.order.billing
                                                                                                .billingAddress.address.lastName : (pdict.customer && pdict.customer.profile ? pdict.customer.profile.lastName ||
                                                                                                    '' : '')}"
                <isprint value=${billingFields.lastName.attributes} encoding="off" />
            autocomplete="billing family-name">
            <div class="invalid-feedback"></div>
        </div>
    </div>
</div>

<div class="billingAddressFields">
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.address1.mandatory === true ? 'required' : ''}
                ${billingFields.address1.htmlName}">
                <label class="form-control-label"
                    for="billingAddressOne">${Resource.msg('field.billing.address.one', 'address', null)}</label>
                <input type="text" class="form-control smartyAddress billingAddressOne" id="billingAddressOne" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.address1 ? pdict.order.billing
                                                                                                                      .billingAddress.address.address1 : ''}" <isprint value=${billingFields.address1.attributes} encoding="off" />
                autocomplete="billing address-line1">
                <div class="invalid-feedback"></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.address2.mandatory === true ? 'required' : ''}
                ${billingFields.address2.htmlName}">
                <label class="form-control-label"
                    for="billingAddressTwo">${Resource.msg('field.billing.address.two', 'address', null)}</label>
                <input type="text" class="form-control billingAddressTwo" id="billingAddressTwo" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.address2 ? pdict.order.billing
                                                                                                        .billingAddress.address.address2 : ''}" <isprint value=${billingFields.address2.attributes} encoding="off" />
                autocomplete="billing address-line2">
                <div class="invalid-feedback"></div>
            </div>
        </div>
    </div>

    <!--- make drop down--->
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.country.mandatory === true ? 'required' : ''}
                ${billingFields.country.htmlName}">
                <label class="form-control-label"
                    for="billingCountry">${Resource.msg('field.billing.address.country', 'address', null)}</label>
                <select class="form-control billingCountry custom-select" id="billingCountry" <isprint
                    value=${billingFields.country.attributes} encoding="off" />
                autocomplete="billing country">
                <option label=" "></option>
                <isloop items=${billingFields.country.options} var="country">
                    <option id="${country.id}" value="${country.htmlValue}"
                        ${(pdict.order.billing.billingAddress.address && country.id === pdict.order.billing.billingAddress.address.countryCode
                        .value) || pdict.CurrentRequest.geolocation.countryCode === country.id ? "selected" : ""}>
                        ${country.label}
                    </option>
                </isloop>
                </select>
                <div class="invalid-feedback"></div>

            </div>
        </div>
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.states.stateCode.mandatory === true ? 'required' : ''}
                ${billingFields.states.stateCode.htmlName}">
                <label class="form-control-label"
                    for="billingState">${Resource.msg('field.billing.address.state', 'address', null)}</label>
                <select class="form-control billingState custom-select" id="billingState" <isprint
                    value=${billingFields.states.stateCode.attributes} encoding="off" />
                autocomplete="billing address-level1">
                <isloop items=${billingFields.states.stateCode.options} var="state">
                    <option id="${state.id}" value="${state.htmlValue}" ${pdict.order.billing.billingAddress.address && state.id === pdict.order.billing.billingAddress.address.stateCode ?
                                                                        "selected" : ""}>
                        ${state.label}
                    </option>
                </isloop>
                </select>
                <div class="invalid-feedback"></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.city.mandatory === true ? 'required' : ''}
                ${billingFields.city.htmlName}">
                <label class="form-control-label"
                    for="billingAddressCity">${Resource.msg('field.billing.address.city', 'address', null)}</label>
                <input type="text" class="form-control billingAddressCity" id="billingAddressCity" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.city ? pdict.order.billing
                                                                                                          .billingAddress.address.city : ''}" <isprint value=${billingFields.city.attributes} encoding="off" />
                autocomplete="billing address-level2">
                <div class="invalid-feedback"></div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="form-group
                ${billingFields.postalCode.mandatory === true ? 'required' : ''}
                ${billingFields.postalCode.htmlName}">
                <label class="form-control-label"
                    for="billingZipCode">${Resource.msg('field.billing.address.zip.code', 'address', null)}</label>
                <input type="text" class="form-control billingZipCode" id="billingZipCode" value="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.postalCode ? pdict.order
                                                                                                  .billing.billingAddress.address.postalCode : ''}" <isprint value=${billingFields.postalCode.attributes} encoding="off" />
                autocomplete="billing postal-code">
                <div class="invalid-feedback"></div>
                <span>${Resource.msg('example.postalcode', 'forms', null)}</span>
            </div>
        </div>
    </div>
    <!-------------------------------------------------------------------------->
    <!-- Contact Info (Email and Phone)                                       -->
    <!-------------------------------------------------------------------------->
    <fieldset class="contact-info-block" style="border: none !important;">
        <div class="row">
            <div class="col-sm-12">
                <iscomment>Hidden for SFRA 6 upgrade, as many cartridge rely on this fields presence</iscomment>
                <div class="form-group d-none
                            <isif condition=${pdict.forms.billingForm.contactInfoFields.email.mandatory === true}>required</isif>
                            ${pdict.forms.billingForm.contactInfoFields.email.htmlName}">
                    <label class="form-control-label"
                        for="email">${Resource.msg('field.customer.email', 'checkout', null)}</label>

                    <iscomment> <button type="button" class="info-icon" data-toggle="tooltip">
                        <span class="icon" aria-hidden="true">i</span>
                        <span class="sr-only">${Resource.msg('button.help.assistive.text', 'common', null)}</span>
                        <span class="tooltip d-none">
                            ${Resource.msg('tooltip.email', 'creditCard', null)}
                        </span>
                    </button> </iscomment>

                    <input type="email" class="form-control email" id="email"
                        value="${pdict.customer.profile ? pdict.customer.profile.email : (pdict.order.orderEmail || '')}"
                        <isprint value=${pdict.forms.billingForm.contactInfoFields.email.attributesNoPattern}
                        encoding="off" />
                    readonly
                    aria-describedby="emailInvalidMessage" autocomplete="billing email">
                    <div class="invalid-feedback" id="emailInvalidMessage"></div>
                </div>
                <div class="form-group
                            <isif condition=${pdict.forms.billingForm.contactInfoFields.phone.mandatory === true}>required</isif>
                            ${pdict.forms.billingForm.contactInfoFields.phone.htmlName}">
                    <label class="form-control-label"
                        for="phoneNumber">${Resource.msg('field.customer.phone.number', 'checkout', null)}</label>

                    <iscomment> <button type="button" class="info-icon" data-toggle="tooltip"
                        aria-label="${Resource.msg('button.help.assistive.text', 'common', null)}">
                        <span class="icon" aria-hidden="true">i</span>
                        <span class="sr-only">${Resource.msg('button.help.assistive.text', 'common', null)}</span>
                        <span class="tooltip d-none">
                            ${Resource.msg('tooltip.phone.number', 'creditCard', null)}
                        </span>
                    </button> </iscomment>

                    <input type="tel"
                        class="form-control phone ${pdict.forms.billingForm.contactInfoFields.phone.valid ? '' : 'is-invalid'}"
                        id="phoneNumber" value="${pdict.order.billing.billingAddress.address ? pdict.order.billing.billingAddress.address.phone || '' : ''}" <isprint value=${pdict.forms.billingForm.contactInfoFields.phone.attributes}
                        encoding="off" />
                    aria-describedby="phoneInvalidMessage" autocomplete="billing tel">
                    <div class="invalid-feedback" id="phoneInvalidMessage">
                        <isif condition="${!pdict.forms.billingForm.contactInfoFields.phone.valid}">
                            ${Resource.msg('error.message.required', 'forms', null)}
                        </isif>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>

    <isinclude template="integrations/checkout/billing/billingAddress/additionalFields.isml" />
</div>