<iscomment>
    This overwrites what is in rvw_autobahn_core.

    The reason for the duplication is because there are attribute level configurations that are integration specific,
    that couldn't be broken out into its own template

    Any change made here needs may also need to be reflected in the corresponding file in rvw_autobahn_core
</iscomment>
<div>
    <isinclude template="checkout/login" />

    <form autocomplete="on" id="guest-customer"
        class="guest-form ${(dw.system.Site.current.getCustomPreferenceValue('subproEnabled') && pdict.isSubPro) ? '' : 'd-none'}"
        method="POST" action="${URLUtils.url('CheckoutServices-SubmitCustomer')}" <isprint
        value=${pdict.forms.guestCustomerForm.attributes} encoding="off" /> novalidate>
        <fieldset class="customer-information-block">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group required">
                        <label class="form-control-label">
                            ${Resource.msg('field.customer.email', 'checkout', null)}
                        </label>
                        <input type="text" class="form-control email" id="email-guest"
                            value="${(pdict.customer.profile && pdict.customer.profile.email) ? pdict.customer.profile.email: pdict.order.orderEmail}"
                            data-checkemail="${URLUtils.url('CheckoutServices-CheckEmail')}" <isprint
                            value=${pdict.forms.guestCustomerForm.email.attributes} encoding="off" />
                        aria-describedby="guestEmailInvalidMessage" aria-label="${Resource.msg('field.customer.email','checkout',null)}">
                        <div class="invalid-feedback" id="guestEmailInvalidMessage"></div>
                    </div>
                </div>
            </div>
            <strong>${Resource.msg('msg.guest.customer.exists', 'checkout', null)} <button type="button" class="btn btn-link js-login-customer" aria-label="${Resource.msg('action.customer.login', 'checkout', null)}">${Resource.msg('action.customer.login', 'login', null)}</button></strong>
        </fieldset>
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
        <input type="text" class="d-none" name="StackOverflow1370021" value="Don't submit single input form with enter key">
        <!-- Continue To Shipping Button -->
        <div class="col-12 continue-shipping-btn">
            <button class="btn btn-primary btn-block continue-shipping"
                value="continue-shipping" disabled>
                ${Resource.msg('button.continue.shipping', 'checkout', null)}
            </button>
        </div>
    </form>

    <!-- Old Registration Flow -->
    <iscomment>
        <form autocomplete="on" id="registered-customer" method="POST"
            class="registered-form ${(dw.system.Site.current.getCustomPreferenceValue('subproEnabled') && pdict.isSubPro) ? '' : 'd-none'}"
            action="${URLUtils.url('CheckoutServices-LoginCustomer')}" <isprint
            value=${pdict.forms.registeredCustomerForm.attributes} encoding="off" /> novalidate>
        <fieldset class="customer-information-block">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group required">
                        <label class="form-control-label">
                            ${Resource.msg('field.customer.email', 'checkout', null)}
                        </label>
                        <input type="text" class="form-control email" id="email"
                            value="${(pdict.customer.profile && pdict.customer.profile.email) ? pdict.customer.profile.email: pdict.order.orderEmail}"
                            <isprint value=${pdict.forms.registeredCustomerForm.email.attributes} encoding="off" />
                        aria-describedby="emailInvalidMessage" >
                        <div class="invalid-feedback" id="emailInvalidMessage"></div>
                    </div>
                    <div class="form-group password-form">
                        <label class="form-control-label">
                            ${Resource.msg('field.customer.password', 'checkout', null)}
                        </label>
                        <input type="password" class="form-control password" id="password" <isprint
                            value=${pdict.forms.registeredCustomerForm.password.attributes} encoding="off" />
                        aria-describedby="passwordInvalidMessage" >
                        <div class="invalid-feedback" id="passwordInvalidMessage"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <button class="btn btn-primary btn-block submit-customer-login" type="submit" name="submit"
                        value="submit-login">
                        ${Resource.msg('button.customer.login', 'checkout', null)}
                    </button>

                    <button
                        class="btn btn-light btn-block ${(dw.system.Site.current.getCustomPreferenceValue('subproEnabled') && pdict.isSubPro) ? 'd-none' : ''}"
                        name="submit" value="cancel-login">
                        ${Resource.msg('button.customer.login.cancel', 'checkout', null)}
                    </button>
                </div>
            </div>
        </fieldset>
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
        </form>
    </iscomment>

</div>