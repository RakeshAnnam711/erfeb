<script>
    (function () {
        if (window.wgacaZipStateValidationInitialized) {
            return;
        }

        window.wgacaZipStateValidationInitialized = true;

        function getExpectedState(postalCode) {
            var zip = (postalCode || '').toString().trim().split('-')[0];
            var prefix = parseInt(zip.substring(0, 3), 10);

            if (!zip || zip.length < 3 || isNaN(prefix)) {
                return null;
            }

            if (prefix >= 900 && prefix <= 961) return 'CA';
            if (prefix >= 100 && prefix <= 149) return 'NY';
            if (prefix === 5 || prefix === 63) return 'NY';
            if (prefix >= 70 && prefix <= 89) return 'NJ';
            if (prefix >= 270 && prefix <= 289) return 'NC';
            if (prefix >= 30 && prefix <= 38) return 'NH';
            if (prefix >= 206 && prefix <= 219) return 'MD';
            if (prefix >= 430 && prefix <= 459) return 'OH';
            if (prefix >= 460 && prefix <= 479) return 'IN';
            if (prefix >= 840 && prefix <= 847) return 'UT';

            return null;
        }

        function validateZipState(event) {
            var form = event.target.closest('form');
            var zipField;
            var stateField;
            var expectedState;
            var selectedState;
            var errorMessage = '${Resource.msg('smarty.error.zipmismatch', 'checkout', null)}';
            var errorNode;

            if (!form) {
                return;
            }

            zipField = form.querySelector('.shippingZipCode');
            stateField = form.querySelector('.shippingState');

            if (!zipField || !stateField) {
                return;
            }

            expectedState = getExpectedState(zipField.value);
            selectedState = (stateField.value || '').toUpperCase();
            errorNode = zipField.parentNode.querySelector('.invalid-feedback');

            if (expectedState && selectedState && expectedState !== selectedState) {
                zipField.classList.add('is-invalid');
                if (errorNode) {
                    errorNode.innerHTML = errorMessage;
                    errorNode.style.display = 'block';
                }
            } else {
                zipField.classList.remove('is-invalid');
                if (errorNode) {
                    errorNode.innerHTML = '';
                    errorNode.style.display = '';
                }
            }
        }

        document.addEventListener('blur', function (event) {
            if (event.target && event.target.classList.contains('shippingZipCode')) {
                validateZipState(event);
            }
        }, true);

        document.addEventListener('change', function (event) {
            if (event.target && event.target.classList.contains('shippingState')) {
                validateZipState(event);
            }
        });

        document.addEventListener('click', function (event) {
            if (event.target && event.target.closest('.submit-shipping')) {
                setTimeout(function () {
                    var zipField = document.querySelector('.single-shipping .shippingZipCode');

                    if (zipField) {
                        validateZipState({ target: zipField });
                    }
                }, 0);
            }
        });
    }());
</script>
