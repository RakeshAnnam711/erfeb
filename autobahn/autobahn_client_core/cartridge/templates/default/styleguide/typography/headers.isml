                <div class="col-4">
                    <div class="sg__header4 text-capitalize">Desktop Alt</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
           <p class="mb-1">Adding <span class="pre">-alt</span>to the end of a header tag will render the tertiary font being used above.</p> 
        </div>
    </div>
