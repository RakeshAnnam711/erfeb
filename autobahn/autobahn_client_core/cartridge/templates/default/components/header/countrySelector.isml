<iscomment> <isif condition="${pdict.localeModel.locale.localeLinks.length > 0}">
    <div class="custom-dropdown country-selector" data-url="${URLUtils.url('Page-SetLocale')}" tabindex="0">
        <button aria-label="Country Selector" type="button" class="header-link site-country" id="dropdownCountrySelector" data-toggle="modal" data-target="#countrySelectorModal">
            <i class="fi fi-${(pdict.localeModel.locale.countryCode || pdict.localeModel.locale.language || '').toLowerCase()}"></i>
        </button>
    </div>
</isif> </iscomment>

<isset name="globaleSession" value="${require('*/cartridge/models/globale/session')}" scope="page"/>
<isif condition="${globaleSession.get('geEnabled')}">
    <div class="country-selector globale-selector">
        <isinclude url="${URLUtils.url('Globale-CountrySelector')}" />
    </div>
<iselseif condition="${pdict.localeModel.locale.localLinks.length > 0}">
    <div class="dropdown country-selector" data-url="${URLUtils.url('Page-SetLocale')}" tabindex="0">
        <span class="btn dropdown-toggle" id="dropdownCountrySelector" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="flag-icon flag-icon-${pdict.localeModel.locale.countryCode.toLowerCase()}"></i>
            ${pdict.localeModel.locale.displayName}
        </span>
        <div class="dropdown-menu dropdown-country-selector" aria-labelledby="dropdownCountrySelector">
            <isloop items="${pdict.localeModel.locale.localLinks}" var="localeLink">
                <a class="dropdown-item" href="${'#'}" data-locale="${localeLink.localID}" data-currencyCode="${localeLink.currencyCode}" >
                    <i class="flag-icon flag-icon-${localeLink.country.toLowerCase()}"></i>
                    ${localeLink.displayName}
                </a>
            </isloop>
        </div>
    </div>
</isif>
