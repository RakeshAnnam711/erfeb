<iscomment>
    This overwrites what is in rvw_integration_core.
    The reason for the duplication is to update the design while keeping the template unaffected in rvw_integration_core.
</iscomment>

<div class="line-item-brand-section">
    <h1 class="line-item-name line-item-brand-name">${empty(lineItem.brand) ? '' : lineItem.brand}</h1>
    <iscomment> live selling baskets are cleared as a whole, so per line item removal is hidden </iscomment>
    <isif condition="${!lineItem.isBonusProductLineItem && !pdict.isLiveSellingOrder}">
        <div class="remove-line-item">
            <button type="button" class="remove-btn remove-product icon-close" data-toggle="modal"
                    data-target="#removeProductModal" data-pid="${lineItem.id}"
                    data-name="${lineItem.productName}"
                    data-action="${lineItem.productType === 'giftCertificate' ? pdict.actionUrls.removeGiftCertificateLineItem : pdict.actionUrls.removeProductLineItemUrl}"
                    data-uuid="${lineItem.UUID}"
                    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('GTMEnable')}">
                        data-gtmdata="${JSON.stringify(lineItem.gtmData)}"
                    </isif>
                    aria-label="${Resource.msgf('text.remove.line.item','cart', null, lineItem.productName)}">
            </button>
        </div>
    </isif>
</div>


<a class="line-item-name mini-cart" title="${lineItem.productName}" href="${lineItem.productType === 'giftCertificate' ? URLUtils.url('GiftCertificate-Purchase') : URLUtils.url('Product-Show', 'pid', lineItem.id)}" aria-label="${lineItem.productName}">${lineItem.productName}</a>
