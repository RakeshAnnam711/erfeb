<isinclude template="/components/modules" sf-toolkit="off" />
<isset name="objProductLineItem" value="${dw.catalog.ProductMgr.getProduct(lineItem.id)}" scope="page"/>
<isset name="isProductAvaliabe" value="${!empty(objProductLineItem) && objProductLineItem.isOnline}" scope="page"/>
<isset name="placeholderImage" value="${URLUtils.staticURL('/images/placeholder_Thumbnails.png')}" scope="page" />

<div class="product-line-item" data-product-line-item="${lineItem.UUID}">
        <div class="product-line-item-details d-flex flex-row">
                 <isif condition="${isProductAvaliabe}">
                    <a class="item-image mini-cart" href="${lineItem.productType === 'giftCertificate' ? URLUtils.url('GiftCertificate-Purchase') : URLUtils.url('Product-Show', 'pid', lineItem.id)}" aria-label="${Resource.msg('text.product.img','cart',null)}">
                        <img class="product-image"
                            src="${lineItem.images.small[0].url}"
                            alt="${lineItem.images.small[0].alt}"
                            title="${lineItem.images.small[0].title}"
                            width="80"
                            height="120"
                            onerror="this.onerror=null;this.src='${placeholderImage}'">
                    </a>
                <iselse/>
                    <span class="item-image mini-cart">
                        <img class="product-image"
                            src="${lineItem.images.small[0].url}"
                            alt="${lineItem.images.small[0].alt}"
                            title="${lineItem.images.small[0].title}"
                            width="80"
                            height="120"
                            onerror="this.onerror=null;this.src='${placeholderImage}'">
                    </span>
                </isif>
            <div class="item-attributes">
                <iscomment> product details </iscomment>
                <div class="line-item-header">
                    <isif condition=${miniCart}>
                        <isinclude template="checkout/productCard/productCardProductNameAndRemove" />
                    <iselse/>
                        <isif condition="${isProductAvaliabe}">
                            <isinclude template="checkout/productCard/productCardProductName" />
                        <iselse/>
                            ${lineItem.productName}
                        </isif>
                    </isif>
                </div>

                <iscomment> item price section </iscomment>
                <div class="row align-items-start item-price-qty">
                    <isif condition="${lineItem.price || lineItem.hasFlowPrice}">
                        <div class="col line-item-unit-price">
                            <div class="line-item-pricing-info">
                                <isset name="price" value="${lineItem.price}" scope="page"/>
                                <div class="unit-price">
                                    <isif condition="${lineItem.hasFlowPrice}">
                                        <div class="price"><span class="sales">${lineItem.flowPrice}</span></div>
                                    <iselse/>
                                        <isinclude template="/product/components/pricing/cartMain" />
                                    </isif>
                                </div>
                            </div>
                        </div>
                    </isif>
                </div>

                <isloop items="${lineItem.variationAttributes}" var="attribute">
                    <p class="line-item-attributes">${attribute.displayName}: ${attribute.displayValue}</p>
                </isloop>

                <isif condition="${lineItem.productType === 'giftCertificate'}">
                    <isif condition="${!miniCart}">
                        <p title="${lineItem.senderName}" data-value="${lineItem.senderName}" class="line-item-attributes ${pdict.giftCertificateForm.purchase.from.htmlName}-${lineItem.UUID}">${pdict.giftCertificateForm.purchase.from.label}: ${lineItem.senderName}</p>
                        <p title="${lineItem.recipientName}" data-value="${lineItem.recipientName}" class="line-item-attributes ${pdict.giftCertificateForm.purchase.recipient.htmlName}-${lineItem.UUID}">${pdict.giftCertificateForm.purchase.recipient.label}: ${lineItem.recipientName}</p>
                    </isif>
                    <p title="${lineItem.recipientEmail}" data-value="${lineItem.recipientEmail}" class="line-item-attributes ${pdict.giftCertificateForm.purchase.recipientEmail.htmlName}-${lineItem.UUID}">${pdict.giftCertificateForm.purchase.recipientEmail.label}: ${lineItem.recipientEmail}</p>
                    <isif condition="${!miniCart}">
                        <p title="${lineItem.message || ''}" class="line-item-attributes ${pdict.giftCertificateForm.purchase.message.htmlName}-${lineItem.UUID}">${pdict.giftCertificateForm.purchase.message.label}: ${lineItem.message || ''}</p>
                    </isif>
                </isif>

                <div class="item-options">
                    <isloop items="${lineItem.options}" var="option">
                        <div class="line-item-option">${lineItem.productType === 'bundle' ? option.lineItemText : option.displayName}</div>
                    </isloop>
                </div>

                <isif condition="${objProductLineItem.custom.final_sale}">
                    <iscontentasset aid ="finalsalecalloutmsg"/>
                </isif>

                <iscomment> promotion section </iscomment>
                <div class="line-item-promo item-${lineItem.UUID}">
                    <isinclude template="checkout/productCard/productCardProductPromotions" />
                </div>

                <isinclude template="integrations/checkout/productCard/productCardIntegrationsItemAttributesBottom" />
            </div>
        </div>
        <isif condition="${lineItem.productType === 'bundle'}">
            <hr>
            <div class="bundle-includes">${Resource.msg('msg.bundle.includes','cart',null)}</div>
            <iscomment> individual bundled line items </iscomment>
            <isinclude template="cart/productCard/cartProductCardBundledItems" />
        </isif>

    <isset value="${dw.catalog.ProductMgr.getProduct(lineItem.id)}" name="Product" scope="page" />
</div>
