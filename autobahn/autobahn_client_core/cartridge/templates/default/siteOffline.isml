<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>${Resource.msg('siteoffline.title','error',null)}</title>

<style type="text/css">
@font-face  {
	font-family: "BrandonGrotesque-Regular";
	src: url("data:application/font-woff;base64,") format("woff");
}


@font-face  {
	font-family: "BrandonGrotesque-Bold";
	src: url("data:application/font-woff;base64,") format("woff");
}

div { font-size: 32px; object-fit: contain; font-family: "BrandonGrotesque-Regular", sans-serif; line-height: 48px; }
p, a { color: #1a1919;  font-size: 24px; font-family: "BrandonGrotesque-Regular", sans-serif; }
a {text-decoration:none; font-weight:bold; font-family: "BrandonGrotesque-Bold", sans-serif; }
a:hover { text-decoration: underline;}
</style>
</head>
<body>

    <div style="margin:0 auto; text-align:center; margin-top:100px; ">
    <img width=500 src="data:image/png;base64," width="100%">
        <div style=" margin-top: 30px; text-align:center;" class="site-offline">
            <img src="data:image/png;base64," border=0>

            <h1 style="display:none">${Resource.msg('siteoffline.header','error',null)}</h1>
            <p><isprint value="${Resource.msg('siteoffline.message','error',null)}" encoding="off"/></p>
        </div>
    </div>
</body>
