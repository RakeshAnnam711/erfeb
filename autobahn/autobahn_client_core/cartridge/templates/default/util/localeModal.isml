<div class="modal fade" id="countrySelectorModal" tabindex="-1" role="dialog" aria-labelledby="countrySelectorModal">
    <div class="modal-dialog modal-dialog-centered country-modal modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">${Resource.msg('country.selector.modal.header', 'common', null)}</div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close country selector modal"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <iscontentasset aid="countrySelector"/>
            </div>
        </div>
    </div>
</div>
