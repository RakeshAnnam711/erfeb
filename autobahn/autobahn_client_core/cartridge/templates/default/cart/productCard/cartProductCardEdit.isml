<!--- Edit product --->
<isset name="isGiftCertificateLineItem" value="${lineItem.productType === 'giftCertificate'}" scope="page"/>
<iscomment> live selling baskets are cleared as a whole, so per line item actions are hidden </iscomment>
<isif condition="${!pdict.isLiveSellingOrder}">
    <div class="product-edit m-0">
        <iswishlisticon
            extraclass="move"
            nextaction="${URLUtils.url('Cart-RemoveProductLineItem')}"
            wishlistpid="${lineItem.id}"
            productname="${lineItem.productName}"
            uuid="${lineItem.UUID}"
            addmessage="link.move.to.wishlist"
            removemessage="link.remove.from.wishlist"
            includeicon="true"
            includetext="true"
            isinwishlist="${lineItem.isInWishlist}"
            gtmdata="${JSON.stringify(lineItem.gtmData)}"
        />
        <iscomment> remove button </iscomment>
        <isif condition="${!lineItem.isBonusProductLineItem}">
            <isinclude template="integrations/cart/productCard/cartProductCard/deleteButton" />
        </isif>
    </div>
</isif>
