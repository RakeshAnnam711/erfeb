<li class="nav-item d-lg-none custom-dropdown user-authenticated" role="menuitem">
    <div class="pull-right d-block d-lg-none country-icon mt-1">
    <div class="country-selector globale-selector">
        <iscontent type="text/html" charset="UTF-8" compact="true" />
        <isset name="globaleSession" value="${require('*/cartridge/models/globale/session')}" scope="page" />
        <isif condition="${globaleSession.get('geEnabled')}">
            <span class="btn">
                <i class="flag-icon flag-icon-${globaleSession.get('geCountry').toLowerCase()}"></i>
            </span>
        </isif>
    </div>    
    </div>
    <div class="dropdown-link" role="button" data-toggle="dropdown" cypress-target="mobileNavDropdown">
        <a href="${'#'}" class="nav-link dropdown-toggle user-message user-name flex-fill">${Resource.msg('link.header.myaccount', 'account', null)}</a>
    </div>
    <ul class="dropdown-menu" role="menu">
        <li class="dropdown-item" role="menuitem">
            <a href="${URLUtils.https('Account-Show')}" class="dropdown-link" role="button" cypress-target="mobileNavDashboard">${Resource.msg('link.header.myaccount', 'account', null)}</a>
        </li>
        <li class="dropdown-item" role="menuitem">
            <a href="${URLUtils.https('Order-History')}" class="dropdown-link" role="button" cypress-target="mobileNavOrderHistory">${Resource.msg('link.header.orderhistory', 'account', null)}</a>
        </li>
        <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('wishlistEnable')}">
            <li class="dropdown-item" role="menuitem">
                <a href="${URLUtils.https('Wishlist-Show')}" class="dropdown-link" role="button">${Resource.msg('link.wishlist.myaccount', 'account', null)}</a>
            </li>
        </isif>
        <li class="dropdown-item" role="menuitem">
            <a href="${URLUtils.url('Login-Logout')}" class="dropdown-link" role="button" cypress-target="mobileNavLogout">${Resource.msg('link.header.logout', 'account', null)}</a>
        </li>
    </ul>
</li>
