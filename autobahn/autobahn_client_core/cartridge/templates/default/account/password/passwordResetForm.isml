<iscomment>
    CYPRESS_TEST_TEMPLATE: This template was duplicated from SFRA to add attributes for QA automation testing.
</iscomment>
<form class="reset-password-form" action="${URLUtils.url('Account-PasswordResetDialogForm', 'mobile', pdict.mobile)}" method="POST" name="email-form" id="email-form" cypress-target="reset-password-form">
    <input type="hidden" name="isLoginFromPDP" value="${request.httpParameterMap.isLoginFromPDP.stringValue}" />
    <div class="request-password-body" cypress-target="request-password-body">
        <p id="forgotPasswordDesc">
            ${Resource.msg('msg.forgotpassword','login',null)}
        </p>
        <div class="form-group required">
            <label class="form-control-label" for="reset-password-email">
                <isprint value="${Resource.msg('label.input.login.email', 'login', null)}" encoding="htmlcontent" />
            </label>
            <input
                id="reset-password-email"
                type="email"
                class="form-control"
                name="loginEmail"
                aria-describedby="emailHelp"
                placeholder="${Resource.msg('label.input.login.email', 'login', null)}"
                cypress-target="reset-password-email">
            <div class="invalid-feedback" role="alert" id="emailHelp"></div>
        </div>
    </div>
    <div class="send-email-btn">
        <button
            type="submit"
            id="submitEmailButton"
            class="btn btn-primary btn-block"
            cypress-target="reset-password-submit"
        >
            ${Resource.msg('button.send','login',null)}
        </button>
    </div>
</form>
