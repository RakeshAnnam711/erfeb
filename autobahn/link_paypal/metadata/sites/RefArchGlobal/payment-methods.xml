<?xml version="1.0" encoding="UTF-8"?>
<payment-settings xmlns="http://www.demandware.com/xml/impex/paymentsettings/2009-09-15">

    <payment-method method-id="PayPal">
        <name xml:lang="x-default">PayPal</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="ApplePay">
        <name xml:lang="x-default">ApplePay</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="Venmo">
        <name xml:lang="x-default">Paypal Venmo</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="PAYPAL_CREDIT_CARD">
        <name xml:lang="x-default">Paypal Credit Card</name>
        <name xml:lang="fr-FR">Paypal Credit Card</name>
        <name xml:lang="it-IT">Paypal Credit Card</name>
        <name xml:lang="ja-JP">Paypal Credit Card</name>
        <name xml:lang="zh-CN">Paypal Credit Card</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="GooglePay">
        <name xml:lang="x-default">GooglePay</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="bancontact">
        <name xml:lang="x-default">Bancontact</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <countries>
            <country country-code="BE"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
    </payment-method>

    <payment-method method-id="eps">
        <name xml:lang="x-default">EPS</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <countries>
            <country country-code="AT"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
        <ranges>
            <range currency="EUR">
                <min-purchase-amount>1</min-purchase-amount>
            </range>
        </ranges>
    </payment-method>

    <payment-method method-id="ideal">
        <name xml:lang="x-default">iDEAL</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <countries>
            <country country-code="NL"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
    </payment-method>

    <payment-method method-id="mybank">
        <name xml:lang="x-default">MyBank</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <countries>
            <country country-code="IT"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
    </payment-method>

    <payment-method method-id="p24">
        <name xml:lang="x-default">P24</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <countries>
            <country country-code="PL"/>
        </countries>
        <currencies>
            <currency>PLN</currency>
        </currencies>
        <ranges>
            <range currency="PLN">
                <min-purchase-amount>0.05</min-purchase-amount>
            </range>
        </ranges>
    </payment-method>

    <payment-method method-id="blik">
        <name xml:lang="x-default">Blik</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYPAL_LOCAL</processor-id>
        <currencies>
            <currency>PLN</currency>
        </currencies>
    </payment-method>

    <payment-card card-type="MasterCard">
        <name xml:lang="x-default">MasterCard</name>
        <name xml:lang="fr-FR">MasterCard</name>
        <name xml:lang="it-IT">MasterCard</name>
        <name xml:lang="ja-JP">MasterCard</name>
        <name xml:lang="zh-CN">MASTERCARD</name>
        <enabled-flag>true</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>16</length>
            </number-length>
            <number-prefix>
                <prefix>51-55</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>3</security-code-length>
    </payment-card>

    <payment-card card-type="American Express">
        <name xml:lang="x-default">American Express</name>
        <name xml:lang="fr-FR">American Express</name>
        <name xml:lang="it-IT">American Express</name>
        <name xml:lang="ja-JP">American Express</name>
        <name xml:lang="zh-CN">American Express（美国运通卡）</name>
        <enabled-flag>true</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>15</length>
            </number-length>
            <number-prefix>
                <prefix>34</prefix>
                <prefix>37</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>4</security-code-length>
    </payment-card>

