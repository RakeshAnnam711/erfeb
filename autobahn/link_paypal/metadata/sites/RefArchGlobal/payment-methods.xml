    </payment-card>

    <payment-card card-type="Debit networks">
        <name xml:lang="x-default">Debit networks</name>
        <name xml:lang="fr-FR">Debit networks</name>
        <name xml:lang="it-IT">Debit networks</name>
        <name xml:lang="ja-JP">Debit networks</name>
        <name xml:lang="zh-CN">Debit networks（美国运通卡）</name>
        <enabled-flag>true</enabled-flag>
