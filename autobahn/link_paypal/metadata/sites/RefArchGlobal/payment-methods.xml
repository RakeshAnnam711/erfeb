            </number-length>
            <number-prefix>
                <prefix>34</prefix>
                <prefix>37</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>4</security-code-length>
    </payment-card>

    <payment-card card-type="Carte Bancaire">
        <name xml:lang="x-default">Carte Bancaire</name>
        <name xml:lang="fr-FR">Carte Bancaire</name>
        <name xml:lang="it-IT">Carte Bancaire</name>
        <name xml:lang="ja-JP">Carte Bancaire</name>
        <name xml:lang="zh-CN">Carte Bancaire（美国运通卡）</name>
        <enabled-flag>true</enabled-flag>
        <card-number-settings>
