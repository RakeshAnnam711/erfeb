<h2>${Resource.msg('transaction.logs.title', 'paypalbm', null)}</h2>

<div class="pp_accordion js_pp_accordion">
    <div class="pp_accordion_head">
        <span class="pp_accordion_arrow"></span>
        <h3>${Resource.msg('transaction.logs.request.title', 'paypalbm', null)}</h3>
    </div>
    <div class="pp_accordion_body">
        <p>${Resource.msg('transaction.logs.request.text', 'paypalbm', null)}</p>
        <div class="pp_accordion_field">
            <textarea rows="4" cols="45" name="transaction-pp-request">${transaction.paypalRequest}</textarea>
        </div>
    </div>
</div>

<div class="pp_accordion js_pp_accordion">
    <div class="pp_accordion_head">
        <span class="pp_accordion_arrow"></span>
        <h3>${Resource.msg('transaction.logs.response.title', 'paypalbm', null)}</h3>
    </div>
    <div class="pp_accordion_body">
        <p>${Resource.msg('transaction.logs.response.text', 'paypalbm', null)}</p>
        <div class="pp_accordion_field">
            <textarea rows="4" cols="45" name="transaction-pp-response">${transaction.paypalResponse}</textarea>
        </div>
    </div>
</div>
