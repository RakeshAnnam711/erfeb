<isif condition="${pdict.CurrentHttpParameterMap.format.stringValue === 'ajax'}">

    <isdecorate template="paypalbm/util/pageTemplateEmpty">

        <div class="paypalbm_content paypalbm_content_ajax">
            <isreplace/>
        </div>

    </isdecorate>

<iselse/>

    <isdecorate template="application/MenuFrame">

        <link rel="stylesheet" href="${URLUtils.staticURL('css/bm.css')}" />
        <link rel="stylesheet" href="${URLUtils.staticURL('jscript/ext/resources/css/ext-all.css')}" />

        <script src="${URLUtils.staticURL('jscript/ext/adapter/ext/ext-base.js')}"></script>
        <script src="${URLUtils.staticURL('jscript/ext/ext-all.js')}"></script>

        <script src="${URLUtils.staticURL('js/bm_paypal_transactions.js')}" defer="defer"></script>
        <script src="${URLUtils.staticURL('js/bm_paypal_disputes.js')}" defer="defer"></script>

        <isinclude template="components/paypalAdminConfig" />

        <div class="paypalbm_content js-paypalbm-content">
            <isreplace/>
        </div>

    </isdecorate>

</isif>
