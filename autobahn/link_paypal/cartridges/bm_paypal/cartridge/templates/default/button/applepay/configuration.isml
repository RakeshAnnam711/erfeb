<isif condition="${pdict.paymentMethod && pdict.paymentMethod.active}">
    <div class="row py-3">
        <div class="col-6 mb-3">
            <h2 class="h4 mb-3">${Resource.msg('applepay.title', 'configuration', null)}</h2>

            <isinclude template="button/applepay/form" />
        </div>
        <div class="col-4 mb-3 d-flex justify-content-center align-items-center">
            <div id="js-apple-pay-container" class="d-inline-block">
                <isinclude template="button/applepay/applePayButton" />
            </div>
        </div>
    </div>
<iselse/>
    <isinclude template="button/components/paymentMethodDisabled" />
</isif>
