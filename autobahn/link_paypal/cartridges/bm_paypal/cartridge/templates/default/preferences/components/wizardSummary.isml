<div id="summary" class="bm-summary dw-grid d-none" data-wizard-stage="summary">
    <div class="attr-selections dw-scroller dw-pinnable-container dw-grid-container">
        <table>
            <thead class="dw-pinnable">
                <tr class="dw-header-row">
                    <th class="dw-grid-header">
                        <span class="dw-grid-column-inner">${Resource.msg('common.column.name', 'preferences', null)}</span>
                    </th>
                    <th class="dw-grid-header">
                        <span class="dw-grid-column-inner">${Resource.msg('common.column.value', 'preferences', null)}</span>
                    </th>
                </tr>
            </thead>
            <tbody class="js-dw-tbody">
                <tr class="dw-row d-none js-summary-pref-row" >
                    <td class="dw-grid-column ellipsis">
                        <span class="dw-grid-column-inner"></span>
                    </td>
                    <td class="dw-grid-column ellipsis">
                        <span class="dw-grid-column-inner"></span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="vertical-rule"></div>

    <div class="site-selections dw-scroller dw-pinnable-container dw-grid-container">
        <table>
            <thead class="dw-pinnable">
                <tr class="dw-header-row">
                    <th class="dw-grid-header">
                        <span class="dw-grid-column-inner">${Resource.msg('common.label.site', 'preferences', null)}</span>
                    </th>
                </tr>
            </thead>
            <tbody class="js-dw-tbody">
                <tr class="dw-row d-none js-summary-site-row">
                    <td class="dw-grid-column ellipsis">
                        <span class="dw-grid-column-inner"></span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
