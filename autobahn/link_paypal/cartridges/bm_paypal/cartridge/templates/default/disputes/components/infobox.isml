<tr>
    <td class="infobox w e">
        <table cellpadding="0" cellspacing="0" width="100%" class="not_disabled">
            <tbody>
                <tr>
                    <td class="infobox_title_search">
                        ${Resource.msg('dispute.statistics', 'disputes', null)}
                    </td>

                    <td align="right" valign="top" nowrap="nowrap" class="infobox_item_search">
                        <span class="infobox_title_search">
                            ${Resource.msg('dispute.search', 'disputes', null)}
                        </span>&nbsp;
                        <a href="#paypalbm_search_dispute_by_status"
                            class="switch_link js_paypalbm_switch ${pdict.isSearchByDisputeStatus ? 'paypalbm_active_link' : ''}">
                            ${Resource.msg('dispute.search.by.status', 'disputes', null)}
                        </a>&nbsp;

                        <a href="#paypalbm_search_dispute_by_reason"
                            class="switch_link js_paypalbm_switch ${pdict.isSearchByDisputeReason ? 'paypalbm_active_link' : ''}">
                            ${Resource.msg('dispute.search.by.reason', 'disputes', null)}
                        </a>&nbsp;

                        <a href="#paypalbm_search_dispute_by_id"
                            class="switch_link js_paypalbm_switch ${pdict.isSearchByDisputeId ? 'paypalbm_active_link' : ''}">
                            ${Resource.msg('dispute.search.by.id', 'disputes', null)}
                        </a>&nbsp;
                    </td>
                </tr>

                <tr>
                    <td class="infobox_title_search">
                        <isif condition="${pdict.availabilityOfStats}">
                            <svg class="js-dispute-pie-chart" data-stats="${pdict.stats}" width="380" height="160"></svg>
                        <iselse/>
                            <div class="paypalbm_transactions">
                                ${Resource.msg('disputes.notfound', 'disputes', null)}
                            </div>
                        </isif>
                    </td>
                    <td class="infobox_item_search">
                        <table>
                            <isinclude template="disputes/components/tabs/searchbystatus" />
                            <isinclude template="disputes/components/tabs/searchbyreason" />
                            <isinclude template="disputes/components/tabs/searchbyid" />
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">&nbsp;</td>
                </tr>
            </tbody>
        </table>
    </td>
</tr>
