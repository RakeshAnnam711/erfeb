<tr id="paypalbm_search_dispute_by_reason"
    class="js_paypalbm_switch_block ${pdict.isSearchByDisputeReason ? 'table-row' : 'none'}">
    <td class="infobox_item_search" colspan="2">
        <form action="${URLUtils.https('Disputes-Start')}" method="GET">
            <table>
                <tr class="infobox_item_search_tr">
                    <td class="infobox_item_search" width="110" nowrap="nowrap">
                        ${Resource.msg('dispute.search.reason', 'disputes', null)}
                    </td>

                    <td class="infobox_item_search">
                        <select id="disputeReason" name="disputeReason" class="inputfield">
                            <option value="">${Resource.msg('forms.select', 'paypalbm', null)}</option>

                            <isloop items="${pdict.disputeReasons}" var="disputeReason">
                                <option value="${disputeReason.value}" ${pdict.isSearchByDisputeReason && pdict.CurrentHttpParameterMap.disputeReason.stringValue === disputeReason.value ? "selected" : ""}>
                                    ${disputeReason.label}
                                </option>
                            </isloop>
                        </select>

                        <button name="simpleSearch" value="true" class="button">
                            ${Resource.msg('search.submitbutton', 'paypalbm', null)}
                        </button>
                    </td>

                    <td class="infobox_item_search">&nbsp;</td>
                    <td class="infobox_item_search"></td>
                </tr>
            </table>
        </form>
    </td>
</tr>
