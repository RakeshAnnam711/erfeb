<link rel="stylesheet" href="${URLUtils.staticURL('/css/paypal.css')}"/>
<link rel="stylesheet" href="${URLUtils.staticURL('/css/global.css')}"/>

<script defer="defer" src="${URLUtils.staticURL('/js/int_paypal_automaticPaymentMethodAdding.js')}"></script>
<script defer="defer" src="${URLUtils.staticURL('/js/main.js')}"></script>
<script src="${pdict.paypal.sdkUrl}" data-partner-attribution-id="${pdict.paypal.partnerAttributionId}"></script>

<div class="container">

    <div class="paypal-info_title">
        <h3>${Resource.msg('paypal.automatic.payment.adding.question.' + pdict.addingStage, 'locale', null)}</h3>
    </div>

    <div class="d-flex align-items-center justify-content-center flex-column mt-5">
        <div class="btn btn-block btn-primary mb-3 mt-5 position-relative js-apma-button-yes">
            ${Resource.msg('paypal.automatic.payment.adding.button.yes.title', 'locale', null)}

            <div class="btn btn-block p-0 border-0 m-0 top-0 position-absolute automatic-payment-adding-paypal-button js-apma-button-paypal"
                 data-adding-stage="${pdict.addingStage}"
                 data-address-object="${pdict.addressObject}"
                 data-redirect-url="${pdict.redirectURL}">
            </div>
        </div>

        <a href="${pdict.redirectURL}" class="btn btn-block btn-outline-primary">
            ${Resource.msg('paypal.automatic.payment.adding.button.no.title', 'locale', null)}
        </a>

        <input type="hidden" id="csrf_token" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    </div>

    <div class="automatic-payment-adding_error"></div>
</div>

<isinclude url="${URLUtils.url('Includes-Urls')}" />
<isinclude url="${URLUtils.url('Includes-Constants')}" />
