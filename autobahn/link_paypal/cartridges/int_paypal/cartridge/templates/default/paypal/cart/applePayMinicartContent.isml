<isset name="applePayConfigs" value="${pdict.paypal.applePayConfigs}" scope="page"/>

<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/int_paypal_cart.js');
    assets.addCss('/css/paypal.css');
</isscript>

<div class="row">
    <div class="js-applepay-content col-12" id="applepay-content">
        <div class="applepay-cart-buttons-wrap">
            <div class="applepay-cart-button-wrap js-applepay-cart-button-wrap d-none">
                <div class="js-mini-cart-btn applepay-minicart-button js-applepay-button justify-content-center"
                    data-configs="${JSON.stringify(applePayConfigs)}"
                    data-paypal-billing-form-fields="${JSON.stringify(pdict.paypal.applePayFormFields)}">
                    <isinclude template="paypal/components/applePayButton"/>
                </div>
                <div class="paypalLoader paypal-loader-container">
                    <i class="paypal-loader"></i>
                </div>
            </div>
        </div>
    </div>
</div>
