<isif condition="${pdict.paypal.fraudNet}">
    <isset name="fraudNetLocation" value="SFCC-PP-PLUGIN-PDP" scope="page" />
    <isinclude template="paypal/components/fraudNet" />
</isif>

<isset name="payPalData" value="${pdict.paypal}" scope="page" />
<isset name="paypalConfig" value="${payPalData.buttonConfig}" scope="page" />
<isset name="buttonMessageConfig" value="${payPalData.buttonMessageConfig}" scope="page" />
<isset name="billingFormFields" value="${payPalData.billingFormFields}" scope="page" />

<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs(pdict.paypal.sdkUrl);
    assets.addJs('/js/int_paypal_pdp.js');
    assets.addCss('/css/paypal.css');
</isscript>

<div class="row">
    <div class="paypal-content col-12" id="paypal-content">
        <div class="pdp-paypal-button-container">
            <div class="paypalLoader paypal-loader-container">
                <i class="paypal-loader"></i>
            </div>
            <div class="js-paypal-button-on-product-page"
                data-pp-uuid="${require('dw/util/UUIDUtils').createUUID()}"
                data-buttons-to-render="${payPalData.buttonsToRender}"
                data-paypal-button-config="${JSON.stringify(paypalConfig)}"
                ${payPalData.isPayPalButtonMessageEnabled
                    ? "data-paypal-button-message-config=" + buttonMessageConfig : ''}
                data-paypal-billing-form-fields="${JSON.stringify(billingFormFields)}"
                data-digital-goods="${JSON.stringify(pdict.paypal.digitalGoodsData)}"
                data-customer-email="${payPalData.customerEmail}"
                ${payPalData.userIdToken ? "data-user-id-token=" + payPalData.userIdToken : ''}>
            </div>
        </div>
    </div>
</div>
