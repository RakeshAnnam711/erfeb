<li class="nav-item" data-method-id="${paymentOption.ID}">
    <iscomment>Autobahn Customization</iscomment>
    <a class="nav-link paypal-tab <isif condition="${pdict.selectedPaymentMethod == 'PayPal'}">active</isif>" data-toggle="tab" href="#paypal-content" role="tab">
        <img class="credit-card-option"
                src="${URLUtils.staticURL('/images/paypal_mark_logo.png')}"
                height="32"
                alt="${paymentOption.name}"
                title="${paymentOption.name}"
        >
    </a>
</li>
