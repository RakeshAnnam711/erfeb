<link rel="stylesheet" href="${URLUtils.staticURL('/css/paypal.css')}"/>
<link rel="stylesheet" href="${URLUtils.staticURL('/css/global.css')}"/>

<div class="container">

    <div class="modal-header">${Resource.msg('paypal.account.linking.title', 'locale', null)}</div>

    <div class="paypal-info_title">
        <h3>${Resource.msg('paypal.account.linking.existed.account.cancel', 'locale', null)}</h3>
    </div>

    <div class="d-flex align-items-center justify-content-center flex-column mt-5">
        <a href="${pdict.redirectUrl}" class="btn btn-block btn-primary">OK</a>
    </div>
</div>
