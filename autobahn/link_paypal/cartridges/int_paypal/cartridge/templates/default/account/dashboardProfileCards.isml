<isscript>
    var assets = require('*/cartridge/scripts/assets.js');

    assets.addJs('/js/int_paypal_account.js');
    assets.addCss('/css/paypal.css');
</isscript>

<div class="row justify-content-center js-account-dashboard">
    <div class="col-sm-6">
        <iscomment> Profile </iscomment>
        <isinclude template="account/profileCard" />

        <isif condition="${!pdict.account.isExternallyAuthenticated}">
            <iscomment> Password </iscomment>
            <isinclude template="account/passwordCard" />
        </isif>

        <iscomment> Address Book </iscomment>
        <isinclude template="account/addressBookCard" />
    </div>
    <div class="col-sm-6">
        <iscomment> Order History </iscomment>
        <isif condition="${pdict.account.orderHistory}">
            <isset name="order" value="${pdict.account.orderHistory}" scope="page" />
            <isinclude template="account/order/orderHistoryCard" />
        </isif>
        <iscomment> Paypal credit card block </iscomment>
        <isif condition="${pdict.paypal && pdict.paypal.isCreditCardBlockVisible}">
            <isinclude template="account/paypal/paymentCard" />
        </isif>
        <iscomment> Paypal payment block </iscomment>
        <isif condition="${pdict.paypal && pdict.paypal.isPayPalBlockVisible}">
            <isinclude template="account/paypal/paymentPaypal" />
        </isif>
    </div>
</div>
