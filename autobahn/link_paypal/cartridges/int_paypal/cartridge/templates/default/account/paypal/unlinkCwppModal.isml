<div class="modal fade" id="unlinkCwppModal" tabindex="-1" role="dialog" aria-labelledby="unlinkCwppModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="paypal-modal-header">
                <h2 class="modal-title">${Resource.msg('label.unlink.heading','account',null)}</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>

            <div class="paypal-modal-body">
                <div class="unlink-cwpp-body">
                    <p>
                        ${Resource.msg('label.unlink.info','account',null)}
                    </p>
                    <p>
                        ${Resource.msg('label.unlink.confirmation','account',null)}
                    </p>
                </div>
                <div class="float-right">
                    <button type="button" class="btn btn-outline-primary" data-dismiss="modal">
                        ${Resource.msg('label.unlink.cancel','account',null)}
                    </button>
                    <button type="button" class="btn btn-primary js-unlink-submit" data-dismiss="modal">
                        ${Resource.msg('label.unlink.ok','account',null)}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
