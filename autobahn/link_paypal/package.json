{
  "name": "paypal",
  "version": "25.3.0",
  "description": "Paypal SFRA cartridge",
  "main": "index.js",
  "engines": {
    "node": ">=4.0"
  },
  "scripts": {
    "test": "sgmf-scripts --test 'test/unit/**/*.js'",
    "unit:testReport": "mocha test/unit/**/*.js --reporter=mochawesome",
    "unit:coverageReport": "nyc --reporter=lcov --reporter=text-summary mocha test/unit/**/*.js",
    "lint:js": "eslint \"cartridges/**/*.js\"",
    "lint:isml": "isml-linter",
    "lint:test": "eslint --config test/.eslintrc.json test/unit/**/*.js",
    "lint": "npm run lint:js && npm run lint:test && npm run lint:isml",
    "fix:isml": "isml-linter --autofix",
    "fix:js": "eslint --fix \"cartridges/**/*.js\"",
    "fix:test": "eslint --config test/.eslintrc.json --fix test/unit/**/*.js",
    "fix:code": "npm run fix:js && npm run fix:test && npm run fix:isml",
    "husky:lint:fix": "npm run fix:code",
    "compile:js": "sgmf-scripts --compile js",
    "compile:js:dev": "npm run compile:js --mode=development",
    "compile:js:prod": "npm run compile:js --mode=production"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SalesforceCommerceCloud/link_paypal.git"
  },
  "author": "Harry Potter",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-destructuring": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/register": "^7.28.3",
    "babel-loader": "^9.2.1",
    "babel-plugin-rewire": "^1.2.0",
    "chai": "^3.5.0",
    "dw-api-mock": "git+ssh://git@github.com:SalesforceCommerceCloud/dw-api-mock.git",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-sonarjs": "^1.0.3",
    "husky": "^4.2.5",
    "isml-linter": "^5.26.4",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.3",
    "nyc": "^15.1.0",
    "prettier": "3.0.0",
    "proxyquire": "1.7.4",
    "sgmf-scripts": "^3.0.0",
    "sinon": "^17.0.1",
    "sinon-test": "^3.1.6"
  },
  "dependencies": {
    "cleave.js": "^1.5.3"
  },
  "optionalPeerDependencies": {
    "dw-api-mock": "git+ssh://git@github.com:SalesforceCommerceCloud/dw-api-mock.git"
  },
  "packageName": "int_paypal",
  "overrides": {
    "request": {
      "form-data": "^4.0.1"
    },
    "tough-cookie": "^4.1.4",
    "tmp": "^0.2.3",
    "merge": "^2.1.1"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "paths": {
    "base": "../storefront-reference-architecture/cartridges/app_storefront_base"
  }
}