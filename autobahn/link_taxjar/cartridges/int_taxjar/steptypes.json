{
    "step-types": {
        "chunk-script-module-step": [
            {
                "@type-id": "custom.TaxJar.SyncOrders",
                "module": "int_taxjar/cartridge/scripts/steps/syncOrders.js",
                "@supports-parallel-execution":"true",
                "@supports-site-context":"true",
                "@supports-organization-context":"false",
                "description": "Sync orders to TaxJar",
                "before-step-function":"beforeStep",
                "total-count-function":"getTotalCount",
                "read-function":"read",
                "process-function":"process",
                "write-function":"write",
                "after-step-function":"afterStep",
                "chunk-size":100,
                "transactional":"true",
                "parameters": {
                    "parameter": [
                        {
                            "@name": "ForceSync",
                            "description": "When enabled, syncs all orders regardless of sync status. Otherwise only syncs orders that have been updated since last sync.",
                            "@type": "boolean",
                            "@required": "false",
                            "default-value": "false"
                        },
                        {
                            "@name": "StartTime",
                            "description": "Start date time to sync orders. This parameter is optional. If no start or end time is set orders from the last 30 minutes will be synced to TaxJar.",
                            "@type": "datetime-string",
                            "@required": "false"
                        },
                         {
                            "@name": "EndTime",
                            "description": "End date time to sync orders. This parameter is optional. If no start or end time is set orders from the last 30 minutes will be synced to TaxJar.",
                            "@type": "datetime-string",
                            "@required": "false"
                        },
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "ERROR",
                            "description": "Used when an error occurred."
                        },
                        {
                            "@code": "OK",
                            "description": "Used when execution was successful."
                        },
                    ]
                }
            }
        ]
    }
}