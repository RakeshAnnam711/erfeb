<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <service-credential service-credential-id="taxjar.api.token">
        <url>https://api.taxjar.com</url>
        <user-id>TaxJar User ID</user-id>
        <password encrypted="true" encryption-type="common.export"></password>
    </service-credential>

    <service-profile service-profile-id="TaxJar REST API">
        <timeout-millis>2000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>false</cb-enabled>
        <cb-calls>0</cb-calls>
        <cb-millis>0</cb-millis>
    </service-profile>

    <service service-id="taxjar.http.api">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>taxjar</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>TaxJar REST API</profile-id>
        <credential-id>taxjar.api.token</credential-id>
    </service>

</services>
