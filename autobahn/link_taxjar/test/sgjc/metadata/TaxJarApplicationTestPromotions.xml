    <campaign campaign-id="TaxJarTests">
        <description>Campaign for TaxJar application and integration tests</description>
        <enabled-flag>true</enabled-flag>
        <campaign-scope>
            <applicable-online/>
        </campaign-scope>
        <customer-groups match-mode="any">
            <customer-group group-id="Everyone"/>
