    <promotion promotion-id="TaxJarProductAmountOff">
        <enabled-flag>true</enabled-flag>
        <archived-flag>false</archived-flag>
        <searchable-flag>false</searchable-flag>
        <refinable-flag>false</refinable-flag>
        <exclusivity>no</exclusivity>
        <callout-msg xml:lang="x-default">TaxJarProductAmountOff</callout-msg>
        <details xml:lang="x-default">TaxJarProductAmountOff</details>
        <product-promotion-rule>
            <discounted-products>
                <included-products>
                    <condition-group>
                        <product-id-condition operator="is equal">
                            <product-id>708141677203</product-id>
                        </product-id-condition>
                    </condition-group>
                </included-products>
            </discounted-products>
            <simple-discount>
                <amount>10.0</amount>
            </simple-discount>
        </product-promotion-rule>
    </promotion>

