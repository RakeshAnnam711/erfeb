{
    "allowStagingInitialize": false,
    "allowSlackSuccessNotifications": false,
    "clientId": "PLACE-PROJECT-CLIENTID-HERE",
    "dataFinal": "attribute_groups",
    "dataReverse": true,
    "defaultDeployEnvironment": "development",
    "defaultDataCommand": "data:meta, data:clientmeta",
    "stagingDomain": "SFCC-STAGING-DOMAIN.demandware.net",
    "stagingSecureDomain": "cert.SFCC-SECURE-STAGING-DOMAIN.demandware.net",
    "developmentDomain": "SFCC-DEVELOPMENT-DOMAIN.demandware.net",
    "sandboxDomainPrefix": "realmid-",
    "sandboxNumber": "001",
    "sandboxDomainPostfix": ".sandbox.us03.dx.commercecloud.salesforce.com",
    "siteRename": true,
    "delimiter": ":",
    "replace": [
        "INSTANCETIMEZONEREPLACEME:Etc/Universal",
        "Siteidreplaceme:SiteID_TitleCase_NoSpace",
        "Sitenamereplaceme:Site Name Title Case",
        "sitenamereplaceme:Site Name Lower Case",
        "SITENAMEREPLACEME:SITE NAME UPPER CASE",
        "sitecatalogidreplaceme:storefront-catalog-id",

        "WORKFLOW.PROJECTCLIENTID.REPLACEME:PLACE-PROJECT-SPECIFIC-CLIENTID-HERE-REQUIRED-FOR-SANDBOX-WORKFLOWS",
        "CRMCLIENTIDREPLACEME:PLACE-CRM-SPECIFIC-CLIENTID-HERE",
        "CRMALLOWEDORIGINREPLACEME:urlfor.development.sandbox.salesforce.com",
        "SOMORDERSYNCCLIENTIDREPLACEME:PLACE-SOM-ORDERSYNC-CLIENTID-HERE",
        "YOTPOSERVICES.CLIENTID.REPLACEME:PLACE-YOTPO-SPECIFIC-CLIENTID-HERE",
        "PASSWORDLESSLOGIN.CLIENTID.REPLACEME:PLACE-SLAS-SPECIFIC-CLIENTID-HERE",
        "PASSWORDLESSLOGIN.CLIENTSECRET.REPLACEME:PLACE-SLAS-SPECIFIC-CLIENTPASS-HERE",
        "PASSWORDLESSLOGIN.ORGID.REPLACEME:originid-from-bm",
        "PASSWORDLESSLOGIN.REALMID.REPLACEME:realmid-from-bm"
    ],

    "__comment__1": "glob patterns to ignore data folders relative to each data sub folder (meta, initialize, etc...)",
    "dataIgnore": [
        "**/*.sample",
        "rvw_autobahn_core/access-roles.xml",
        "rvw_autobahn_core/catalogs/**",
        "rvw_autobahn_core/customer-groups.xml",
        "rvw_autobahn_core/geolocations/**",
        "rvw_autobahn_core/customer-lists/**",
        "rvw_autobahn_core/inventory-lists/**",
        "rvw_autobahn_core/ocapi-settings/*.json",
        "rvw_autobahn_core/pricebooks/**",
        "rvw_autobahn_core/preferences.xml",
        "rvw_autobahn_core/sites/**",
        "rvw_autobahn_core/webdav/*.json",
        "sample_sfra_definitions/**"
    ],

    "__comment__2": "property to limit workspace and builds to applicable cartridges",
    "cartridge": [
        "autobahn_client_core",
        "rvw_integrations_core",
        "rvw_autobahn_core",
        "rvw_pagedesigner_core",
        "rvw_bopis_integration",
        "rvw_som_integration",
        "rvw_integrations_base",
        "app_storefront_base",
        "modules",
        "bm_autobahn_core",
        "bm_pagedesigner_custom",
        "bc_job_components",
        "bm_app_storefront_base",
        "bm_custom_plugin"
    ]
}
