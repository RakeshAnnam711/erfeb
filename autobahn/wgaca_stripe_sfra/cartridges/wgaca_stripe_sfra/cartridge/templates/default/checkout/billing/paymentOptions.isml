<iscomment> <isset name="currentSite" value="${dw.system.Site.getCurrent()}" scope="page"/>
<isif condition="${currentSite.getCustomPreferenceValue('giftCertificateEnabled') && (!pdict.order.giftCertificateLineItems || !pdict.order.giftCertificateLineItems.totalQuantity) && pdict.giftCertificatePaymentMethodEnabled}">
    <isinclude template="components/modules"/>
    <div class="row giftcertificate-information <isif condition="${pdict.order && pdict.order.totals && !pdict.order.totals.grandTotalValueOrNull}">d-none</isif>">
        <div class="col-12">
            <div class="form-group">
                <div>
                    <label class="form-control-label" for="giftcertificateid">
                        <isprint value="${pdict.giftCertificateForm.balance.giftcertificateid.label}" encoding="htmlcontent" />
                    </label>
                </div>
                <div class="row giftCertificates-code-wrapper">
                    <div class="col-10">
                        <div class="row giftCertificate-input-wrapper">
                            <div class="row no-gutters giftCertificateCode-pills-wrapper">
                                <isloop items="${pdict.order.billing.payment.selectedPaymentInstruments}" var="paymentInstrument">
                                        <div class="giftCertificate-pill">
                                            <div class="d-inline-flex giftCertificate-code">${paymentInstrument.maskedGiftCertificateCode}</div>
                                            <button type="button" class="js-remove-giftcertificate-pi" aria-label="Remove giftcertificate" data-action="${URLUtils.https('GiftCertificate-RemoveGiftCertificatePaymentInstrument')}" data-giftcertificatecode="${paymentInstrument.giftCertificateCode}">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                </isloop> 
                            </div>
                            <div class="giftCertificate-input-area flex-fill">
                                <input type="string" class="form-control" id="giftcertificateid" placeholder="  ${Resource.msg('giftcertificate.checkout.placeholder', 'checkout', null)}"
                                    <isprint value="${pdict.giftCertificateForm.apply.giftcertificateid.attributes}" encoding="off" />>
                                <div class="invalid-feedback"></div>
                                <div class="d-none my-2">
                                    <button type="button" data-action="${URLUtils.https('GiftCertificate-ApplyBalance')}" aria-label="${Resource.msg('giftcertificate.checkout.apply', 'checkout', null)}" class="btn btn-block btn-secondary js-applybalancebutton" value="${Resource.msg('giftcertificate.checkout.apply', 'locale', null)}">
                                        ${Resource.msg('giftcertificate.checkout.apply', 'checkout', null)}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-2 gift-apply-btn">
                        <button type="button" data-action="${URLUtils.https('GiftCertificate-ApplyBalance')}" class="btn btn-block btn-secondary js-applybalancebutton" value="${Resource.msg('giftcertificate.checkout.apply', 'locale', null)}">
                            ${Resource.msg('giftcertificate.checkout.apply', 'checkout', null)}
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 my-2 ">
            <div class="js-balancemsg" aria-live="polite"></div>
        </div>
        <div class="js-giftcertificatepaymentinstruments col-12 mb-4">
            <isgiftcertificatepaymentinstruments paymentinstruments="${pdict.order.billing.payment.selectedPaymentInstruments}"/>
        </div>
    </div>
</isif> </iscomment>
<iscomment> <div class="form-nav billing-nav payment-information <isif condition="${pdict.order && pdict.order.totals && !pdict.order.totals.grandTotalLessGiftCertificatePaymentInstrumentsValue}">d-none</isif>"
     data-payment-method-id="${pdict.selectedPaymentMethod}"
     data-is-new-payment="${pdict.customer.registeredUser && pdict.customer.customerPaymentInstruments.length ? false : true}">
     <p class="payment-options-heading"> ${Resource.msg('heading.payment.method', 'checkout', null)} </p>
    <ul class="nav nav-tabs nav-fill payment-options" role="tablist">
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsTabs" />
    </ul>
</div>
<div class="credit-card-selection-new <isif condition="${pdict.order && pdict.order.totals && !pdict.order.totals.grandTotalLessGiftCertificatePaymentInstrumentsValue}">d-none</isif>">
    <div class="tab-content">
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsContent" />
    </div>
</div> </iscomment>

<isset name="stripeHelper" value="${require('*/cartridge/scripts/stripe/helpers/stripeHelper')}" scope="page" />
<isset name="isStripePaymentElementEnabled" value="${stripeHelper.isStripePaymentElementEnabled()}" scope="page" />
<isset name="isCreditCardEnabled" value="${stripeHelper.isCreditCardEnabled()}" scope="page" />
<isset name="payPalData" value="${pdict.paypal}" scope="page" />
<isset name="isPaypalCardFieldsEnabled" value="${payPalData && payPalData.isPayPalActive && payPalData.isPaypalCardFieldsEnabled}" scope="page" />
<isset name="isBasicCreditCardVisible" value="${!payPalData || !payPalData.isPayPalActive || !isPaypalCardFieldsEnabled}" scope="page" />

<isset name="wallet" value="${stripeHelper.getStripeWallet(customer)}" scope="page" />
<isset name="savedCards" value="${wallet.getPaymentInstruments()}" scope="page" />
<isset name="hasSavedCards" value="${!empty(savedCards)}" scope="page" />
<isset name="selectedPaymentInstruments" value="${pdict.order.billing.payment.selectedPaymentInstruments}" scope="page" />
<isset name="selectedPaymentInstrument" value="${selectedPaymentInstruments && selectedPaymentInstruments.length ? selectedPaymentInstruments[0] : null}" scope="page" />
<isset name="selectedMethodId" value="${selectedPaymentInstrument && selectedPaymentInstrument.paymentMethod ? selectedPaymentInstrument.paymentMethod : pdict.selectedPaymentMethod}" scope="page" />
<isset name="effectiveSelectedMethodId" value="${selectedMethodId}" scope="page" />

<isif condition="${isStripePaymentElementEnabled && (empty(effectiveSelectedMethodId) || effectiveSelectedMethodId === 'CREDIT_CARD' || effectiveSelectedMethodId === 'PayPal' || effectiveSelectedMethodId === 'PAYPAL_CREDIT_CARD' || effectiveSelectedMethodId === 'Venmo')}">
    <isset name="effectiveSelectedMethodId" value="${'STRIPE_PAYMENT_ELEMENT'}" scope="page" />
</isif>

<isset name="payPalData" value="${pdict.paypal}" scope="page" />
<isset name="isPaypalCardFieldsEnabled" value="${payPalData && payPalData.isPayPalActive && payPalData.isPaypalCardFieldsEnabled}" scope="page" />
<isset name="isBasicCreditCardVisible" value="${!payPalData || !payPalData.isPayPalActive || !isPaypalCardFieldsEnabled}" scope="page" />

<isif condition="${pdict.CurrentHttpParameterMap.apm_return_error && pdict.CurrentHttpParameterMap.apm_return_error.stringValue}">
    <div class="alert alert-danger stripe-error-message" role="alert">
        <p class="error-message-text">${Resource.msg('apm.error.fail','stripe',null)}</p>
    </div>
</isif>

<div class="form-nav billing-nav payment-information js-payment-information wgaca-payment-tabs"
    data-payment-method-id="${!empty(effectiveSelectedMethodId) ? effectiveSelectedMethodId : pdict.selectedPaymentMethod}"
     data-is-new-payment="${pdict.customer.registeredUser && pdict.customer.customerPaymentInstruments.length ? false : true}"
>
    <isif condition="${!isCreditCardEnabled || !hasSavedCards}">
        <input type="hidden" name="cardNumber" value="" class="cardNumber" id="cardNumber">
        <div style="display:none;" id="new-card-form-container">
        </div>
    </isif>

    <ul class="nav nav-tabs nav-fill payment-options" role="tablist">
    
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsTabs" />
    </ul>
</div>
<div class="credit-card-selection-new" style="margin-top:-15px" >
    <div class="tab-content bg-white pb-3">
    
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsContent" />
    </div>
</div>

<iscomment> 

<div class="form-nav billing-nav payment-information js-payment-information"
     data-payment-method-id="PayPal"
     data-is-new-payment="${pdict.customer.registeredUser && pdict.customer.customerPaymentInstruments.length ? false : true}"
>
    <ul class="nav nav-tabs nav-fill payment-options" role="tablist">
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsTabs" />
    </ul>
</div>
<div class="credit-card-selection-new" >
    <div class="tab-content">
        <isinclude template="checkout/billing/paymentOptions/paymentOptionsContent" />
    </div>
</div> </iscomment>
