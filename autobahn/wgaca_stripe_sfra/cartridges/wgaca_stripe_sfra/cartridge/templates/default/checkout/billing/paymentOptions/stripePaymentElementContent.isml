<div class="tab-pane ${paymentOption.ID}-content <isif condition="${checkOption}">active show</isif>" id="${paymentOption.ID}-content" role="tabpanel" style="padding-left:30px;padding-right:30px">
    <fieldset class="payment-form-fields">
        <input type="hidden" class="form-control" name="${pdict.forms.billingForm.paymentMethod.htmlName}"
            value="${paymentOption.ID}">
        <input type="hidden" name="stripe_source_id" id="stripe_source_id">
        <div class="row">
            <div id="payment-element" style="width:100%" data-errormsg="${Resource.msg('apm.error.fail','stripe',null)}">
            </div>
        </div>
    </fieldset>
</div>
