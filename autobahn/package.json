{
    "name": "autobahn-build",
    "version": "4.1.2.2",
    "engines": {
        "node": "20.12.2"
    },
    "scripts": {
        "npmCI": "cd sfra-webpack-builder && npm ci && cd .. && node ./sfra-webpack-builder/installHandling/install.js --CI",
        "config:webpack": "node ./sfra-webpack-builder/webpackHandling/webpack.js --config ./sfra-webpack-builder/webpack.config.js --env local",
        "fonts:compile": "cd storefront-reference-architecture && npm run compile:fonts",
        "dev:build": "npm ci && npm run npmCI && npm run dev:compile",
        "dev:compile": "npm run fonts:compile && npm run config:webpack -- --env dev",
        "dev:compile:js": "npm run config:webpack -- --env dev --env noSCSS",
        "dev:compile:scss": "npm run fonts:compile && npm run config:webpack -- --env dev --env noJS",
        "prod:build": "npm run npmCI && npm run prod:compile",
        "prod:compile": "npm run fonts:compile && npm run config:webpack -- --env prd --env devtoolsourcemap",
        "prod:compile:js": "npm run config:webpack -- --env prd --env noSCSS --env devtoolsourcemap",
        "prod:compile:scss": "npm run fonts:compile && npm run config:webpack -- --env prd --env noJS",
        "watch:fast": "npm run dev:compile -- --watch",
        "watch": "npm run dev:compile -- --env devtoolsourcemap --watch",
        "data:import": "autobahn-cli import",
        "data:upload": "autobahn-cli upload",
        "data:import:base": "npm run data:import -- --config dw.js",
        "data:upload:base": "npm run data:upload -- --config dw.js",
        "data:clientkeys": "npm run data:import:base -- --data-dirs data/clientkeys",
        "data:clientmeta": "npm run data:import:base -- --data-dirs data/clientmeta",
        "data:clientsandbox": "npm run data:meta && npm run data:clientmeta && npm run data:initialize && npm run data:clientkeys && npm run data:clienttest",
        "data:clienttest": "npm run data:import:base -- --data-dirs data/clienttest",
        "data:devkeys": "npm run data:import:base -- --data-dirs data/devkeys",
        "data:devsandbox": "npm run data:meta && npm run data:initialize && npm run data:devkeys && npm run data:devtest",
        "data:devtest": "npm run data:import:base -- --data-dirs data/devtest && npm run data:ab",
        "data:devtest:nostatic": "npm run data:import:base -- --data-dirs data/devtest --data-ignore \"**/static/**\" && npm run data:ab",
        "data:initialize": "npm run data:import:base -- --data-dirs data/initialize",
        "data:initialize:accessroles": "npm run data:initialize -- --data-ignore \"**\" \"!access-roles.xml\"",
        "data:initialize:catalogs": "npm run data:initialize -- --data-ignore \"**\" \"!catalogs/**\"",
        "data:initialize:coupons": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/coupons.xml\"",
        "data:initialize:customerlists": "npm run data:initialize -- --data-ignore \"**\" \"!customer-lists/**\"",
        "data:initialize:instancepreferences": "npm run data:initialize -- --data-ignore \"**\" \"!preferences.xml\"",
        "data:initialize:inventorylists": "npm run data:initialize -- --data-ignore \"**\" \"!inventory-lists/**\"",
        "data:initialize:jobs": "npm run data:initialize -- --data-ignore \"**\" \"!jobs.xml\"",
        "data:initialize:library": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/library/library.xml\"",
        "data:initialize:librarystatic": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/library/static/**\"",
        "data:initialize:ocapisettings": "npm run data:initialize -- --data-ignore \"**\" \"!ocapi-settings/**\"",
        "data:initialize:pagemetatag": "npm run data:initialize -- --data-ignore \"**\" \"!pagemetatag.xml\"",
        "data:initialize:paymentmethods": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/payment-methods.xml\"",
        "data:initialize:paymentprocessors": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/payment-processors.xml\"",
        "data:initialize:pricebooks": "npm run data:initialize -- --data-ignore \"**\" \"!pricebooks/**\"",
        "data:initialize:promotions": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/promotions.xml\"",
        "data:initialize:services": "npm run data:initialize -- --data-ignore \"**\" \"!services.xml\"",
        "data:initialize:shipping": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/shipping.xml\"",
        "data:initialize:site": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/site.xml\"",
        "data:initialize:sitepreferences": "npm run data:initialize -- --data-ignore \"**\" \"!preferences.xml\"",
        "data:initialize:sourcecodes": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/sourcecodes.xml\"",
        "data:initialize:stores": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/stores.xml\"",
        "data:initialize:urlrules": "npm run data:initialize -- --data-ignore \"**\" \"!sites/*/url-rules.xml\"",
        "data:meta": "npm run data:import:base -- --data-dirs data/meta",
        "data:meta:sfra": "npm run data:meta -- --data-ignore \"**\" \"!sample_sfra_definitions/**\"",
        "postinstall": "cd sfra-webpack-builder && npm i && cd ../ && node ./sfra-webpack-builder/installHandling/install.js"
    },
    "dependencies": {
        "@red-van-workshop/autobahn-cli": "2.2.3",
        "sfcc-ci": "^2.11.0"
    },
    "sfraBuilderConfig": "./sfraBuilderConfig"
}
