<isif condition="${ dw.system.Site.getCurrent().getCustomPreferenceValue('flowEnabled') }">
    <script>
        !function (f, l, o, w, i, n, g) {
        f[i] = f[i] || {};f[i].cmd = f[i].cmd || function () {
        (f[i].q = f[i].q || []).push(arguments);};n = l.createElement(o);
        n.src = w;g = l.getElementsByTagName(o)[0];g.parentNode.insertBefore(n, g);
        }(window,document,'script','https://cdn.flow.io/flowjs/latest/flow.min.js','flow');

        flow.cmd('set', 'organization', '${ dw.system.Site.getCurrent().getCustomPreferenceValue('flowOrganizationId') }');
        <isif condition="${ !empty(pdict.sessionId) && pdict.sessionId != pdict.storedSessionId }">
            flow.cmd('set', 'sessionId', '${ pdict.sessionId }');
        </isif>
        flow.cmd('init');
    </script>
    <isif condition="${ dw.system.Site.getCurrent().getCustomPreferenceValue('flowUseCountryPicker') }">
        <script src="https://cdn.flow.io/country-picker/js/v0/country-picker.js"></script>
    </isif>
    <isinclude url="${ URLUtils.url('Flow-CheckExperienceJS') }" />
    <script defer="defer" src="${URLUtils.staticURL('/js/flow_sfcc.js')}"></script>
</isif>
