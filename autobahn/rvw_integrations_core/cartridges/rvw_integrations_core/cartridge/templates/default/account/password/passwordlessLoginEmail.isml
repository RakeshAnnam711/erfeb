<isinclude template="emails/header" />
    <isif condition="${pdict.firstName}">
        <h1>${Resource.msg('msg.passwordless.login.dear', 'login', null)}&nbsp;${pdict.firstName},</h1>
    </isif>

    <p>${Resource.msg('msg.passwordless.login.message1', 'login', null)}</p>

    <isif condition="${pdict.passwordlessToken}">
        <h1>${pdict.passwordlessToken}</h1>
    </isif>

    <p>${Resource.msg('msg.passwordless.login.message2', 'login', null)}</p>

<isinclude template="emails/footer" />
