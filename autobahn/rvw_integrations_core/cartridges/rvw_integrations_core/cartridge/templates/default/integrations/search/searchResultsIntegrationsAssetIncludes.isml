<iscomment>
    This is the overriding template for integration specific code, please ensure where appropriate to check
    the global toggle for the integration you are adding to this page to ensure that only the active integrations get included and executed

    Page Type: Search Results Page

    It gets called by rvw_autobahn_core:templates/default/search/searchResults.isml
</iscomment>
<isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('PP_ShowCreditFinancialBanners')}">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/paypalCreditFinancingOptions.js');
        assets.addCss('/css/paypalCreditFinancingOptions.css');
    </isscript>
</isif>
