<iscomment>
    This is the overriding template for integration specific code, please ensure where appropriate to check
    the global toggle for the integration you are adding to this page to ensure that only the active integrations get included and executed

    Page Type: Cart

    It gets called by rvw_autobahn_core:templates/default/cart/productCard/cartProductCard.isml

</iscomment>
<isset name="currentSite" value="${dw.system.Site.getCurrent()}" scope="page"/>

<isif condition="${currentSite.getCustomPreferenceValue('bopisCartridgeEnabled')}">
    <isset name="storeHelper" value="${require('*/cartridge/scripts/helpers/storeHelpers')}" scope="page"/>

    <isif condition="${lineItem.fromStoreId}">
        <div class="line-item-store">
            <span class="line-item-name">${Resource.msg('label.instore.pickup.from','instorePickup',null)}</span>

            <isset name="store" value="${storeHelper.getStoreById(lineItem.fromStoreId)}" scope="page"/>
            <isinclude template="storeLocator/storeDetails" />
        </div>
    </isif>
</isif>
