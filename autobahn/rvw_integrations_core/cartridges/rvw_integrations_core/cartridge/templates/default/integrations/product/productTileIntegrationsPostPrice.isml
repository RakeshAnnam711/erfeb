<iscomment>
    This is the overriding template for integration specific code, please ensure where appropriate to check
    the global toggle for the integration you are adding to this page to ensure that only the active integrations get included and executed

    It gets called by rvw_autobahn_core:templates/default/product/productTile.isml

</iscomment>
<isset name="paypalCalculatedCost" value="${product.price.type === 'range' ? dw.value.Money(product.price.min.sales.value, product.price.min.sales.currency) : dw.value.Money(product.price.sales.value, product.price.sales.currency)}" scope="page"/>
<isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('PP_ShowCreditFinancialBanners') && paypalCalculatedCost && paypalCalculatedCost.isAvailable()}">
    <isinclude template="paypalCreditFinancingOptions/lowerCostPerMonth"/>
</isif>
