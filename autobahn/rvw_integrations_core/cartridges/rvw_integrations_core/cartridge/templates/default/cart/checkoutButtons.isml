<div class="mb-1 mb-sm-3">
    <a href="${URLUtils.https('Checkout-Begin')}"
        class="btn btn-primary btn-block checkout-btn ${pdict.valid.error ? 'disabled' : ''}" role="button" data-price="${pdict.totals.grandTotal}" cypress-target="beginCheckoutButton">
        ${Resource.msg('button.checkout', 'cart', null)}
    </a>
</div>
