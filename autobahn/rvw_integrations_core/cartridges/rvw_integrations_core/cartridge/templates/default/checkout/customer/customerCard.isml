<iscomment>
    This overwrites what is in rvw_autobahn_core.

    The reason for the duplication is because there are attribute level configurations that are integration specific,
    that couldn't be broken out into its own template

    Any change made here needs may also need to be reflected in the corresponding file in rvw_autobahn_core
</iscomment>
<div class="card-body">
    <form autocomplete="on" id="guest-customer" class="guest-form" method="POST" action="${URLUtils.url('CheckoutServices-SubmitCustomer')}"
        <isprint value=${pdict.forms.guestCustomerForm.attributes} encoding="off" /> novalidate>
        <fieldset class="customer-information-block">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group required">
                        <label class="form-control-label" for="email-guest">
                            ${Resource.msg('field.customer.email','checkout',null)}
                        </label>
                        <input autofocus type="email" class="form-control email ${pdict.forms.guestCustomerForm.email.valid ? '' : 'is-invalid'}" id="email-guest"
                                    value="${(pdict.customer.profile && pdict.customer.profile.email) ? pdict.customer.profile.email : pdict.order.orderEmail}" <isprint value=${pdict.forms.guestCustomerForm.email.attributesNoPattern} encoding="off"/>
                                    aria-describedby="guestEmailInvalidMessage"
                                    cypress-target="emailGuestField">
                            <div class="invalid-feedback" id="guestEmailInvalidMessage">
                                <isif condition="${!pdict.forms.guestCustomerForm.email.valid}">
                                    ${Resource.msg('error.message.required', 'forms', null)}
                                </isif>
                            </div>
                    </div>
                </div>
            </div>
             <strong>${Resource.msg('msg.guest.customer.exists', 'checkout', null)} <button type="button" class="btn btn-link js-login-customer">${Resource.msg('action.customer.login', 'checkout', null)}</button></strong>
        </fieldset>
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}"/>
        <input type="text" class="d-none" name="StackOverflow1370021" value="Don't submit single input form with enter key">

        <isif condition="${dw.system.Site.current.getCustomPreferenceValue('MarketingCloudForNewsletterEnabled')}">
            <div class="form-group custom-control custom-checkbox">
                <isinclude template="account/components/newsletterOptIn" />
            </div>
        </isif>
        <isif condition="${dw.system.Site.current.getCustomPreferenceValue('klaviyo_enabled')}">
            <div class="form-group custom-control custom-checkbox">
                <isinclude template="klaviyo/subscribeCheckbox" />
            </div>
        </isif>
    </form>
    <form autocomplete="on" id="registered-customer" method="POST" class="registered-form d-none" action="${URLUtils.url('CheckoutServices-LoginCustomer')}"
        <isprint value=${pdict.forms.registeredCustomerForm.attributes} encoding="off" /> novalidate>
        <fieldset class="customer-information-block">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group required">
                        <label class="form-control-label" for="email">
                            ${Resource.msg('field.customer.email','checkout',null)}
                        </label>
                        <input type="email" class="form-control email" id="email"
                            value="${(pdict.customer.profile && pdict.customer.profile.email) ? pdict.customer.profile.email : pdict.order.orderEmail}" <isprint value=${pdict.forms.registeredCustomerForm.email.attributesNoPattern} encoding="off"/>
                            aria-describedby="emailInvalidMessage" >
                        <div class="invalid-feedback" id="emailInvalidMessage"></div>
                    </div>
                    <div class="form-group password-form">
                        <label class="form-control-label" for="password">
                            ${Resource.msg('field.customer.password','checkout',null)}
                        </label>
                        <input type="password" class="form-control password" id="password"
                                    <isprint value=${pdict.forms.registeredCustomerForm.password.attributes} encoding="off"/>
                                    aria-describedby="passwordInvalidMessage" >
                        <div class="invalid-feedback" id="passwordInvalidMessage"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                    <div class="col-12">
                        <button class="btn btn-primary btn-block submit-customer-login" type="submit" name="submit" value="submit-login">
                            ${Resource.msg('button.customer.login', 'checkout', null)}
                        </button>

                        <isif condition="${dw.system.Site.current.getCustomPreferenceValue('enablePasswordlessLogin')}">

                            <span class="sr-only">${Resource.msg('label.or', 'common', 'Or')}</span>
                            <isinclude template="checkout/customer/passwordlessLoginButtonCheckout" />
                        </isif>

                        <button class="btn btn-light btn-block js-cancel-login" name="submit" value="cancel-login">
                            ${Resource.msg('button.customer.login.cancel', 'checkout', null)}
                        </button>
                    </div>
                </div>
        </fieldset>
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}"/>
    </form>

    <isif condition="${dw.system.Site.current.getCustomPreferenceValue('enablePasswordlessLogin')}">

        <isinclude template="account/password/requestPasswordlessLoginModal" />
    </isif>
</div>
