<isinclude template="emails/header" />
    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;">
            <tr>
                <td style="background-color: #FFFFFF; border-bottom: 1px solid #BEBEBE;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #222222;">
                                <h1 style="margin: 0 0 10px; font-size: 25px; line-height: 30px; color: #222222; font-weight: normal;">${Resource.msg('msg.placed.order.update', 'order', null)}</h1>
                            </td>
                            <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #222222; text-align: right;">
                                <p>
                                    <strong>${Resource.msg('label.order.number', 'confirmation', null)}</strong>
                                    <br />
                                    <span>${pdict.order.orderNumber}</span>
                                </p>
                                <p>
                                    <strong>${Resource.msg('label.order.date', 'confirmation', null)}</strong>
                                    <br />
                                    <span><isprint value="${pdict.order.creationDate}" style="DATE_LONG" /></span>
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td style="background-color: #FFFFFF">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td style="padding: 20px 20px 20px; vertical-align: top;">
                                <!--- Shipping Address --->
                                <isloop items="${pdict.order.shipping}" var="shippingModel" status="shippingLoop">
                                    <isinclude template="checkout/confirmation/shippingTitle"/>
                                    <isset name="address" value="${shippingModel.shippingAddress}" scope="page"/>
                                    <isinclude template="checkout/addressSummary" />
                                    <p style="margin: 0 0 10px;">
                                        <strong>${Resource.msg('label.order.shipping.method', 'confirmation', null)}</strong>
                                        <br/>
                                        ${shippingModel.selectedShippingMethod.displayName}
                                        <isif condition="${shippingModel.selectedShippingMethod.estimatedArrivalTime}">
                                            (${shippingModel.selectedShippingMethod.estimatedArrivalTime})
                                        </isif>
                                    </p>

                                    <isif condition="${shippingModel.isGift}">
                                        <p style="margin: 0 0 10px;">
                                            <strong>
                                                ${Resource.msg('heading.gift.message', 'checkout', null)}
                                            </strong>
                                            ${shippingModel.giftMessage}
                                        </p>
                                    </isif>

                                    <isif condition="${pdict.order.shipping.length > 1}">
                                        <strong>${Resource.msg('label.order.products', 'confirmation', null)}:</strong> <br/>
                                        <isloop items="${shippingModel.productLineItems.items}" var="lineItem">
                                            <p style="margin: 0 0 10px;">
                                                ${Resource.msg('label.order.product.name', 'confirmation', null)}: ${lineItem.productName}
                                                <br/>

                                                <isif condition="${lineItem.productType === 'bundle'}">
                                                    <isloop items="${lineItem.bundledProductLineItems}" var="bundledLineItem">
                                                        ${Resource.msg('label.order.bundled.item.name', 'confirmation', null)}: ${bundledLineItem.productName}
                                                            <br/>
                                                            <isloop items="${bundledLineItem.variationAttributes}" var="attribute">
                                                                ${attribute.displayName}: ${attribute.displayValue}
                                                                <br/>
                                                            </isloop>
                                                    </isloop>
                                                <iselse/>
                                                    <isloop items="${lineItem.variationAttributes}" var="attribute">
                                                        ${attribute.displayName}: ${attribute.displayValue}
                                                        <br/>
                                                    </isloop>
                                                </isif>

                                                <!--- quantity --->
                                                ${Resource.msg('field.selectquantity','cart',null)}
                                                - <isprint value="${lineItem.quantity}" formatter="##" />
                                                <br/>
                                            </p>
                                        </isloop>
                                    </isif>
                                </isloop>
                            </td>
                            <td style="padding: 20px 20px 20px; vertical-align: top;">
                                <!--- Billing Address --->
                                <strong>${Resource.msg('label.order.billing.address', 'confirmation', null)}</strong>
                                <br/>
                                <isset name="address" value="${pdict.order.billing.billingAddress.address}" scope="page"/>
                                <isinclude template="checkout/addressSummary" />
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 20px 20px 20px;">
                                <isif condition="${pdict.order.shipping.length === 1}">
                                    <strong>${Resource.msg('label.order.products', 'confirmation', null)}:</strong> <br />
                                    <isloop items="${pdict.order.items.items}" var="lineItem">
                                        <p style="margin: 0 0 10px;">
                                            ${Resource.msg('label.order.product.name', 'confirmation', null)}: ${lineItem.productName}
                                            <br />
                                            <isif condition="${lineItem.productType === 'bundle'}">
                                                <isloop items="${lineItem.bundledProductLineItems}" var="bundledLineItem">
                                                    ${Resource.msg('label.order.bundled.item.name', 'confirmation', null)}:
                                                    ${bundledLineItem.productName}
                                                    <br />
                                                    <isloop items="${bundledLineItem.variationAttributes}" var="attribute">
                                                        ${attribute.displayName}: ${attribute.displayValue}
                                                        <br />
                                                    </isloop>
                                                </isloop>
                                            <iselse/>
                                                <isloop items="${lineItem.variationAttributes}" var="attribute">
                                                    ${attribute.displayName}: ${attribute.displayValue}
                                                    <br />
                                                </isloop>
                                            </isif>
                                            <isif condition="${lineItem.bonusProductLineItemUUID === 'bonus'}">
                                                <isloop items="${lineItem.bonusProducts}" var="bonusProduct" status="loopState">
                                                    <isif condition="${loopState.first}">
                                                        <br />
                                                        ${Resource.msg('text.lineitem.bonus.msg', 'cart', null)}
                                                    </isif>
                                                    ${bonusProduct.productName}
                                                    <isloop items="${bonusProduct.variationAttributes}" var="attribute">
                                                        ${attribute.displayName}: ${attribute.displayValue}
                                                        <br />
                                                    </isloop>
                                                    <!--- quantity --->
                                                    ${Resource.msg('field.selectquantity', 'cart', null)}
                                                    -
                                                    <isprint value="${bonusProduct.quantity}" formatter="##" />
                                                    <br />
                                                    <isif condition="${loopState.last}">
                                                        <br />
                                                    </isif>
                                                </isloop>
                                            </isif>

                                            <!--- quantity --->
                                            ${Resource.msg('field.selectquantity', 'cart', null)}
                                            -
                                            <isprint value="${!empty(lineItem.customQuantityOrdered) ? lineItem.customQuantityOrdered : lineItem.quantity}" formatter="##" />
                                            <br />

                                            <isif condition="${!empty(lineItem.customQuantityCanceled) && lineItem.customQuantityCanceled > 0}">
                                                <!--- quantityCanceled --->
                                                ${Resource.msg('field.selectquantitycanceled', 'cart', null)}
                                                -
                                                <isprint value="${lineItem.customQuantityCanceled}" formatter="##" />
                                                <br />
                                            </isif>

                                            <isif condition="${!empty(lineItem.customQuantityReturned) && lineItem.customQuantityReturned > 0}">
                                                <!--- quantityReturned --->
                                                ${Resource.msg('field.selectquantityreturned', 'cart', null)}
                                                -
                                                <isprint value="${lineItem.customQuantityReturned}" formatter="##" />
                                                <br />
                                            </isif>

                                            <!-- custom line item status value -->
                                            <isif condition="${'customStatus' in lineItem && !empty(lineItem.customStatus)}">
                                                <br />
                                                <strong>${Resource.msg('label.status', 'order', null)}</strong>
                                                - ${Resource.msg('status.' + lineItem.customStatus, 'order', null)}
                                            </isif>

                                            <!-- custom line item status value -->
                                            <isif condition="${pdict.showTrackingInformation && 'customTracking' in lineItem && !empty(lineItem.customTracking)}">
                                                <br />
                                                <isinclude template="integrations/checkout/orderProductSummary/tracking">
                                            </isif>

                                            <br />
                                        </p>
                                    </isloop>
                                </isif>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
    </table>

<isinclude template="emails/footer" />
