				"@type-id": "custom.amazon.exportDeltaProduct",
				"@supports-site-context": "true",
                "@supports-organization-context": "false",
				"description": "Exports Delta product to Amazon API",
				"module": "bc_job_components/cartridge/scripts/jobsteps/exportProductToAmazonDelta.js",
				"function": "exportProductToAmazonDelta",
				"parameters": {
                    "parameter": [
                        {
                            "@name": "MasterCatalogID",
                            "@type": "string",
                            "@required": "true",
                            "description": "ID of the Master Catalog."
                        },
                        {
                            "@name": "StorefrontCatalogID",
                            "@type": "string",
                            "@required": "true",
                            "description": "ID of the Strefront Catalog."
                        },
                        {
                            "@name": "InventoryID",
                            "@type": "string",
                            "@required": "true",
                            "description": "ID of the Inventory."
                        },
                        {
                            "@name": "StandardPriceBookID",
                            "@type": "string",
                            "@required": "true",
                            "description": "ID of the Standard Price Book."
                        },
                        {
                            "@name": "DiscountPriceBookID",
                            "@type": "string",
                            "@required": "true",
                            "description": "ID of the Discount Price Book."
                        },
                        {
                            "@name": "SnapshotRefreshDays",
                            "@type": "string",
                            "@required": "true",
                            "description": "Number of days after which the snapshot should be refreshed. Set to 0 to refresh snapshot on every execution."
                          },
                          {
                            "@name": "BucketCount",
                            "@type": "string",
                            "@required": "false",
                            "description": "Number of buckets to split the export into."
                          }
					]
				},
				"status-codes": {
					"status": [{
						"@code": "ERROR",
						"description": "Used when an error occurred."
					},
					{
						"@code": "OK",
						"description": "Used when everything went well."
					}]
				}
			},
            {
				"@type-id": "custom.amazon.updateAmazonProductExportFlag",
				"@supports-site-context": "true",
                "@supports-organization-context": "false",
				"description": "Update AmazonProductExport Flag based on Quantity provided by Llama. if product has zero quantity from last 60 days, will set the flag false",
				"module": "bc_job_components/cartridge/scripts/jobsteps/updateAmazonProductExportFlag.js",
				"function": "updateAmazonProductExportFlag",
				"parameters": {
					"parameter": [
                        {
                            "@name": "InventoryDataType",
                            "@type": "string",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Inventory Data Type",
                            "default-value": "delta"
                        }
					]
				},
				"status-codes": {
					"status": [{
						"@code": "ERROR",
						"description": "Error occurred by Updating AmazonProductExport Flag"
					},
					{
						"@code": "OK",
						"description": "Successfully updated AmazonProductExport Flag."
					}]
				}
