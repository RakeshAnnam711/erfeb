{
    "step-types": {
        "script-module-step": [
            {
                "@type-id": "custom.CSComponents.MoveFiles",
                "module": "bc_job_components/cartridge/scripts/jobsteps/MoveFiles.js",
                "description": "Copy or move files from one directory to another.",
                "function": "Run",
                "parameters": {
                    "parameter": [{
                            "@name": "FilePattern",
                            "description": "File pattern (Regular Expression)",
                            "@type": "string",
                            "@required": "false",
                            "@trim": "true"
                        },
                        {
                            "@name": "SourceFolder",
                            "@type": "string",
                            "@required": "true",
                            "@trim": "true",
                            "description": "Source folder path",
                            "default-value": "IMPEX/src/mySourceFolder"
                        },
                        {
                            "@name": "TargetFolder",
                            "@type": "string",
                            "@required": "true",
                            "@trim": "true",
                            "description": "Target folder path",
                            "default-value": "IMPEX/src/myTargetFolder"
                        },
                        {
                            "@name": "CopyOnly",
                            "@type": "boolean",
                            "@required": "false",
                            "description": "If NOT checked, source files will be DELETED. Use with care!",
                            "default-value": "true"
                        },
                        {
                            "@name": "Recursive",
                            "@type": "boolean",
                            "@required": "false",
                            "description": "When checked, the operation will include subfolders.",
                            "default-value": "false"
                        },
                        {
                            "@name": "Overwrite",
                            "@type": "boolean",
                            "@required": "false",
                            "description": "If checked, existing files in target folder will be overwritten.",
                            "default-value": "false"
                        },
                        {
                            "@name": "NoFileFoundStatus",
                            "@type": "string",
                            "@required": true,
                            "@trim": true,
                            "enum-values": {
                                "value": [
                                    "OK",
                                    "ERROR"
                                ]
                            },
                            "description": "No files found exit code"
                        },
                        {
                            "@name": "IsDisabled",
                            "description": "Mark the step as disabled. This will skip the step and returns a OK status",
                            "@type": "boolean",
                            "@required": false,
                            "@trim": true
                        }
                    ]
                },
                "status-codes": {
                    "status": [{
                            "@code": "ERROR",
                            "description": "Used when an error occurred."
                        },
                        {
                            "@code": "OK",
                            "description": "Used when execution was successful."
                        },
                        {
                            "@code": "NO_FILE_FOUND",
                            "description": "Used when no file could be found in the source directory."
                        }
                    ]
                }
            },
            {
                "@type-id":"custom.Feedonomics.FtpUpload",
                "description":"Upload files to an (S)FTP server",
                "module":"int_feedonomics/cartridge/scripts/jobsteps/ftpUpload.js",
                "function":"Upload",
                "parameters": {
                    "parameters": [{
                            "@name":"ServiceID",
                            "@type":"string",
                            "@required":"true",
                            "@trim":"true",
                            "default-value":"feedonomics.ftp"
                        },
                        {
                            "@name":"FilePattern",
                            "@type":"string",
                            "@required":"false",
                            "description":"File pattern (Regular Expression)",
                            "@trim":"true",
                            "default-value":".*\\.csv"
                        },
                        {
                            "@name":"SourceFolder",
                            "@type":"string",
                            "@required":"true",
                            "@trim":"true",
                            "description":"Local folder with files, relative to IMPEX/",
                            "default-value":"src/feedonomics/catalog"
                        },
                        {
                            "@name":"TargetFolder",
                            "@type":"string",
                            "@required":"true",
                            "description":"Remote folder on Server, relative to home directory",
                            "@trim":"true"
                        },
                        {
                            "@name":"ArchiveFolder",
                            "@type":"string",
                            "@required":"false",
                            "description":"Local folder where to archive files, relative to IMPEX/",
                            "@trim":"true",
                            "default-value":"src/archive/feedonomics"
                        },
                        {
                            "@name":"IsDisabled",
                            "description":"Mark the step as disabled. This will skip the step and returns a OK status",
                            "@type":"boolean",
                            "@required":"false",
                            "@trim":"true",
                            "default-value":"false"
                        }
                    ]
                },
                "status-codes": {
                    "status": [{
                            "@code":"ERROR",
                            "description":"Used when an error occurred."
                        },
                        {
                            "@code":"OK",
                            "description":"Used when everything went well."
                        }
                    ]
                }
            },
			{
				"@type-id": "custom.amazon.exportproduct",
				"@supports-site-context": "true",
                "@supports-organization-context": "false",
