                "module": "bc_job_components/cartridge/scripts/jobsteps/ZipFiles.js",
                "function": "Run",
                "parameters": {
                    "parameters": [
                        {
                            "@name": "SourceFolder",
                            "@type": "string",
                            "@required": true,
                            "@trim": true,
                            "description": "Local folder where to find files, relative to IMPEX/"
                        },
                        {
                            "@name": "FilePattern",
