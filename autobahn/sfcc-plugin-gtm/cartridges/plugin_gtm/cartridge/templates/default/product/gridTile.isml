<isset name="showQuickView" value="${true}" scope="page" />
<isset name="product" value="${pdict.product}" scope="page" />
<iscomment> 'product.gtmData' formatted as 'product.gtmGA4Data' </iscomment>
<div class="product"
    data-pid="${product.id}"
    data-gtmdata="${JSON.stringify(product.gtmData)}"
    <isinclude template="product/productTile" />
</div>
