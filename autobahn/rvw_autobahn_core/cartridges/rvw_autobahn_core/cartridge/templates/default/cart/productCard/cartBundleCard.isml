<div class="card">
    <div class="card-body product-info uuid-${lineItem.UUID}">
        <!--- name and remove buttons --->
        <isif condition="${!lineItem.isBonusProductLineItem}">
            <isinclude template="integrations/cart/productCard/cartBundleCard/deleteButton" />
        </isif>

        <div class="row ">
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-lg-12 d-flex flex-row">
                        <a class="item-image" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                            <img class="product-image" src="${lineItem.images.small[0].url}" alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}" loading="lazy" width="150" height="200">
                        </a>
                        <div class="item-attributes d-flex flex-column">
                            <isinclude template="cart/productCard/cartProductCardHeader" />
                            <isloop items="${lineItem.options}" var="option">
                                <isif condition="${!!option}">
                                    <div class="lineItem-options-values" data-option-id="${option.optionID}" data-value-id="${option.optionValueID}">
                                        <p class="line-item-attributes">${option.lineItemText}</p>
                                    </div>
                                </isif>
                            </isloop>
                            <div class="line-item-availability availability-${lineItem.UUID}">
                                <isloop items="${lineItem.availability.messages}" var="message">
                                    <p>${message}</p>
                                </isloop>
                                <isif condition="${lineItem.availability.inStockDate}">
                                    <div class="line-item-instock-date">
                                        <p>${lineItem.availability.inStockDate}</p>
                                    </div>
                                </isif>
                            </div>

                            <isif condition="${!lineItem.isBonusProductLineItem}">
                                <isinclude template="cart/productCard/cartProductCardEdit" />
                            </isif>
                        </div>
                    </div>
                    <isinclude template="integrations/cart/productCard/cartBundleCard/additionalInfo"/>
                </div>
            </div>

            <isif condition="${!lineItem.isBonusProductLineItem}">
                <div class="col-12 d-lg-none"><hr class="line-item-divider"></div>
            </isif>

            <isinclude template="cart/productCard/cartProductCardProductPrice" />

        </div>
        <div class="bundle-includes py-2">
            <span>${lineItem.productName}</span>
            ${Resource.msg('msg.bundle.includes','cart',null)}
        </div>

        <!--- individual bundled line items --->
        <isinclude template="cart/productCard/cartProductCardBundledItems" />

    </div>
</div>
