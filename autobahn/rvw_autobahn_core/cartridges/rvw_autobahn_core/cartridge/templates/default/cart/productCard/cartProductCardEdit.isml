<!--- Edit product --->
<isset name="isGiftCertificateLineItem" value="${lineItem.productType === 'giftCertificate'}" scope="page"/>
<div class="product-edit">
    <a href="${URLUtils.url(isGiftCertificateLineItem ? 'Cart-EditGiftCertificateLineItem' : 'Cart-GetProduct', 'uuid', lineItem.UUID)}" class="edit ${isGiftCertificateLineItem ? 'editGiftCertificateLineItem' : 'quickview'}"
        data-toggle="modal" data-target="${isGiftCertificateLineItem ? '#editGiftCertificateLineItemModal' : '#quickViewModal'}"
        data-uuid="${lineItem.UUID}"
       aria-label="${Resource.msgf('text.edit.line.item','cart', null, lineItem.productName)}"
       title="${Resource.msg('link.edit.item', 'cart',null)}">
           ${Resource.msg('link.edit.item', 'cart', null)}
    </a>

    <iswishlisticon
        extraclass="move"
        nextaction="${URLUtils.url('Cart-RemoveProductLineItem')}"
        wishlistpid="${lineItem.id}"
        productname="${lineItem.productName}"
        uuid="${lineItem.UUID}"
        addmessage="${Resource.msg('link.move.to.wishlist', 'wishlist', null)}"
        removemessage="${Resource.msg('link.remove.from.wishlist', 'wishlist', null)}"
        includeicon="true"
        includetext="true"
        isinwishlist="${lineItem.isInWishlist}"
        gtmdata="${JSON.stringify(lineItem.gtmData)}"
    />
</div>
