<div class="product-line-item-details d-flex flex-row">
    <a class="item-image" href="${URLUtils.url('Product-Show', 'pid', nestedLineItem.id)}">
        <img class="product-image"
            src="${nestedLineItem.images[miniCart ? 'minicart' : 'cart'][0].url}"
            alt="${nestedLineItem.images[miniCart ? 'minicart' : 'cart'][0].alt}"
            title="${nestedLineItem.images[miniCart ? 'minicart' : 'cart'][0].title}"
            onerror="this.onerror=null;this.src='${URLUtils.staticURL('/images/noimage-small.png')}'"
        />
    </a>
    <div class="item-attributes">
        <div class="line-item-header">
            <div class="line-item-name" title="${nestedLineItem.productName}">${nestedLineItem.productName}</div>
        </div>

        <isloop items="${nestedLineItem.variationAttributes}" var="attribute">
            <p class="line-item-attributes">${attribute.displayName}: ${attribute.displayValue}</p>
        </isloop>

        <div class="item-options">
            <isloop items="${nestedLineItem.options}" var="option">
                <div class="line-item-option">${option.displayName}</div>
            </isloop>
        </div>
    </div>
</div>
<div class="row align-items-start item-price-qty">
    <!--- item price --->
    <isif condition="${lineItem.price}">
        <div class="col line-item-unit-price">
            <div class="line-item-pricing-info">
                <span class="line-item-total-text unit-price-label">
                    ${Resource.msg('label.each.item.price','cart',null)}
                </span><br/>
                <div class="price">
                    <span>
                        <span class="sales">
                            <span class="value">${nestedLineItem.bonusUnitPrice}</span>
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </isif>
    <!--- quantity --->
    <div class="col line-item-quantity justify-content-center flex">
        <div class="line-item-pricing-info">
            <span class="line-item-total-text qty-card-quantity-label">
                ${Resource.msg('field.selectquantity','cart',null)}
            </span><br/>
            <span class="pricing qty-card-quantity-count"><isprint value="${nestedLineItem.quantity}" formatter="##" /></span>
        </div>
    </div>
    <!--- line item total price --->
    <div class="col line-item-total-price justify-content-end">
        <div class="line-item-pricing-info">
            <span class="line-item-total-text line-item-total-price-label">
                ${Resource.msg('label.total.price','cart',null)}
            </span>
        </div>
        <div class="item-total-${nestedLineItem.UUID} price">
            <div class="pricing line-item-total-price-amount item-total-${nestedLineItem.UUID}">${nestedLineItem.priceTotal.price}</div>
        </div>
    </div>
</div>
<isif condition="${nestedLineItem.productType === 'bundle'}">
    <isset name="lineItem" value="${nestedLineItem}" scope="page" />
    <div class="bundled-items row">
        <div class="col line-item-header">
            <isinclude template="checkout/productCard/productCardProductName" />
        </div>
        <div class="col bundle-includes">${Resource.msg('msg.bundle.includes','cart',null)}</div>
    </div>
    <!--- individual bundled line items --->
    <isinclude template="cart/productCard/cartProductCardBundledItems" />
</isif>