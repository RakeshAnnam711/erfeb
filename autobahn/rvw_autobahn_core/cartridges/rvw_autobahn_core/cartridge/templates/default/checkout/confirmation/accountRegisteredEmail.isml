<isinclude template="emails/header" />
<table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;">
    <tr>
        <td style="background-color: #FFFFFF;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #222222;">
                        <h1 style="margin: 0 0 10px; font-size: 25px; line-height: 30px; color: #222222; font-weight: normal;">
                            ${Resource.msg('email.msg.new.registration.dear', 'registration', null)}&nbsp;${pdict.firstName}&nbsp;${pdict.lastName},
                        </h1>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td style="background-color: #FFFFFF">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="padding: 20px 20px 20px;">
                        <isif condition="${!empty(pdict.emailAssets['emailAccountRegisterTop'])}">
                            <isprint value="${pdict.emailAssets['emailAccountRegisterTop']}" encoding="off" />
                        </isif>
                        <p style="margin: 0 0 10px;"><a href="${pdict.url}">${pdict.url}</a></p>
                        <isif condition="${!empty(pdict.emailAssets['emailAccountRegisterBottom'])}">
                            <isprint value="${pdict.emailAssets['emailAccountRegisterBottom']}" encoding="off" />
                        </isif>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<isinclude template="emails/footer" />