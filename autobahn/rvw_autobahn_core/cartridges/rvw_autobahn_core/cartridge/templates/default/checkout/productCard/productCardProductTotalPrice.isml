<div class="strike-through
<isif condition=${!lineItem.priceTotal.nonAdjustedPrice}>non-adjusted-price</isif>"
>
    ${lineItem.priceTotal.nonAdjustedPrice}
</div>
<div data-value="${lineItem.priceTotal.priceValue}" class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">${lineItem.priceTotal.price}</div>
