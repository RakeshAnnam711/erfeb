<isinclude template="emails/header" />
<table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;" class="email-container">
    <!-- 1 Column Text -->
    <tr>
        <td style="background-color: #FFFFFF;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #222222;">
                        <h1 style="margin: 0 0 10px; font-size: 25px; line-height: 30px; color: #222222; font-weight: normal;">
                            ${Resource.msg('msg.contact.us.header', 'contactUs', null)}
                        </h1>
                        <p style="margin: 0 0 10px;">
                            <strong>${Resource.msg('label.contact.name', 'contactUs', null)}</strong> <br />${pdict.firstName}&nbsp;${pdict.lastName}
                        </p>
                        <p style="margin: 0 0 10px;">
                            <strong>${Resource.msg('label.contact.email', 'contactUs', null)}</strong>
                            <br />${pdict.email}
                        </p>
                        <p style="margin: 0 0 10px;">
                            <strong>${Resource.msg('label.contact.topic', 'contactUs', null)}</strong>
                            <br />${pdict.topic}
                        </p>
                        <p style="margin: 0 0 10px;">
                            <strong>${Resource.msg('label.contact.comment', 'contactUs', null)}</strong>
                            <br />${pdict.comment}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- 1 Column Text + Button : END -->
</table>
<isinclude template="emails/footer" />