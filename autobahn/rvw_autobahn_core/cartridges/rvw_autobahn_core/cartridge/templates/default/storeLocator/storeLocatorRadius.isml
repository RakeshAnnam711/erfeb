<label for="radius-${idUUID}">${Resource.msg('field.radius','storeLocator',null)}</label>
<select class="form-control custom-select radius" id="radius-${idUUID}" name="radius" data-action-url="${pdict.stores.actionUrl}">
    <isloop items="${pdict.stores.radiusOptions}" var="option" status="loopStatus">
        <option ${loopStatus.first ? 'selected="selected"' : ''}>${StringUtils.formatInteger(option)}</option>
    </isloop>
</select>
