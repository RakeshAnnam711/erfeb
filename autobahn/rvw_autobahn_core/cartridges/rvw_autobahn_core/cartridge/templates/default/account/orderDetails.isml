<isdecorate template="common/layout/page">

    <isinclude template="/components/modules" sf-toolkit="off" />

    <div class="container account-page receipt ${pdict.order.shipping.length > 1 ? 'multi-ship' : ''}">

        <iscontentasset aid="accountHeaderOrderDetail"/>

        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
        <div class="row justify-content-center">
            <div class="col-12">
                <isinclude template="checkout/confirmation/confirmationDetails" />
                <div class="row col-md-6 col-12 mx-auto">
                    <div class="my-account mb-3 col-lg-8 col-12 mx-auto">
                        <a class="btn btn-primary btn-block" href="${URLUtils.url('Search-Show', 'cgid', 'new-arrivals')}" title="${Resource.msg('link.continue.shopping','cart',null)}" aria-label="${Resource.msg('link.continue.shopping','cart',null)}" role="button" aria-pressed="true">
                            ${Resource.msg('link.continue.shopping','cart',null)}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
