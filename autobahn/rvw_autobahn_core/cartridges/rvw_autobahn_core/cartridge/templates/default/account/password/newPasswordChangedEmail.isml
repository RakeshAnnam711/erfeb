<isinclude template="emails/header" />
    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;">
            <!-- 1 Column Text + Button : BEGIN -->
            <tr>
                <td style="background-color: #ffffff;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #555555;">
                                <h1 style="margin: 0 0 10px; font-size: 25px; line-height: 30px; color: #333333; font-weight: normal;">
                                    ${Resource.msg('msg.passwordemail.dear', 'login', null)}&nbsp;${pdict.firstName}&nbsp;${pdict.lastName},
                                </h1>
                                <isif condition="${!empty(pdict.emailAssets['emailPasswordChangedTop'])}">
                                    <isprint value="${pdict.emailAssets['emailPasswordChangedTop']}" encoding="off" />
                                </isif>
                                <p style="margin: 0 0 10px;"><a href="${pdict.url}">${pdict.url}</a></p>

                                <isif condition="${!empty(pdict.emailAssets['emailPasswordChangedBottom'])}">
                                    <isprint value="${pdict.emailAssets['emailPasswordChangedBottom']}" encoding="off" />
                                </isif>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <!-- 1 Column Text + Button : END -->
    </table>
<isinclude template="emails/footer" />
