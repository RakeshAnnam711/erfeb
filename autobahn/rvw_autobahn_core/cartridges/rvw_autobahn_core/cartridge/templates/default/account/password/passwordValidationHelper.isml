<isset name="passwordConstraints" value="${pdict.passwordConstraints}" scope="page"/>
<div class="validator-container">
    <p>${Resource.msg('helper.message.passwordRequirements', 'forms', null)}</p>
    <ul class="password-validation-helper">
        <li data-val-regex="^.{${Resource.msg('requirement.message.length', 'forms', new Number(passwordConstraints.minLength))}}">${Resource.msgf('helper.message.length', 'forms', null, passwordConstraints.minLength)}</li>
        <isif condition="${passwordConstraints.forceLetters}">
            <isif condition="${passwordConstraints.forceMixedCase}">
                <li data-val-regex="[A-Z]">${Resource.msg('helper.message.uppercase', 'forms', null)}</li>
                <li data-val-regex="[a-z]">${Resource.msg('helper.message.lowercase', 'forms', null)}</li>
            <iselse/>
                <li data-val-regex="[A-Za-z]">${Resource.msg('helper.message.letter', 'forms', null)}</li>
            </isif>
        </isif>
        <isif condition="${passwordConstraints.forceNumbers}">
            <li data-val-regex="[0-9]">${Resource.msg('helper.message.number', 'forms', null)}</li>
        </isif>
        <isif condition="${passwordConstraints.minSpecialChars > 0}">
            <li data-val-regex="[^A-Za-z0-9]{${passwordConstraints.minSpecialChars}}">${Resource.msgf(passwordConstraints.minSpecialChars > 1 ? 'helper.message.specials' : 'helper.message.special', 'forms', null, passwordConstraints.minSpecialChars)}</li>
        </isif>
    </ul>
</div>
