
<div class="card-body card-info-group">
    <div class="row">
        <isif condition="${pdict.accountlanding}">
            <div class="col-12 dashboard-cards-block-title">
                ${Resource.msg('label.orderhistory.mostrecentorder','account',null)}
            </div>
        </isif>
        <div class="col order-image-col">
            <img class="img-fluid" src="${order.firstLineItem ? order.firstLineItem.imageURL : order.giftCertificateLineItems.items[0].images.small[0].url}" alt="${order.firstLineItem ? order.firstLineItem.alt : order.giftCertificateLineItems.items[0].images.small[0].alt}" title="${order.firstLineItem ? order.firstLineItem.title : order.giftCertificateLineItems.items[0].images.small[0].title}">
        </div>
        <div class="col order-details-col">
            <isif condition="${pdict.accountlanding}">
                <p>${Resource.msg('label.orderhistory.ordernumber','account',null)} <isprint value="${order.orderNumber}"/></p>
            </isif>
            <p>${Resource.msg('label.orderhistory.dateordered','account',null)} <isprint value="${order.creationDate}"/></p>
            <p>${Resource.msg('label.orderhistory.orderstatus','account',null)} <span class="dashboard-order-card-status">${order.orderStatus}</span></p>
            <isinclude template="account/order/shippingTitle"/>
        </div>
    </div>
</div>
