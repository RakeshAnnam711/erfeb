<isinclude template="emails/header" />
        <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;">
            <!-- 1 Column Text + Button : BEGIN -->
            <tr>
                <td style="background-color: #ffffff;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr>
                            <td style="padding: 20px; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #222222;">
                                <h1 style="margin: 0 0 10px; font-size: 25px; line-height: 30px; color: #222222; font-weight: normal;">
                                    ${Resource.msg('msg.passwordemail.dear', 'login', null)}&nbsp;${pdict.firstName}&nbsp;${pdict.lastName},
                                </h1>
                                <isif condition="${!empty(pdict.emailAssets['emailPasswordResetTop'])}">
                                    <isprint value="${pdict.emailAssets['emailPasswordResetTop']}" encoding="off" />
                                </isif>
                                <p style="margin: 0 0 10px;"><a href="${pdict.url}">${pdict.url}</a></p>
                                <isif condition="${!empty(pdict.emailAssets['emailPasswordResetBottom'])}">
                                    <isprint value="${pdict.emailAssets['emailPasswordResetBottom']}" encoding="off" />
                                </isif>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0 20px 20px;">
                                <!-- Button : BEGIN -->
                                <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0"
                                    style="margin: auto;">
                                    <tr>
                                        <td style="border-radius: 0px; background: #000000;">
                                            <a class="button-a button-a-primary" href="${pdict.url}" style="background: #000000; border: 1px solid #000000; font-family: sans-serif; font-size: 14px; font-weight: bold; line-height: 14px; text-decoration: none; padding: 12px 30px; color: #FFFFFF; display: block; border-radius: 0px;">
                                                ${Resource.msg('msg.passwordemail.button', 'login', null)}
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                <!-- Button : END -->
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <!-- 1 Column Text + Button : END -->
        </table>
<isinclude template="emails/footer" />
