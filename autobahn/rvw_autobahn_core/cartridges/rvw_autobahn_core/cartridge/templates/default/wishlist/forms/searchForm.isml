 <div class="card wishlist-search-popover">
    <div class="card-header">
        <h2 class="wishlist-search-heading">
            ${Resource.msg('heading.search.wishlist.form', 'wishlist', null)}
        </h2>
    </div>

    <div class="card-body">
        <form id="searchForLists" class="js-search-for-lists" method="POST" name="search-for-lists" action="${URLUtils.url('Wishlist-Search')}">
            <p>${Resource.msg('header.form.search.wishlist.text', 'wishlist', null)}</p>

            <div class="form-group">
                <label class="form-control-label" for="searchWishlistEmail">
                    ${Resource.msg('field.registrant.email', 'wishlist', null)}
                </label>
                <input
                    type="text"
                    class="form-control search-email"
                    id="searchWishlistEmail"
                    name="searchWishlistEmail"
                    pattern="^[\w\.%\+\-]+@[\w\.\-]+\.\w{2,}$"
                    maxlength="50"
                    data-missing-msg="${Resource.msg('error.registrant.missing.field', 'wishlist', null)}"
                    data-pattern-mismatch-msg="${Resource.msg('error.email.invalid', 'wishlist', null)}" />
                <div class="invalid-feedback"></div>
            </div>

            <div class="form-group">
                <button
                    class="wishlist-search-btn"
                    id="searchWishlistBtn"
                    type="submit"
                    name="submit"
                    value="submit"
                    data-url="${URLUtils.url('Wishlist-Search')}"
                    data-toggle="modal"
                    data-target="wishlistSearchResultsModal"
                    data-no-results="${Resource.msg('text.search.no.results', 'wishlist', null)}">
                    ${Resource.msg('button.find.list', 'wishlist', null)}
                </button>
            </div>
        </form>
    </div>
</div>
