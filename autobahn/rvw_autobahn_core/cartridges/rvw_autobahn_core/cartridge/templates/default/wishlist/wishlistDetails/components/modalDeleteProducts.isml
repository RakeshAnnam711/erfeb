<div
    id="wishlistModalDeleteProducts"
    class="wishlist-modal-delete-products modal fade"
    tabindex="-1"
    role="dialog"
    aria-labelledby="wishlistModalDeleteProductsLabel"
    data-list-id
    data-list-item-id
    data-url="${pdict.urls.removeProducts}"
>
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div id="wishlistModalDeleteProductsLabel" class="wishlist-modal-delete-product-title modal-title">
                    ${Resource.msg('title.modal.deleteproducts', 'wishlist', null)}
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="${Resource.msg('button.modal.dismiss', 'wishlist', null)}">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
            </div>
            <div class="wishlist-modal-delete-list-body modal-body">
                <div class="row">
                    <div class="col">
                        <button type="button" class="wishlist-modal-delete-list-delete-button btn btn-block">
                            ${Resource.msg('button.modal.delete', 'wishlist', null)}
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="wishlist-modal-delete-list-cancel-btn btn btn-block" data-dismiss="modal">
                            ${Resource.msg('button.cancel', 'wishlist', null)}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
