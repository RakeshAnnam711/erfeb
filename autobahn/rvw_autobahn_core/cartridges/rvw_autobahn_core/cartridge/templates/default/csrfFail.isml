    <isinclude template="/components/modules" sf-toolkit="off" />

    <iscontentasset aid="error-page-content" />

    <div class="container mt-5 text-center">
        <p class="p--large font-weight-bold text--danger">${Resource.msg('error.csrf.token.mismatch', 'common', null)}</p>
    </div>
</isdecorate>
