<isset name="productCopy" value="${pdict.product}" scope="page"/>
<isset name="product" value="${pdict.product}" scope="page"/>
<isset name="isBundle" value="${product.productType === 'bundle'}" scope="page" />
<isset name="isBundleMainProduct" value="${isBundle ? true : false}" scope="page"/>
<isset name="bundleColumnWidth" value="${'col-12 col-md-' + parseInt(product.pdpImageColumnWidth.split('/')[0])}" scope="page" />
<isset name="isQuickView" value="${true}" scope="page"/>
<isset name="isProductSet" value="${false}" scope="page" />
<isset name="loopState" value="${{count: 1}}" scope="page" />
<isset name="productDataColumnClass" value="${'col-12 col-md-' + (12 - parseInt(product.pdpImageColumnWidth.split('/')[0]))}" scope="page"/>

<isinclude template="/components/modules" sf-toolkit="off" />
<div class="product-quickview product-${product.productType} col product-wrapper product-detail" data-pid="${product.id}"  data-swatchable-attributes="${pdict.product.attrsToUseForSwatch}">
    <div class="row ${isBundle ? 'bundle-main-product' : ''}">
        <!-- Product Images Carousel -->
        <isinclude template="product/components/imageCarousel" />

        <!-- Product Name and Number -->
        <div class="${productDataColumnClass}">
            <div class="row">
                <div class="col">
                    <section>
                        <h1 class="product-name">${product.productName}</h1>
                    </section>
                    <div class="sr-only">
                        <isinclude template="product/components/productNumber" />
                    </div>
                </div>
            </div>
            <isif condition="${!empty(product.headline) && product.quickviewShowHeadlineAndDescription == true}">
                <div class="row mt-3">
                    <div class="col">
                        ${product.headline}
                    </div>
                </div>
                <hr>
            </isif>

            <div class="detail-panel">
                <!-- Attributes -->
                <section class="attributes">

                    <isinclude template="product/components/mainAttributes" />
                    <isset name="noSwatchOverride" value="${false}" scope="page" />
                    <isset name="sizeChartHasBeenShown" value="${false}" scope="page"/>
                    <isloop items="${product.variationAttributes}" var="attr" status="attributeStatus">
                        <div data-attr="${attr.id}" class="swatch row">
                            <div class="col-12">
                                <isinclude template="product/components/variationAttribute" />
                            </div>

                            <isif condition="${attributeStatus.last}">
                                <!-- Quantity Drop Down Menu -->
                                <div class="attribute quantity col-12 d-md-none ${product.hideQty ? 'd-none' : ''}">
                                    <isif condition="${pdict.addToCartUrl || pdict.updateCartUrl}">
                                        <label for="quantity-${loopState && loopState.count ? loopState.count : '1' }">
                                            ${Resource.msg('quantity.label','product',null)}
                                        </label>
                                        <isinclude template="product/components/quantity" />
                                    </isif>
                                </div>
                            </isif>
                        </div>
                    </isloop>
                    <isif condition="${!empty(product.headlineDescription) && product.quickviewShowHeadlineAndDescription == true}">
                        <div class="row mt-3">
                            <div class="col">
                                <isprint value="${product.headlineDescription}" encoding="off" />
                            </div>
                        </div>
                    </isif>

                    <div class="row availability" data-ready-to-order="${product.readyToOrder}" data-available="${product.available}">
                        <isinclude template="product/components/productAvailability" />
                    </div>

                    <!-- Applicable Promotions -->
                    <div class="row mt-md-3">
                        <div class="col-12 promotions">
                            <div class="align-self-center">
                                <isinclude template="product/components/promotions" />
                            </div>
                        </div>
                    </div>
                </section>

                    <!-- Options -->
                    <div class="product-options">
                        <isif condition="${product.options && product.options.length > 0}">
                                <isinclude template="product/components/options" />
                        </isif>
                    </div>
            </div>
        </div>
    </div>

    <isif condition="${isBundle}">
        <div class="hidden-xs-down">
            <hr>
        </div>
        <isinclude template="product/components/bundleItems" />

        <hr>

        <!-- Availability -->
        <div class="row d-sm-none">
            <div class="col-11 mx-auto availability" data-ready-to-order="${product.readyToOrder}" data-available="${product.available}">
                <isinclude template="product/components/availability" />
            </div>
        </div>
    </isif>

    <isset name="product" value="${productCopy}" scope="page"/>
</div>
<div class="modal-footer row align-items-end">
    <isset name="loopState" value="{count: 1}" scope="page" />

    <div class="hidden-xs-down col availability align-self-end global-availability" data-ready-to-order="${product.readyToOrder}" data-available="${product.available}">
        <div class="row">
            <isinclude template="product/components/availability" />
        </div>
    </div>

    <div class="col">
        <div class="row align-items-end">
            <!-- Quantity -->
            <div class="quantity col-4 d-none d-md-block ${(product.hideQty || pdict.quickViewSource === 'quickview-wishlist') ? 'd-none' : ''}">
                <isif condition="${pdict.addToCartUrl || pdict.updateCartUrl}">
                    <isinclude template="product/components/quantity" />
                </isif>
            </div>

            <div class="col-12 col-md-8 ml-auto">
                <!-- Prices -->
                <div class="prices clearfix">
                    <isset name="price" value="${product.price}" scope="page" />
                    <isinclude template="product/components/pricing/main" />
                </div>

                <!-- Cart and [Optionally] Apple Pay -->
                <isif condition="${pdict.addToCartUrl}">
                    <isaddtocartglobal extraclass="qv-product-edit-add" />
                <iselse/>
                    <isinclude template="product/components/updateProduct" />
                </isif>
            </div>
        </div>
    </div>
</div>
