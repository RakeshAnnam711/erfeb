<div class="row wishlist-item-update-button-block">
<div class="col-sm-12">
    <button
            class="btn-update-wishlist update-cart-product-global btn btn-primary w-100"
            data-url="${URLUtils.url('Wishlist-UpdateFromQuickView').toString()}"
            data-pid="${product.id}"
            data-uuid="${product.uuid}"
    >
        <i class="fa fa-shopping-bag"></i>
        ${Resource.msg('button.update', 'common', null)}
    </button>
</div>
</div>