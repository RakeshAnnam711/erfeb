<isinclude template="emails/header" />
<table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="margin: auto;">
    <tr>
        <td align="center" style="background:#e0e0e0;padding:50px 0;">
            <center>
                <table  style="background:#ffffff;border:1px solid #999999;width:680px;">
                    <tr>
                        <td style="font-size:12px;font-family:arial;padding:20px 10px;vertical-align:top;">
                            <isif condition="${empty(pdict.recipientName)}">
                                <h1 style="font-size:20px;font-family:georgia;font-weight:normal;">${Resource.msg('email.giftcertificate.dearcustomer','checkout',null)}</h1>
                            <iselse/>
                                <h1 style="font-size:20px;font-family:georgia;font-weight:normal;">${StringUtils.format(Resource.msg('email.giftcertificate.dear','checkout', null), pdict.recipientName)}</h1>
                            </isif>
                            <p>
                                <isif condition="${empty(pdict.senderName)}">
                                    ${Resource.msg('email.giftcertificate.someone','checkout',null)}
                                <iselse/>
                                    <isprint value="${pdict.senderName}"/>
                                </isif>
                                ${StringUtils.format(Resource.msg('email.giftcertificate.paysattention','checkout', null), pdict.amount)}<a href="${URLUtils.httpHome()}"> ${Resource.msg('email.giftcertificate.dwonlinestore','checkout',null)}</a>${Resource.msg('email.giftcertificate.period','checkout',null)}
                            </p>

                            <isif condition="${!empty(pdict.message)}">
                                <isif condition="${empty(pdict.senderName)}">
                                    <p>${Resource.msg('email.giftcertificate.msgleftforyou','checkout',null)}</p>
                                <iselse/>
                                    <p><isprint value="${pdict.senderName}"/> ${Resource.msg('email.giftcertificate.msghasbeenleftforyou','checkout',null)}</p>
                                </isif>
                                <p><isprint value="${pdict.message}"/></p>
                            </isif>

                            <p>
                                ${Resource.msg('email.giftcertificate.toredeem','checkout',null)}
                                <isprint value="${pdict.giftCertificateCode}"/>
                            </p>
                        </td>
                    </tr>
                </table>
            </center>
        </td>
    </tr>
</table>
<isinclude template="emails/footer" />
