<div id="cards" class="sg__header3">Cards  <a
    role="button"
    tabindex="0"
    class="icon-search tooltip-icon"
    data-toggle="popover"
    data-placement="bottom"
    title="Find it in the Storefront"
    data-content="
        <ul>
            <li>Contact Us <a class='icon-offsite tooltip-icon' href='${URLUtils.https('ContactUs-Landing')}' target='_blank' rel='noopener'></a></li>
            <li>Checkout <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Checkout-Begin', 'stage', 'shipping')}' target='_blank' rel='noopener'></a></li>
            <li>Order Confirmation (place order)</li>

            <li class='mt-2'><strong>Logged Out</strong></li>
            <li>Login <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Login-Show')}' target='_blank' rel='noopener'></a></li>
            <li>Order Track (from form on Login page)</li>
            <li>Search Refinements <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Search-Show', 'q', 'mens')}' target='_blank' rel='noopener'></a></li>

            <li class='mt-2'><strong>Logged In</strong></li>
            <li>Profile <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Account-Show')}' target='_blank' rel='noopener'></a></li>
            <li>Edit Profile <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Account-EditProfile')}' target='_blank' rel='noopener'></a></li>
            <li>Edit Password <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Account-EditPassword')}' target='_blank' rel='noopener'></a></li>
            <li>Add Address <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Address-AddAddress')}' target='_blank' rel='noopener'></a></li>
            <li>Address List <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Address-List')}' target='_blank' rel='noopener'></a></li>
            <li>Add Payment <a class='icon-offsite tooltip-icon' href='${URLUtils.https('PaymentInstruments-AddPayment')}' target='_blank' rel='noopener'></a></li>
            <li>Order History <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Order-History')}' target='_blank' rel='noopener'></a></li>
            <li>Order Details <a class='icon-offsite tooltip-icon' href='${URLUtils.https('Order-Details', 'orderID', '00000001')}' target='_blank' rel='noopener'></a></li>
        </ul>
    "></a></div>

