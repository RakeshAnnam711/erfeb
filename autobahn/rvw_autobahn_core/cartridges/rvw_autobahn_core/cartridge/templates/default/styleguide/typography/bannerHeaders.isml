    <div class="col-md-6 pt-2 pb-3 pt-md-0 pb-md-0">
        <div class="row">
            <div class="col-12">
                <p class="p--small mb-0">Code Use Examples:</p>
                <pre><code class='language-markup'><script type="text/plain" class="language-markup"><span class="b4">B4 Header</span></script></code></pre>
                <pre><code class='language-css'><script type="text/plain" class="language-css">.element {@include banner(4)}</script></code></pre>
            </div>
