    <div class="col-md-6 pt-2 pb-3 pt-md-0 pb-md-0">
        <div class="w-auto w-sm-100 w-md-75 w-lg-50 w-xl-25">Width with Breakpoints</div>
    </div>
    <div class="col-md-6">
        <pre><code class='language-markup'><script type="text/plain" class="language-markup"><div class="w-auto w-sm-100 w-md-75 w-lg-50 w-xl-25">w-auto w-sm-100 w-md-75 w-lg-50 w-xl-25</div></script></code></pre>
    </div>
</div>
