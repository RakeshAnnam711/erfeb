<isif condition="${pdict.content.body !== null}">
    <iscomment>don't remove or rename DIV and Marker, necessary for mark and editing, no css attributes defined</iscomment>
    <div class="content-asset" data-asset-id="${pdict.content.ID}"><!-- dwMarker="content" dwContentID="${pdict.content.UUID}" dwContentBMID="${pdict.content.ID}" -->
        <isprint value="${pdict.content.body}" encoding="off"/>
    </div> <!-- End content-asset -->
<iselse/>
    ${Resource.msg('global.nocontent','common',null)} <!-- dwMarker="content" dwContentID="${pdict.cid}" -->
</isif>
