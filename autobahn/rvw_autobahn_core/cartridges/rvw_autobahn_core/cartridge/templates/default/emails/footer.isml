
<!-- Footer Full Bleed Background Section : BEGIN -->
<table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #E9E9E9;" class="email-container">
    <tr>
        <td>
            <div align="center" style="max-width: 600px; margin: auto;" >
                <!--[if mso]>
	                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" align="center">
	                    <tr>
	                    <td>
	                    <![endif]-->

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 20px; font-family: sans-serif; font-size: 12px; line-height: 15px; text-align: center; color: #222222;">
                            <isif condition="${!empty(pdict.emailAssets['emailGlobalFooter'])}">
                                <isprint value="${pdict.emailAssets['emailGlobalFooter']}" encoding="off" />
                            </isif>
                        </td>
                    </tr>
                </table>

                <!--[if mso]>
	                    </td>
	                    </tr>
	                    </table>
	                    <![endif]-->
            </div>
        </td>
    </tr>
</table>
<!-- Full Bleed Background Section : END -->

<!--[if mso | IE]>
    </td>
    </tr>
    </table>
    <![endif]-->
</center>
</body>
</html>

<iscomment>pass a base64 encoding image str as pdict.logo via emailHelper.js</iscomment>
<isif condition="${!empty(pdict.logo)}">
--related_boundary
Content-Type: image/png; charset="utf-8"
Content-Disposition: attachment; filename=logo.png
Content-Transfer-Encoding: base64
Content-ID: <logo>
Content-Location: logo.png

${pdict.logo}
</isif>

--related_boundary--

--ContentTypeSwitch--
