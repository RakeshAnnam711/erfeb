<iscontent type="text/html" charset="UTF-8" compact="true" />

<isif condition="${pdict.subproData}">
    <isset name="subproData" value="${pdict.subproData}" scope="page"/>
</isif>

<isif condition="${subproData.product.selected_option_mode == 'regular'}">
    <div class="subpro-options ${subproData.page}">
        <div class="line-item-attributes mode">${Resource.msg('order.subscription.delivery.regular', 'order', null)}</div>
        <div class="line-item-attributes interval">${Resource.msg('order.subscription.delivery.interval', 'order', null)}: <isif condition="${subproData.productSchedule.type == 'interval'}">${subproData.productSchedule.selectedInterval}<iselseif condition="${subproData.productSchedule.type == 'every_n_periods'}">${Resource.msgf('order.subscription.delivery.schedule.' + subproData.productSchedule.period, 'order', null, [subproData.productSchedule.num_periods])}</iselseif></isif></div>
    </div>
</isif>
