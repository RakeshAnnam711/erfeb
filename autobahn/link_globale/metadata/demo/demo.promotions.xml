<?xml version="1.0" encoding="UTF-8"?>
<promotions xmlns="http://www.demandware.com/xml/impex/promotion/2008-01-31">
    <campaign campaign-id="DEMO-GLOBALE">
        <description>Demo Global-e Campaign</description>
        <enabled-flag>true</enabled-flag>
        <campaign-scope>
            <applicable-online/>
        </campaign-scope>
    </campaign>

    <promotion promotion-id="DEMO-FREE-SHIPPING">
        <enabled-flag>true</enabled-flag>
        <archived-flag>false</archived-flag>
        <searchable-flag>false</searchable-flag>
        <refinable-flag>false</refinable-flag>
        <prevent-requalifying-flag>false</prevent-requalifying-flag>
        <prorate-across-eligible-items-flag>false</prorate-across-eligible-items-flag>
        <exclusivity>no</exclusivity>
        <name xml:lang="x-default">Demo Free Shipping</name>
        <callout-msg xml:lang="x-default">Demo Free Shipping</callout-msg>
        <custom-attributes>
            <custom-attribute attribute-id="geDiscountType">FREE</custom-attribute>
            <custom-attribute attribute-id="geDoNotConvert">false</custom-attribute>
            <custom-attribute attribute-id="geLoyaltyPromotion">false</custom-attribute>
        </custom-attributes>
        <shipping-promotion-rule>
            <qualifying-products>
                <included-products>
                    <condition-group>
                        <category-condition catalog-id="storefront-catalog-m-en" operator="is equal">
                            <category-id>root</category-id>
                        </category-condition>
                    </condition-group>
                </included-products>
            </qualifying-products>
            <shipping-methods>
                <method-id>GLOBALE</method-id>
                <method-id>GLOBALE_STANDARD</method-id>
                <method-id>GLOBALE_EXPRESS</method-id>
                <method-id>GLOBALE_STORE_COLLECTION</method-id>
                <method-id>GLOBALE_HUB</method-id>
                <method-id>GLOBALE_DIRECT</method-id>
                <method-id>GLOBALE_WYOL</method-id>
            </shipping-methods>
            <prohibit-nonqualifying-products>false</prohibit-nonqualifying-products>
            <discounts condition-type="product-quantity">
                <discount>
                    <threshold>1</threshold>
                    <free/>
                </discount>
            </discounts>
        </shipping-promotion-rule>
    </promotion>

