        <custom-attributes>
            <custom-attribute attribute-id="geDiscountType">PERCENTAGE</custom-attribute>
            <custom-attribute attribute-id="geDoNotConvert">false</custom-attribute>
            <custom-attribute attribute-id="geLoyaltyPromotion">false</custom-attribute>
        </custom-attributes>
        <product-promotion-rule>
            <qualifying-products>
                <included-products>
                    <condition-group>
                        <category-condition catalog-id="storefront-catalog-m-en" operator="is equal">
                            <category-id>root</category-id>
                        </category-condition>
                    </condition-group>
                </included-products>
                <excluded-products>
                    <condition-group>
                        <product-id-condition operator="is equal">
                            <product-id>25493624M</product-id>
                        </product-id-condition>
                    </condition-group>
                </excluded-products>
            </qualifying-products>
            <discounted-products>
                <included-products/>
                <excluded-products>
                    <condition-group>
                        <category-condition catalog-id="storefront-catalog-m-en" operator="is equal">
                            <category-id>root</category-id>
                        </category-condition>
                    </condition-group>
                </excluded-products>
            </discounted-products>
            <disable-global-excluded-products>true</disable-global-excluded-products>
            <discounts condition-type="product-amount">
                <discount>
                    <threshold>1.0</threshold>
                    <percentage>0.01</percentage>
                </discount>
            </discounts>
        </product-promotion-rule>
    </promotion>

