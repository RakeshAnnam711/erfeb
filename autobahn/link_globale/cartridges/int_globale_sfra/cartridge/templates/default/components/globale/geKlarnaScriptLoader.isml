	<script type="text/javascript" async src="${pdict.geKlarnaConfigurations.getLibUrl()}"
		<isif condition="${pdict.geKlarnaConfigurations.getDataClientId()}"> data-client-id="${pdict.geKlarnaConfigurations.getDataClientId()}"</isif>>
	</script>
</isif>