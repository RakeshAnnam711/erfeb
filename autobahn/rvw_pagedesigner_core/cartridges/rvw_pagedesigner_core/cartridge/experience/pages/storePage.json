{
    "name":"Storefront Page",
    "description":"",
    "attribute_definition_groups": [
        {
            "id": "pageAttributes",
            "name": "Page Settings",
            "attribute_definitions": [
                {
                    "id": "transparentNavShow",
                    "name": "Show Transparent Nav",
                    "description": "Default false. Set to true for nav to be transparent.",
                    "type": "boolean",
                    "required": false,
                    "default_value": false
                },
                {
                    "id": "transparentNavDarkMode",
                    "name": "Transparent Nav Dark Mode",
                    "description": "Default false which shows light mode. Set to true for nav to be dark mode for pages that have light backgrounds.",
                    "type": "boolean",
                    "required": false,
                    "default_value": false
                },
                {
                    "id": "customClass",
                    "name": "Custom Class",
                    "description": "Add a custom class to be applied to this page. For example, use 'background--light-gray to set the background color to light gray.'",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "theme",
                    "name": "Theme Preview",
                    "description": "Add a path to a theme's stylesheet (e.g. 'theme-dark.css') to preview that theme in Page Manager. Note: this will not apply to the storefront.",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "chromeless",
                    "name": "Chromeless",
                    "description": "Select this option to create a page with no header or footer that can be included on non Page Designer pages.'",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "tileImage",
                    "name": "Tile Image",
                    "description": "An image to appear in search results and for Open Graph SEO data.",
                    "type": "image",
                    "required": false
                },
                {
                    "id": "navFolderId",
                    "name": "Folder-based Navigation",
                    "description": "Select a folder to add a navigation menu to this page with a nested list of links to all the content within that folder. Leave as 'site root' to disable this feature.",
                    "type": "custom",
                    "required": false,
                    "editor_definition": {
                        "type": "contentFolderPicker"
                    }
                },
                {
                    "id": "folderNavMobilePlacement",
                    "name": "Folder-based Navigation Mobile Placement",
                    "description": "If activated (above), choose where to position the folder-based navigation menu on mobile. Default is 'Top'.",
                    "type": "enum",
                    "values": ["Top", "Bottom"],
                    "default_value": "Top",
                    "required": false
                },
                {
                    "id": "folderNavDesktopPlacement",
                    "name": "Folder-based Navigation Desktop Placement",
                    "description": "If activated (above), choose where to position the folder-based navigation menu on desktop. Default is 'Left'.",
                    "type": "enum",
                    "values": ["Left", "Right"],
                    "default_value": "Left",
                    "required": false
                }
            ]
        }
    ],
