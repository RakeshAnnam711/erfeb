{
    "name": "Search Results",
    "description": "Component to display the results grid of a category search.",
    "group": "dynamic_components",
    "attribute_definition_groups": [
        {
            "id": "productList",
            "name": "Product List",
            "description": "These can be used to override the default display settings for the page. For example, adding the following to the Query String field will cause the page to load already refined by the color yellow: {\"preferences\":{\"refinementColor\":\"Yellow\"}}",
            "attribute_definitions": [
                {
                    "id": "containerClass",
                    "name": "Container class",
                    "description": "Class(es) to add to this component's container for spacing, alignment, etc.",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "category",
                    "name": "Category",
                    "type": "category",
                    "required": false,
                    "dynamic_lookup": {
                        "aspect_attribute_alias": "category"
                    }
                },
                {
                    "id": "queryString",
                    "name": "URL Search Query String",
                    "type": "string",
                    "required": false,
                    "dynamic_lookup": {
                        "aspect_attribute_alias": "queryString"
                    }
                }
            ]
        },
        {
            "id": "promoTiles",
            "name": "Promo Tiles",
            "description": "Place any component in a Promo Tile region (open the Page Structure tab to view) and it will appear in the corresponding slot in the search results.",
            "attribute_definitions": [
                {
                    "id": "promoTile1ColumnSpan",
