{
    "name": "Hover Switch",
    "description": "Use this layout to show one component on page load, and replace it with another component on hover.",
    "group": "autobahn_layouts",
    "attribute_definition_groups": [
        {
            "id": "hoverSwitchAttributes",
            "name": "Hover Switch",
            "description": "Place a component in the 'On Load' region to show it initially. Place another component in the 'On Hover' region to switch to it when the user hovers over the first component.",
