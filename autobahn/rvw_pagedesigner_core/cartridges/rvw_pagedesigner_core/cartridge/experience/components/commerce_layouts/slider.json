{
    "name": "Slider",
    "group": "autobahn_layouts",
    "attribute_definition_groups": [
        {
            "id": "heading",
            "attribute_definitions": [
                {
                    "id": "containerClass",
                    "name": "Container class",
                    "description": "Class(es) to add to the slider's container for spacing, alignment, etc.",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "textHeadline",
                    "name": "Slider title",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "titleColor",
                    "name": "Title Color",
                    "type": "string",
                    "required": false
              },
              {
                    "id": "titleFontSize",
                    "name": "Title Font Size",
                    "description": "Title font size, default is 16px",
                    "type": "enum",
                  "values": ["16px", "20px", "24px", "28px"],
                  "default_value": "16px",
                    "required": false
              },
                {
                    "id": "textHeadlineAlignment",
                    "name": "Slider title alignment",
                    "type": "enum",
                    "values": ["left", "center", "right"],
                    "default_value": "left",
                    "required": false
                },
                {
                    "id": "textHeadlineClass",
                    "name": "Slider title class",
                    "description": "Additional class(es) to add to the title for styling purposes, e.g. 'h2 text--black mb-2'. Add 'custom' to remove other styles directly applied to this element.",
                    "type": "string",
                    "required": false
                }
            ]
        },
        {
            "id": "behavior",
            "name": "Slider behavior",
            "attribute_definitions": [
                {
                    "id": "autoplay",
                    "name": "Autoplay",
                    "description": "To turn autoplay on, choose a time in seconds for the delay between slides. Default state is off.",
                    "type": "enum",
                    "values": ["Off", "1 Second", "2 Seconds", "3 Seconds", "4 Seconds", "5 Seconds"],
                    "default_value": "Off",
                    "required": false
                },
                {
                    "id": "disableLoop",
                    "name": "Disable Loop",
                    "description": "Check this to prevent the slider from looping back to the beginning after the last slide",
                    "type": "boolean",
                    "default_value": false,
                    "required": false
                },
                {
                    "id": "speed",
                    "name": "Speed",
                    "description": "Enter the number of milliseconds for slide transitions. Default is 300ms.",
                    "type": "integer",
                    "default_value": 300,
                    "required": false
                },
                {
                    "id": "animation",
                    "name": "Animation",
                    "description": "Choose an animation style. Default is Carousel.",
                    "type": "enum",
                    "values": ["Carousel", "None", "Fade In", "Zoom In"],
                    "default_value": "Carousel",
                    "required": false
                }
            ]
        },
        {
            "id": "style",
            "name": "Slider style",
            "attribute_definitions": [
                {
                    "id": "paginationStyle",
                    "name": "Pagination Style",
                    "description": "Slider pagination style. Default is dots.",
                    "type":"enum",
                    "values": ["dots","shortLines"],
                    "default_value": "dots",
                    "required": false
                },
                {
                    "id": "pauseButtonPlacement",
                    "name": "Pause Button Placement",
                    "description": "Determine where pause button will show on slider, select none for it not to show. NOTE: Showing the button improves on ADA compliance. Only works if autoplay is enabled. Default is none.",
                    "type": "enum",
                    "values": ["none","top left","top right","bottom left","bottom right","with pagination"],
                    "default_value": "none",
                    "required": false
                },
                {
                    "id": "controlsTheme",
                    "name": "Controls Theme",
                    "description": "Set the theme to help with visibility of the slider's controls. Default is dark",
                    "type": "enum",
                    "values": ["dark", "light"],
                    "default_value": "dark",
                    "required": false
                }
            ]
        },
        {
            "id": "smallConfiguration",
            "name": "Phone configurations",
            "description": "Configuration for how the slider will display on phones.",
            "attribute_definitions": [
                {
                    "id": "smCarouselIndicators",
                    "name": "Display slider indicators on phones",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "smInsideIndicators",
                    "name": "Position slider indicators on the inside of the slider on phones",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "smCarouselControls",
                    "name": "Display slider controls on phones",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "smInsideControls",
                    "name": "Position slider controls on the inside of the slider on phones",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "smCarouselSlidesToDisplay",
                    "name": "Number of slides to display on phones",
                    "description": "Default is 1 slide visible at a time.",
                    "type": "enum",
                    "values": [
                        1,
                        2,
                        3
                    ],
                    "default_value": 1,
                    "required": false
                },
                {
                    "id": "smGutter",
                    "name": "Space between slides",
                    "description": "Enter a number representing how many pixels there should be between slides. Default is 20.",
                    "type": "integer",
                    "default_value": 20,
                    "required": false
                },
                {
                    "id": "smPercentageOfPrevSlide",
                    "name": "Show percentage of previous slide",
                    "description": "Choose a percentage below to show a portion of the previous slide to the left. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                },
                {
                    "id": "smPercentageOfNextSlide",
                    "name": "Show percentage of next slide",
                    "description": "Choose a percentage below to show a portion of the next slide to the right. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                }
            ]
        },
        {
            "id": "mediumConfiguration",
            "name": "Tablet configurations",
            "description": "Configuration for how the slider will display on tablets.",
            "attribute_definitions": [
                {
                    "id": "mdCarouselIndicators",
                    "name": "Display slider indicators on tablets",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "mdInsideIndicators",
                    "name": "Position slider indicators on the inside of the slider on tablets",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "mdCarouselControls",
                    "name": "Display slider controls on tablets",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "mdInsideControls",
                    "name": "Position slider controls on the inside of the slider on tablets",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "mdCarouselSlidesToDisplay",
                    "name": "Number of slides to display on tablets",
                    "description": "Default is 3 slides visible at a time.",
                    "type": "enum",
                    "values": [
                        1,
                        2,
                        3,
                        4,
                        5,
                        6
                    ],
                    "default_value": 3,
                    "required": false
                },
                {
                    "id": "mdGutter",
                    "name": "Space between slides",
                    "description": "Enter a number representing how many pixels there should be between slides. Default is 20.",
                    "type": "integer",
                    "default_value": 20,
                    "required": false
                },
                {
                    "id": "mdPercentageOfPrevSlide",
                    "name": "Show percentage of previous slide",
                    "description": "Choose a percentage below to show a portion of the previous slide to the left. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                },
                {
                    "id": "mdPercentageOfNextSlide",
                    "name": "Show percentage of next slide",
                    "description": "Choose a percentage below to show a portion of the next slide to the right. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                }
            ]
        },
        {
            "id": "largeConfiguration",
            "name": "Desktop configurations",
            "description": "Configuration for how the slider will display on desktop.",
            "attribute_definitions": [
                {
                    "id": "lgCarouselIndicators",
                    "name": "Display slider indicators on desktop",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "lgInsideIndicators",
                    "name": "Position slider indicators on the inside of the slider on desktop",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "lgCarouselControls",
                    "name": "Display slider controls on desktop",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "lgInsideControls",
                    "name": "Position slider controls on the inside of the slider on desktops",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "lgCarouselSlidesToDisplay",
                    "name": "Number of slides to display on desktop",
                    "description": "Default is 4 slides visible at a time.",
                    "type": "enum",
                    "values": [
                        1,
                        2,
                        3,
                        4,
                        5,
                        6
                    ],
                    "default_value": 4,
                    "required": false
                },
                {
                    "id": "lgGutter",
                    "name": "Space between slides",
                    "description": "Enter a number representing how many pixels there should be between slides. Default is 20.",
                    "type": "integer",
                    "default_value": 20,
                    "required": false
                },
                {
                    "id": "lgPercentageOfPrevSlide",
                    "name": "Show percentage of previous slide",
                    "description": "Choose a percentage below to show a portion of the previous slide to the left. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                },
                {
                    "id": "lgPercentageOfNextSlide",
                    "name": "Show percentage of next slide",
                    "description": "Choose a percentage below to show a portion of the next slide to the right. Default is 0%.",
                    "type": "enum",
                    "values": ["0%", "10%", "20%", "30%", "40%"],
                    "default_value": "0%",
                    "required": false
                }
            ]
        }
    ],
    "region_definitions": [
        {
            "id": "slides",
            "name": "Slides",
            "component_type_exclusions": [
                { "type_id": "commerce_assets.campaignBanner" },
                { "type_id": "commerce_assets.category" },
                { "type_id": "commerce_assets.editorialRichText" },
                { "type_id": "commerce_assets.mainBanner" },
                { "type_id": "commerce_assets.productListTile" },
                { "type_id": "commerce_assets.shopTheLook" },
                { "type_id": "commerce_layouts.carousel" },
                { "type_id": "commerce_layouts.mobileGrid1r1c" },
                { "type_id": "commerce_layouts.mobileGrid2r1c" },
                { "type_id": "commerce_layouts.mobileGrid2r2c" },
                { "type_id": "commerce_layouts.mobileGrid2r3c" },
                { "type_id": "commerce_layouts.mobileGrid3r1c" },
                { "type_id": "commerce_layouts.mobileGrid3r2c" },
                { "type_id": "commerce_layouts.mobileGridLookBook" },
                { "type_id": "commerce_layouts.popularCategories" },
                { "type_id": "dynamic.dynamicCategoryBanner" },
                { "type_id": "dynamic.productDetail" },
                { "type_id": "dynamic.productList" },
                { "type_id": "einstein.einsteinCarousel" },
                { "type_id": "einstein.einsteinCarouselCategory" },
                { "type_id": "einstein.einsteinCarouselProduct" },
                { "type_id": "flexible_grid_system.flexibleGridItem" },
                { "type_id": "commerce_layouts.searchResults" },
                { "type_id": "commerce_layouts.searchResultsTitle" }
            ]
        }
    ]
}
