<iscontent type="text/html" charset="UTF-8" compact="true" />
<isdecorate template="/common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/search.js');
    </isscript>

    <div class="plp page-designer ${pdict.customClass}" id="${pdict.page.ID}">
        <isprint value="${pdict.regions.top.render()}" encoding="off"/>

        <isif condition="${!pdict.regions.pageheader.region.visibleComponents.empty}">
            <header class="container page-header search-results-header">
                <isprint value="${pdict.regions.pageheader.render()}" encoding="off"/>
            </header>
        </isif>

        <isprint value="${pdict.regions.main.render()}" encoding="off"/>

        <isif condition="${!pdict.chromeless && pdict.belowFoldPopulated}">
            <isif condition="${'categoryId' in pdict && !empty(pdict.categoryId)}">
                <div id="belowFoldRegion" class="pd-async-region" data-url="${URLUtils.url('Search-Show', 'cgid', pdict.categoryId, 'ajaxRegion', pdict.regions.belowFold.region.ID)}"></div>
            <iselse/>
                <div id="belowFoldRegion" class="pd-async-region" data-url="${URLUtils.url('Page-Show', 'cid', pdict.page.ID, 'ajaxRegion', pdict.regions.belowFold.region.ID)}"></div>
            </isif>
        </isif>
    </div>
</isdecorate>
