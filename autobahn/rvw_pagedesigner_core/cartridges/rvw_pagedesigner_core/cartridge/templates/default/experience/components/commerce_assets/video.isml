<div class="video-container ${pdict.aspectRatioClass} ${pdict.hideControls ? '' : 'has-controls'} ${pdict.containerClass}"
     data-play-when-fully-in-view="${pdict.playWhenFullyInView}">

    <isif condition="${pdict.type === 'hosted'}">
        <video id="player-${pdict.componentID}" class="video-player video-js"
               data-asset-id="${pdict.componentID}"
               data-video="${pdict.type}"
               data-player-attr="${pdict.params}"
               data-video-id="${pdict.id}"
               data-filetype="video/${pdict.fileType}"
               <isif condition="${!empty(pdict.thumbnailImage)}">poster=${pdict.thumbnailImage.src.mobile}</isif>>
            <source src="${pdict.id}" type="video/${pdict.fileType}"/>
        </video>
    <iselse/>
        <div id="player-${pdict.componentID}" class="video-player"
            data-asset-id="${pdict.componentID}"
            data-video="${pdict.type}"
            data-player-attr="${pdict.params}"
            data-video-id="${pdict.id}">
        </div>
    </isif>

    <isif condition="${((!empty(pdict.thumbnailImage) || pdict.hideControls) && pdict.type !== 'hosted') || pdict.modal}">
        <iscomment>
            WGACA MODIFICAITON - Additional html attribute
            <a class="video-thumbnail" href="">
        </iscomment>
        <a class="video-thumbnail" href="" aria-label="video">

            <isif condition="${!empty(pdict.thumbnailImage)}">
                <div class="video-thumbnail-image background-image-mobile" role="img" aria-label="${pdict.thumbnailImage.alt}"
                     style="background-image: url('${pdict.thumbnailImage.src.mobile}');
                            background-image: -webkit-image-set(url(${pdict.thumbnailImage.src.mobile}) 1x, url(${pdict.thumbnailImage.src.mobile2x}) 2x);
                            background-image: image-set(url(${pdict.thumbnailImage.src.mobile}) 1x, url(${pdict.thumbnailImage.src.mobile2x}) 2x);
                            background-position-x: ${pdict.thumbnailImage.focalPointX};
                            background-position-y: ${pdict.thumbnailImage.focalPointY};">
                </div>
                <div class="video-thumbnail-image background-image-tablet" role="img" aria-label="${pdict.thumbnailImage.alt}"
                     style="background-image: url('${pdict.thumbnailImage.src.tablet}');
                            background-image: -webkit-image-set(url(${pdict.thumbnailImage.src.tablet}) 1x, url(${pdict.thumbnailImage.src.tablet2x}) 2x);
                            background-image: image-set(url(${pdict.thumbnailImage.src.tablet}) 1x, url(${pdict.thumbnailImage.src.tablet2x}) 2x);
                            background-position-x: ${pdict.thumbnailImage.focalPointX};
                            background-position-y: ${pdict.thumbnailImage.focalPointY};">
                </div>
                <div class="video-thumbnail-image background-image-desktop" role="img" aria-label="${pdict.thumbnailImage.alt}"
                      style="background-image: url('${pdict.thumbnailImage.src.desktop}');
                             background-image: -webkit-image-set(url(${pdict.thumbnailImage.src.desktop}) 1x, url(${pdict.thumbnailImage.src.desktop2x}) 2x);
                             background-image: image-set(url(${pdict.thumbnailImage.src.desktop}) 1x, url(${pdict.thumbnailImage.src.desktop2x}) 2x);
                             background-position-x: ${pdict.thumbnailImage.focalPointX};
                             background-position-y: ${pdict.thumbnailImage.focalPointY};">
                </div>
            </isif>

            <iscomment>We can't hide YouTube's play button, so don't show our custom icon if there's no thumbnail image</iscomment>
            <isset name="hideThumbnailButton" value="${empty(pdict.thumbnailImage) && (pdict.type === 'youtube' || pdict.modal && pdict.type === 'vimeo')}" scope="page"/>
            <isif condition="${!hideThumbnailButton}">
                <span class="video-thumbnail-button"></span>
            </isif>

        </a>
    </isif>

</div>
