                <parameters/>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2021-11-09Z</date-from>
                    <start-time>19:31:00.000Z</start-time>
                    <interval>5m</interval>
                    <day-of-week>
                        <weekday>Saturday</weekday>
                        <weekday>Monday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>

    <job job-id="FlowGenerateConfigurationJsonFiles" priority="0">
        <description/>
        <parameters/>
        <flow>
            <context site-id="WGACA"/>
            <step step-id="generateConfigurationJsonFiles" type="custom.Flow.generateConfigurationJsonFiles" enforce-restart="false">
                <description/>
                <parameters/>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2019-06-18Z</date>
                <time>20:53:07.000Z</time>
            </run-once>
        </triggers>
    </job>

    <job job-id="FlowImportPriceBooks" priority="0">
        <description>Import Price Books from Flow via SFTP</description>
        <parameters/>
        <flow>
            <context site-id="WGACA"/>
            <step step-id="flowDownloadPriceBooks" type="custom.Flow.downloadPricebooksFromFlow" enforce-restart="false">
                <description/>
                <parameters>
                    <parameter name="remoteFolder">sfcc/from-flow</parameter>
                </parameters>
            </step>
        </flow>
        <flow>
            <context site-id="Sites"/>
            <step step-id="importPricebooks" type="ImportPriceBook" enforce-restart="false">
                <description/>
                <parameters>
                    <parameter name="WorkingFolder">flow/WGACA/pricebooks</parameter>
                    <parameter name="NoFilesFoundHandling">OK</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">WARN</parameter>
                    <parameter name="AfterImportFileHandling">Archive</parameter>
                    <parameter name="ArchiveFolder">flow/WGACA/pricebooks/archive</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2021-11-09Z</date-from>
                    <start-time>10:01:00.000Z</start-time>
                    <interval>1d</interval>
                    <day-of-week>
                        <weekday>Saturday</weekday>
                        <weekday>Monday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>

    <job job-id="FlowImportShippingMethods" priority="0">
        <description/>
        <parameters/>
        <flow>
            <context site-id="WGACA"/>
            <step step-id="flowGenerateShippingMethods" type="custom.Flow.generateShippingMethodsImportFile" enforce-restart="false">
                <description/>
                <parameters/>
            </step>
            <step step-id="importShippingMethods" type="ImportShippingMethods" enforce-restart="false">
                <description/>
                <parameters>
                    <parameter name="WorkingFolder">flow/WGACA/shippingmethods</parameter>
                    <parameter name="NoFilesFoundHandling">OK</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">WARN</parameter>
                    <parameter name="AfterImportFileHandling">Archive</parameter>
                    <parameter name="ArchiveFolder">flow/WGACA/shippingmethods/archive</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2021-11-09Z</date-from>
                    <start-time>10:00:40.000Z</start-time>
                    <interval>1d</interval>
                    <day-of-week>
                        <weekday>Saturday</weekday>
                        <weekday>Monday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>

    <job job-id="FlowProcessNotifications" priority="0">
        <description/>
        <parameters/>
        <split sequential="false">
            <contexts template-ref="FlowProcessNotifications">
                <context site-id="RefArch" />
            </contexts>
            <flow-template template-id="FlowProcessNotifications">
                <step step-id="FlowProcessNotifications" type="custom.Flow.processFlowNotifications" enforce-restart="false">
                    <description/>
                    <parameters>
                        <parameter name="toAddresses">logs-sfcc@flow.io</parameter>
                    </parameters>
                </step>
            </flow-template>
        </split>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2019-07-01Z</date>
                <time>16:19:21.000Z</time>
            </run-once>
        </triggers>
    </job>
</jobs>
