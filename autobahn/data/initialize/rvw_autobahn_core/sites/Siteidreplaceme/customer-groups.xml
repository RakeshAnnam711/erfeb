<?xml version="1.0" encoding="UTF-8"?>
<customer-groups xmlns="http://www.demandware.com/xml/impex/customergroup/2007-06-30">
    <customer-group group-id="Siteidreplaceme">
        <description>Customer experiencing brand 'Siteidreplaceme' via siteContext brandConfiguration</description>
        <membership-rule>
            <included-customers>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>session.custom.siteContextID</attribute-path>
                        <operator>is-equal</operator>
                        <string>Siteidreplaceme</string>
                    </condition>
                </condition-group>
            </included-customers>
        </membership-rule>
		<custom-attributes>
			<custom-attribute attribute-id="isSiteContextGroup">true</custom-attribute>
		</custom-attributes>
    </customer-group>

</customer-groups>
