<?xml version="1.0" encoding="UTF-8"?>
<shipping xmlns="http://www.demandware.com/xml/impex/shipping/2007-03-31">
    <shipping-method method-id="001" default="true">
        <display-name xml:lang="x-default">Ground</display-name>
        <description xml:lang="x-default">Order received within 7-10 business days</description>
        <online-flag>true</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">0</amount>
            <amount order-value="0.01">5.99</amount>
            <amount order-value="100">7.99</amount>
            <amount order-value="200">9.99</amount>
            <amount order-value="500">15.99</amount>
        </price-table>
        <product-cost-groups>
            <product-cost-group>
                <products>
                    <included-products>
                        <condition-group>
                            <attribute-condition operator="equals" attribute-id="itemType">
                                <attribute-value>digital</attribute-value>
                            </attribute-condition>
                        </condition-group>
                    </included-products>
                </products>
                <cost-per-item>
                    <fixed-price>0.00</fixed-price>
                </cost-per-item>
            </product-cost-group>
        </product-cost-groups>
        <custom-attributes>
            <custom-attribute attribute-id="estimatedArrivalTime" xml:lang="x-default">7-10 Business Days</custom-attribute>
        </custom-attributes>
        <currency>USD</currency>
    </shipping-method>

    <shipping-method method-id="002" default="false">
        <display-name xml:lang="x-default">2-Day Express</display-name>
        <description xml:lang="x-default">Order received in 2 business days</description>
        <online-flag>true</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">0</amount>
            <amount order-value="0.01">9.99</amount>
            <amount order-value="100">11.99</amount>
            <amount order-value="200">15.99</amount>
            <amount order-value="500">20.99</amount>
        </price-table>
        <excluded-addresses>
            <included-addresses>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>shipment.shippingAddress.stateCode</attribute-path>
                        <operator>is-equal</operator>
                        <string>AA</string>
                        <string>AB</string>
                        <string>AE</string>
                        <string>AP</string>
                        <string>AK</string>
                        <string>AS</string>
                        <string>BC</string>
                        <string>GU</string>
                        <string>HI</string>
                        <string>MB</string>
                        <string>NB</string>
                        <string>NL</string>
                        <string>NT</string>
                        <string>NS</string>
                        <string>NU</string>
                        <string>ON</string>
                        <string>PE</string>
                        <string>PR</string>
                        <string>QC</string>
                        <string>SK</string>
                        <string>VI</string>
                        <string>YT</string>
                    </condition>
                </condition-group>
            </included-addresses>
        </excluded-addresses>
        <custom-attributes>
            <custom-attribute attribute-id="estimatedArrivalTime" xml:lang="x-default">2 Business Days</custom-attribute>
        </custom-attributes>
        <currency>USD</currency>
    </shipping-method>

    <shipping-method method-id="003" default="false">
        <display-name xml:lang="x-default">Overnight</display-name>
        <description xml:lang="x-default">Order received the next business day</description>
        <online-flag>true</online-flag>
        <tax-class-id>standard</tax-class-id>
        <price-table>
            <amount order-value="0">0</amount>
            <amount order-value="0.01">15.99</amount>
            <amount order-value="100">19.99</amount>
            <amount order-value="200">21.99</amount>
            <amount order-value="500">29.99</amount>
        </price-table>
        <excluded-addresses>
            <included-addresses>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>shipment.shippingAddress.stateCode</attribute-path>
                        <operator>is-equal</operator>
                        <string>AA</string>
                        <string>AB</string>
                        <string>AE</string>
                        <string>AP</string>
                        <string>AK</string>
                        <string>AS</string>
                        <string>BC</string>
                        <string>GU</string>
                        <string>HI</string>
                        <string>MB</string>
                        <string>NB</string>
                        <string>NL</string>
                        <string>NT</string>
                        <string>NS</string>
                        <string>NU</string>
                        <string>ON</string>
                        <string>PE</string>
                        <string>PR</string>
                        <string>QC</string>
                        <string>SK</string>
                        <string>VI</string>
                        <string>YT</string>
                    </condition>
                </condition-group>
            </included-addresses>
        </excluded-addresses>
        <custom-attributes>
            <custom-attribute attribute-id="estimatedArrivalTime" xml:lang="x-default">Next Day</custom-attribute>
        </custom-attributes>
        <currency>USD</currency>
    </shipping-method>
</shipping>
