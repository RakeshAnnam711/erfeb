<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">

    <service-credential service-credential-id="google.cred.recaptcha.api.siteverify">
        <url>https://www.google.com/recaptcha/api/siteverify</url>
    </service-credential>

    <service-profile service-profile-id="google.profile.recaptcha.api.siteverify">
        <timeout-millis>1000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>3</cb-calls>
        <cb-millis>5000</cb-millis>
    </service-profile>

    <service service-id="google.rest.recaptcha.api.siteverify">
        <service-type>HTTPForm</service-type>
        <enabled>true</enabled>
        <log-prefix>Google</log-prefix>
        <comm-log-enabled>true</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>google.profile.recaptcha.api.siteverify</profile-id>
        <credential-id>google.cred.recaptcha.api.siteverify</credential-id>
    </service>

</services>
