    <payment-processor processor-id="AFFIRM_PAYMENT">
        <description>Affirm payment processor.</description>
        <preferences>
            <all-instances/>
            <development>
                <preference preference-id="AffirmOnline">true</preference>
                <preference preference-id="AffirmMode">sandbox</preference>
                <preference preference-id="AffirmPublicKey">KRIYW4XA1PQDXIUY</preference>
                <preference preference-id="AffirmPrivateKey">dc9eBKhwGP1ov2kVY6H1BYIvUjpC89MV</preference>
                <preference preference-id="AffirmProductMessage">true</preference>
                <preference preference-id="AffirmPaymentMaxTotal">17500</preference>
            </development>
            <staging>
                <preference preference-id="AffirmOnline">true</preference>
                <preference preference-id="AffirmMode">sandbox</preference>
                <preference preference-id="AffirmPublicKey">KRIYW4XA1PQDXIUY</preference>
