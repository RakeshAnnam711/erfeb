                <preference preference-id="AffirmProductMessage">true</preference>
                <preference preference-id="AffirmPaymentMaxTotal">17500</preference>
                <preference preference-id="AffirmAnalytics">true</preference>
            </staging>
            <production>
                <preference preference-id="AffirmOnline">true</preference>
                <preference preference-id="AffirmMode">production</preference>
                <preference preference-id="AffirmPublicKey">WQCXDZWF3F6VFTO3</preference>
                <preference preference-id="AffirmPrivateKey">g8K7Xjp0KDqDXfuNZnuDE9bS2VNHADPd</preference>
                <preference preference-id="AffirmProductMessage">true</preference>
                <preference preference-id="AffirmPaymentMaxTotal">17500</preference>
            </production>
        </preferences>
    </payment-processor>

