<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="MarketingCloud Product Feed" priority="0">
        <description/>
        <parameters/>
        <split sequential="false">
            <contexts template-ref="template_24">
                <all-storefront-sites/>
            </contexts>
            <flow-template template-id="template_24">
                <step step-id="Build-Salesforce-Marketing-Feed" type="custom.Salesforce.Marketing.Feed" enforce-restart="false">
                    <description>Exports products into a feed file for Marketing Cloud</description>
                    <parameters>
                        <parameter name="TargetRelativePath">src/export/marketing/product</parameter>
                        <parameter name="FileNamePrefix">ProductCatalog_SFRA_</parameter>
                        <parameter name="Delimiter">Pipe</parameter>
                        <parameter name="IncludeMasterProducts">true</parameter>
                        <parameter name="LogAllProductsWritten">false</parameter>
                        <parameter name="RegularPriceBookId">wgaca-web-pricebook</parameter>
                        <parameter name="OtherPriceBookIds">wgaca-discount-pricebook</parameter>
                        <parameter name="ProductAttributeHostValueMapping">{}</parameter>
                    </parameters>
                </step>
                <step step-id="FTPUpload" type="custom.CSComponents.FtpUpload" enforce-restart="false">
                    <description/>
                    <parameters>
                        <parameter name="ServiceID">MarketingCloud.SFTP</parameter>
                        <parameter name="FilePattern">ProductCatalog_.*\.csv</parameter>
                        <parameter name="SourceFolder">src/export/marketing/product</parameter>
                        <parameter name="TargetFolder">Import</parameter>
                        <parameter name="Recursive">false</parameter>
                        <parameter name="ArchiveFolder">archive</parameter>
                        <parameter name="NoFileFoundStatus">OK</parameter>
                    </parameters>
                </step>
            </flow-template>
        </split>
        <rules>
            <on-running runtime-threshold="120m" enabled="true">
                <mark-job-as-hanging/>
                <send-mail>
                    <from>noreply-marketingcloud-prodfeed@sink.salesforce.com</from>
                    <to>quicklaunch@redvanworkshop.com</to>
                </send-mail>
            </on-running>
            <on-retry enabled="true">
                <send-mail>
                    <from>noreply-marketingcloud-prodfeed@sink.salesforce.com</from>
                    <to>quicklaunch@redvanworkshop.com</to>
                </send-mail>
            </on-retry>
            <on-exit status="ERROR" enabled="true">
                <send-mail>
                    <from>noreply-marketingcloud-prodfeed@sink.salesforce.com</from>
                    <to>quicklaunch@redvanworkshop.com</to>
                </send-mail>
            </on-exit>
        </rules>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2022-01-01Z</date-from>
                    <start-time>00:00:00.000Z</start-time>
                    <interval>1d</interval>
                    <day-of-week>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Monday</weekday>
                        <weekday>Sunday</weekday>
                        <weekday>Saturday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
