<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="TaxJarEnable">
                <display-name xml:lang="x-default">Enable TaxJar</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
             <attribute-definition attribute-id="TaxJarShipFromCountryCode">
                <display-name xml:lang="x-default">Ship From Country Code</display-name>
                <description xml:lang="x-default">Two-letter ISO country code of the country where orders are shipped from.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
                <field-length>0</field-length>
                <field-height>0</field-height>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarShipFromState">
                <display-name xml:lang="x-default">Ship From State Code</display-name>
                <description xml:lang="x-default">Two-letter ISO state code where orders are shipped from.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarShipFromZip">
                <display-name xml:lang="x-default">Ship From Postal Code</display-name>
                <description xml:lang="x-default">Postal code where orders are shipped from (5-Digit ZIP or ZIP+4).</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
                <field-length>0</field-length>
                <field-height>0</field-height>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarShipFromCity">
                <display-name xml:lang="x-default">Ship From City</display-name>
                <description xml:lang="x-default">City where orders are shipped from.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
                <field-length>0</field-length>
                <field-height>0</field-height>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarShipFromAddress">
                <display-name xml:lang="x-default">Ship From Address</display-name>
                <description xml:lang="x-default">Street address where orders are shipped from.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarLastSyncTime">
                <display-name xml:lang="x-default">TaxJar Last Sync Time</display-name>
                <description xml:lang="x-default">Records the timestamp of last run of TaxJar sync job. Do not manually alter unless directed by TaxJar support.</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarAPIToken">
                <display-name xml:lang="x-default">TaxJar API Token</display-name>
                <description xml:lang="x-default">Sandbox or Live token from https://app.taxjar.com/account#api-access</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="TaxJar">
                <display-name xml:lang="x-default">TaxJar Settings</display-name>
                <attribute attribute-id="TaxJarEnable"/>
                <attribute attribute-id="TaxJarAPIToken"/>
                <attribute attribute-id="TaxJarShipFromCountryCode"/>
                <attribute attribute-id="TaxJarShipFromState"/>
                <attribute attribute-id="TaxJarShipFromZip"/>
                <attribute attribute-id="TaxJarShipFromCity"/>
                <attribute attribute-id="TaxJarShipFromAddress"/>
                <attribute attribute-id="TaxJarLastSyncTime"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

    <type-extension type-id="Shipment">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="TaxJarOrderLastSyncDateTime">
                <display-name xml:lang="x-default">Time of last sync to TaxJar</display-name>
                <description xml:lang="x-default">This attribute should not be manually edited unless directed by TaxJar support.</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="TaxJarOrderLastSyncHash">
                <display-name xml:lang="x-default">TaxJar Last Order Sync Hash</display-name>
                <description xml:lang="x-default">Used to prevent unnecessary requests to TaxJar API</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
    </type-extension>

